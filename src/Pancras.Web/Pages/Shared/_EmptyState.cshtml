@model Pancras.Web.Pages.Shared.EmptyStateModel

<div class="rounded-2xl border border-dashed border-slate-300 bg-white px-5 py-10 text-center">
    <p class="text-sm font-bold text-slate-800">@Model.Title</p>
    @if (!string.IsNullOrWhiteSpace(Model.Hint))
    {
        <p class="mx-auto mt-1 max-w-md text-sm text-slate-500">@Model.Hint</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ActionLabel) && !string.IsNullOrWhiteSpace(Model.ActionHref))
    {
        <a href="@Model.ActionHref" class="mt-4 inline-block rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white">@Model.ActionLabel</a>
    }
</div>
