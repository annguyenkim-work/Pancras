@using Pancras.Web.Formatting
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.ITempDataDictionaryFactory TempDataFactory
@{
    var toast = TempDataFactory.GetTempData(Context).ReadToast();
}
<div id="toast-region" class="no-print fixed bottom-4 right-4 z-[60] flex w-[calc(100%-2rem)] max-w-sm flex-col gap-2">
    @if (toast is { } t)
    {
        var tone = t.Level switch { ToastLevel.Warning => "amber", ToastLevel.Error => "rose", _ => "emerald" };
        var cls = t.Level switch
        {
            ToastLevel.Warning => "border-amber-200 bg-amber-50 text-amber-800",
            ToastLevel.Error => "border-rose-200 bg-rose-50 text-rose-800",
            _ => "border-emerald-200 bg-emerald-50 text-emerald-800"
        };
        <div class="toast flex items-start gap-3 rounded-lg border px-4 py-3 text-sm font-medium shadow-lg @cls"
             role="@(t.Level == ToastLevel.Success ? "status" : "alert")"
             data-autoclose="@(t.Level == ToastLevel.Success ? "5000" : "0")" data-tone="@tone">
            <span class="flex-1">@t.Message</span>
            <button type="button" class="toast-close shrink-0 text-lg leading-none opacity-70 hover:opacity-100" aria-label="Đóng">×</button>
        </div>
    }
</div>
