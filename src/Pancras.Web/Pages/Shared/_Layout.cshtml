@using System.Security.Claims
@using Pancras.Web.Navigation
@inject Pancras.Application.Notifications.ListNotificationsHandler Notices
@{
    var roleName = User.FindFirstValue(ClaimTypes.Role);
    var currentPath = Context.Request.Path.Value ?? "/";
    var unseen = User.Identity?.IsAuthenticated == true && Guid.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var meId)
        ? await Notices.CountUnseenAsync(meId, Context.RequestAborted)
        : 0;
    var bellLabel = unseen > 0 ? $"Thông báo, {unseen} chưa xem" : "Thông báo";
    bool IsSoon(string path) => NavigationMenu.IsComingSoon(path);
    string ItemClass(string path)
    {
        var active = string.Equals(path, "/", StringComparison.Ordinal)
            ? string.Equals(currentPath, "/", StringComparison.Ordinal)
            : currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
        const string baseClass = "flex items-center justify-between gap-2 min-w-0 px-3 py-2 rounded-lg";
        if (active)
        {
            return baseClass + " bg-sky-600 font-medium text-white";
        }
        return IsSoon(path)
            ? baseClass + " text-slate-500 hover:bg-slate-800/60"
            : baseClass + " text-slate-100 hover:bg-slate-800";
    }
    Microsoft.AspNetCore.Html.HtmlString SoonBadge(string path) => IsSoon(path)
        ? new("<span class=\"shrink-0 rounded bg-slate-800 px-1.5 py-0.5 text-[10px] font-medium text-slate-400\">Sắp có</span>")
        : Microsoft.AspNetCore.Html.HtmlString.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
</head>
<body class="min-h-screen bg-slate-100 font-sans text-slate-900">
    <div class="no-print lg:hidden fixed top-0 inset-x-0 z-40 flex items-center h-14 px-4 bg-white border-b border-slate-200">
        <button type="button" class="p-2 rounded-lg text-slate-700" data-nav-toggle aria-label="Mở menu">
            <span class="block w-5 h-0.5 bg-slate-800 mb-1"></span>
            <span class="block w-5 h-0.5 bg-slate-800 mb-1"></span>
            <span class="block w-5 h-0.5 bg-slate-800"></span>
        </button>
        <a href="/" class="ml-3 flex items-center gap-2 min-w-0">
            <img src="~/images/logo-pancras.png" asp-append-version="true" alt="" class="h-10 w-10 rounded-md shrink-0" />
            <span class="font-display font-bold truncate">PancrasERP</span>
        </a>
        <a href="/notifications" class="relative ml-auto mr-3 p-1 text-slate-700" title="Thông báo" aria-label="@bellLabel"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>@if (unseen > 0) {<span class="absolute -right-1 -top-1 min-w-[1.1rem] rounded-full bg-rose-600 px-1 text-center text-[10px] font-bold leading-4 text-white">@(unseen > 9 ? "9+" : unseen.ToString())</span>}</a>
        <a href="/profile" class="mr-2 text-sm font-medium text-slate-800">Hồ sơ</a>
        <form method="post" asp-page="/Account/Logout">
            <button type="submit" class="rounded-lg px-3 py-1.5 text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:opacity-60">Đăng xuất</button>
        </form>
    </div>
    <div id="nav-backdrop" class="hidden fixed inset-0 z-40 bg-slate-900/50 lg:hidden" data-nav-close></div>
    <aside id="app-sidebar" class="no-print fixed inset-y-0 left-0 z-50 w-72 overflow-y-auto bg-slate-900 text-slate-300 -translate-x-full lg:translate-x-0 transition-transform" data-expanded-class="lg:translate-x-0" data-collapsed-class="lg:-translate-x-full">
        <div class="px-4 py-5 border-b border-slate-800">
            <a href="/" class="flex items-center gap-3">
                <img src="~/images/logo-pancras.png" asp-append-version="true" alt="Pancras" class="h-12 w-12 shrink-0 rounded-lg bg-white/90 object-contain p-0.5" />
                <span class="min-w-0">
                    <span class="block font-display text-base font-bold text-white">PancrasERP</span>
                    <span class="block text-xs text-slate-400">Thiết Bị Vệ Sinh &amp; Nội Thất</span>
                </span>
            </a>
        </div>
        <nav class="px-3 py-4 space-y-5 text-sm">
            @foreach (var group in NavigationMenu.Groups)
            {
                var items = NavigationMenu.VisibleFor(roleName).Where(item => item.Group == group).ToList();
                if (items.Count == 0)
                {
                    continue;
                }
                <div>
                    <div class="px-3 mb-1.5 text-[11px] font-bold tracking-wider text-slate-400">@group</div>
                    @foreach (var item in items)
                    {
                        <a href="@item.Href" class="@ItemClass(item.Href)"><span class="min-w-0 leading-snug">@item.Label</span>@SoonBadge(item.Href)</a>
                    }
                </div>
            }
        </nav>
    </aside>
    <div id="app-content" class="lg:pl-72" data-expanded-class="lg:pl-72" data-collapsed-class="lg:pl-0">
        <header class="no-print sticky top-0 z-30 hidden lg:flex items-center justify-between h-16 px-6 bg-white border-b border-slate-200">
            <div class="flex items-center gap-3 text-sm text-slate-500">
                <button type="button" class="rounded-lg p-1.5 text-slate-600 hover:bg-slate-100" data-sidebar-toggle aria-controls="app-sidebar" aria-expanded="true" title="Thu gọn/mở menu" aria-label="Thu gọn hoặc mở menu"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
                <span>PancrasERP / @ViewData["Title"]</span>
            </div>
            <div class="flex items-center gap-3">
                <a href="/notifications" class="relative p-1 text-slate-600 hover:text-sky-700" title="Thông báo" aria-label="@bellLabel"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></svg>@if (unseen > 0) {<span class="absolute -right-1 -top-1 min-w-[1.1rem] rounded-full bg-rose-600 px-1 text-center text-[10px] font-bold leading-4 text-white">@(unseen > 9 ? "9+" : unseen.ToString())</span>}</a>
                <a href="/profile" class="text-sm font-medium text-slate-800 hover:text-sky-700" title="Hồ sơ của tôi">@User.Identity?.Name</a>
                <span class="@Pancras.Web.Formatting.Badge.Classes(Pancras.Web.Formatting.BadgeTone.Info)">@User.FindFirstValue(ClaimTypes.Role)</span>
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="rounded-lg px-3 py-1.5 text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:opacity-60">Đăng xuất</button>
                </form>
            </div>
        </header>
        <main class="mx-auto w-full max-w-screen-2xl p-4 pt-20 sm:p-6 lg:min-w-[40rem] lg:p-8 lg:pt-8">
            @RenderBody()
        </main>
    </div>
    <partial name="_Toasts" />
    <script src="~/js/ui.js" asp-append-version="true" defer></script>
    <script src="~/js/live-filter.js" asp-append-version="true" defer></script>
    <script src="~/js/form-guard.js" asp-append-version="true" defer></script>
    <script src="~/js/toast.js" asp-append-version="true" defer></script>
</body>
</html>
