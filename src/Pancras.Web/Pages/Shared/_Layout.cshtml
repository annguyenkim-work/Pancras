@using System.Security.Claims
@using Pancras.Domain.Catalog
@{
    var canViewCatalog = CatalogAccess.CanView(User.FindFirstValue(ClaimTypes.Role));
    var currentPath = Context.Request.Path.Value ?? "/";
    var homeLinkClass = string.Equals(currentPath, "/", StringComparison.Ordinal)
        ? "block px-3 py-2 rounded-lg bg-sky-600 text-white"
        : "block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800";
    var supplierLinkClass = currentPath.StartsWith("/nha-cung-cap", StringComparison.OrdinalIgnoreCase)
        ? "block px-3 py-2 rounded-lg bg-sky-600 text-white"
        : "block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800";
    var catalogLinkClass = currentPath.StartsWith("/danh-muc-gia", StringComparison.OrdinalIgnoreCase)
        ? "block px-3 py-2 rounded-lg bg-sky-600 text-white"
        : "block px-3 py-2 rounded-lg text-slate-300 hover:bg-slate-800";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <partial name="_Head" />
</head>
<body class="min-h-screen bg-slate-100 font-sans text-slate-900">
    <div class="no-print lg:hidden fixed top-0 inset-x-0 z-40 flex items-center h-14 px-4 bg-white border-b border-slate-200">
        <button type="button" class="p-2 rounded-lg text-slate-700" onclick="document.getElementById('app-sidebar').classList.toggle('-translate-x-full'); document.getElementById('nav-backdrop').classList.toggle('hidden');" aria-label="Mở menu">
            <span class="block w-5 h-0.5 bg-slate-800 mb-1"></span>
            <span class="block w-5 h-0.5 bg-slate-800 mb-1"></span>
            <span class="block w-5 h-0.5 bg-slate-800"></span>
        </button>
        <a href="/" class="ml-3 flex items-center gap-2 min-w-0">
            <img src="~/images/logo-pancras.png" asp-append-version="true" alt="" class="h-10 w-10 rounded-md shrink-0" />
            <span class="font-display font-bold truncate">PancrasERP</span>
        </a>
        <form method="post" asp-page="/Account/Logout" class="ml-auto">
            <button type="submit" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-slate-100 text-slate-700">Đăng xuất</button>
        </form>
    </div>
    <div id="nav-backdrop" class="hidden fixed inset-0 z-40 bg-slate-900/50 lg:hidden" onclick="document.getElementById('app-sidebar').classList.add('-translate-x-full'); this.classList.add('hidden');"></div>
    <aside id="app-sidebar" class="no-print fixed inset-y-0 left-0 z-50 w-72 bg-slate-900 text-slate-300 -translate-x-full lg:translate-x-0 transition-transform">
        <div class="px-4 pt-6 pb-4">
            <a href="/" class="flex justify-center">
                <img src="~/images/logo-pancras.png" asp-append-version="true" alt="Pancras" class="h-auto w-36" />
            </a>
            <p class="mt-2 text-center text-xs text-slate-400">Thiết Bị Vệ Sinh &amp; Nội Thất</p>
        </div>
        <nav class="px-3 space-y-4 text-xs">
            <div>
                <div class="px-3 mb-1 text-[10px] font-bold tracking-wide text-slate-500">HỆ THỐNG</div>
                <a href="/" class="@homeLinkClass">Trang làm việc</a>
            </div>
            <div>
                <div class="px-3 mb-1 text-[10px] font-bold tracking-wide text-slate-500">VẬN HÀNH KHO BÃI</div>
                <a href="/nha-cung-cap" class="@supplierLinkClass">Nhà cung cấp nhập khẩu</a>
            </div>
            @if (canViewCatalog)
            {
                <div>
                    <div class="px-3 mb-1 text-[10px] font-bold tracking-wide text-slate-500">KINH DOANH &amp; PHÂN PHỐI</div>
                    <a href="/danh-muc-gia" class="@catalogLinkClass">Danh mục sản phẩm và giá</a>
                </div>
            }
            <div class="px-3 text-[10px] font-bold tracking-wide text-slate-500">TÀI CHÍNH</div>
            <div class="px-3 text-[10px] font-bold tracking-wide text-slate-500">DỊCH VỤ KHÁCH HÀNG</div>
            <div class="px-3 text-[10px] font-bold tracking-wide text-slate-500">QUẢN TRỊ NỘI BỘ</div>
        </nav>
    </aside>
    <div class="lg:pl-72">
        <header class="no-print hidden lg:flex items-center justify-between h-16 px-6 bg-white border-b border-slate-200">
            <div class="text-sm text-slate-500">PancrasERP / @ViewData["Title"]</div>
            <div class="flex items-center gap-3">
                <span class="text-sm font-medium text-slate-800">@User.Identity?.Name</span>
                <span class="px-2 py-1 text-xs font-bold rounded-full bg-sky-50 text-sky-700">@User.FindFirstValue(ClaimTypes.Role)</span>
                <form method="post" asp-page="/Account/Logout">
                    <button type="submit" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-slate-100 text-slate-700">Đăng xuất</button>
                </form>
            </div>
        </header>
        <main class="max-w-7xl p-4 pt-20 sm:p-6 lg:p-8 lg:pt-8">
            @RenderBody()
        </main>
    </div>
</body>
</html>
