@page "/locations"
@model Pancras.Web.Pages.Locations.IndexModel
@using Pancras.Application.Locations
@using Pancras.Domain.Inventory
@using Pancras.Web.Formatting
@{
    ViewData["Title"] = "Kho & Showroom";
    const string inputClass = Pancras.Web.Formatting.UiClasses.Input;
}

<section class="bg-white rounded-xl border border-slate-200 p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="font-display text-xl sm:text-2xl font-bold text-slate-900">Kho &amp; Showroom</h1>
            <p class="mt-1 text-sm text-slate-500">Địa điểm lưu kho và bán hàng. Nhân viên, tồn kho và đơn mua đều gắn với địa điểm ở đây.</p>
        </div>
        @if (Model.CanManage)
        {
            <a href="@Model.FormUrl" class="rounded-lg px-4 py-2 text-sm font-bold bg-sky-600 text-white hover:bg-sky-700 disabled:opacity-60">Thêm kho/showroom</a>
        }
    </div>
    @if (Model.HasAny)
    {
        <form method="get" action="/locations" data-live-filter class="mt-5">
            <input name="q" value="@Model.Search" type="search" placeholder="Tìm theo tên kho hoặc showroom..." aria-label="Tìm kiếm kho hoặc showroom" class="w-full border px-3 py-2 rounded-lg border-slate-300 text-sm focus:border-sky-600 focus:outline-none" />
        </form>
    }
</section>

<div id="live-results">
@if (Model.Locations.Count == 0)
{
    @if (Model.HasAny)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("Không có kho hoặc showroom khớp từ khóa.", "Thử tên khác.")' />
    }
    else
    {
        <partial name="_EmptyState" model='Model.CanManage ? new EmptyStateModel("Chưa có kho hoặc showroom.", "Thêm địa điểm đầu tiên để gán nhân viên và lập phiếu kho.", "Thêm kho/showroom", "/locations?form=1") : new EmptyStateModel("Chưa có kho hoặc showroom.", "Admin hoặc Giám đốc cần thêm địa điểm trước.")' />
    }
}
else
{
    <div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white">
        <table class="w-full min-w-[34rem] text-left text-sm">
            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                <tr>
                    <th class="px-3 py-3 font-semibold">Tên</th>
                    <th class="px-3 py-3 font-semibold">Loại</th>
                    <th class="px-3 py-3 font-semibold">Dấu vết</th>
                    @if (Model.CanManage)
                    {
                        <th class="px-3 py-3 text-right font-semibold">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var location in Model.Locations)
                {
                    <tr class="border-t border-slate-100 align-top hover:bg-slate-50">
                        <td class="px-3 py-3 font-bold text-slate-900">@location.Name</td>
                        <td class="px-3 py-3"><span class="@Badge.Classes(location.Kind == StockLocationKind.Showroom ? BadgeTone.Category : BadgeTone.Info)">@IndexModel.KindLabel(location.Kind)</span></td>
                        <td class="px-3 py-3"><partial name="_AuditStamp" model="Pancras.Application.Auditing.AuditStampView.From(location)" /></td>
                        @if (Model.CanManage)
                        {
                            <td class="px-3 py-3">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="@Model.EditUrl(location.Id)" class="rounded-lg px-3 py-1.5 text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:opacity-60">Sửa</a>
                                    <form method="post" asp-antiforgery="true" action="@Model.ActionUrl("Disable")" data-confirm data-confirm-title="Disable kho/showroom" data-confirm-message="Disable kho/showroom này? Địa điểm sẽ bị ẩn khỏi danh sách, lịch sử vẫn được giữ." data-confirm-label="Disable" data-confirm-tone="danger">
                                        <input type="hidden" name="id" value="@location.Id" />
                                        <button type="submit" class="px-3 py-1.5 text-sm font-medium rounded-lg text-rose-700 hover:bg-rose-50">Disable</button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
</div>

@if (Model.CanManage && Model.ShowForm)
{
    <dialog id="location-dialog" data-autoshow class="m-auto !flex w-[min(28rem,calc(100%-2rem))] max-h-[calc(100%-2rem)] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/50">
        <div class="flex shrink-0 items-center justify-between gap-3 px-6 pt-6">
            <h2 class="text-lg font-bold">Thêm kho/showroom</h2>
            <a href="@Model.ListUrl" class="text-slate-400" aria-label="Đóng">×</a>
        </div>
        <form method="post" asp-antiforgery="true" action="@Model.ActionUrl(null)" class="min-h-0 flex-1 overflow-y-auto px-6 pb-6">
            @if (Model.Error != LocationError.None)
            {
                <div class="mt-3"><partial name="_Notice" model="new NoticeModel(IndexModel.ErrorText(Model.Error), ToastLevel.Error)" /></div>
            }
            <div class="mt-4 space-y-3">
                <label class="block text-sm">Tên<span class="text-rose-600" aria-hidden="true"> *</span><input asp-for="Command.Name" maxlength="200" class="@inputClass" /></label>
                <label class="block text-sm">Loại
                    <select asp-for="Command.Kind" class="@inputClass">
                        <option value="@((int)StockLocationKind.Warehouse)">Kho</option>
                        <option value="@((int)StockLocationKind.Showroom)">Showroom</option>
                    </select>
                </label>
            </div>
            <div class="mt-4 flex justify-end gap-2">
                <a href="@Model.ListUrl" class="rounded-lg px-4 py-2 text-sm font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:opacity-60">Quay lại</a>
                <button type="submit" class="rounded-lg px-4 py-2 text-sm font-bold bg-sky-600 text-white hover:bg-sky-700 disabled:opacity-60">Lưu</button>
            </div>
        </form>
    </dialog>
}

@if (Model.CanManage && Model.EditId is not null)
{
    <dialog id="location-edit-dialog" data-autoshow class="m-auto !flex w-[min(28rem,calc(100%-2rem))] max-h-[calc(100%-2rem)] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/50">
        <div class="flex shrink-0 items-center justify-between gap-3 px-6 pt-6">
            <h2 class="text-lg font-bold">Sửa kho/showroom</h2>
            <a href="@Model.ListUrl" class="text-slate-400" aria-label="Đóng">×</a>
        </div>
        <form method="post" asp-antiforgery="true" action="@Model.ActionUrl("Update")" class="min-h-0 flex-1 overflow-y-auto px-6 pb-6">
            <input type="hidden" asp-for="Edit.Id" />
            <input type="hidden" asp-for="Edit.Version" />
            @if (Model.ManageError is not null)
            {
                <div class="mt-3"><partial name="_Notice" model="new NoticeModel(Model.ManageError, ToastLevel.Error)" /></div>
            }
            <div class="mt-4 space-y-3">
                <label class="block text-sm">Tên<span class="text-rose-600" aria-hidden="true"> *</span><input asp-for="Edit.Name" maxlength="200" class="@inputClass" /></label>
                <label class="block text-sm">Loại
                    <select asp-for="Edit.Kind" class="@inputClass">
                        <option value="@((int)StockLocationKind.Warehouse)">Kho</option>
                        <option value="@((int)StockLocationKind.Showroom)">Showroom</option>
                    </select>
                </label>
            </div>
            <div class="mt-4 flex justify-end gap-2">
                <a href="@Model.ListUrl" class="rounded-lg px-4 py-2 text-sm font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:opacity-60">Quay lại</a>
                <button type="submit" class="rounded-lg px-4 py-2 text-sm font-bold bg-sky-600 text-white hover:bg-sky-700 disabled:opacity-60">Lưu</button>
            </div>
        </form>
    </dialog>
}

<partial name="_ConfirmDialog" />
