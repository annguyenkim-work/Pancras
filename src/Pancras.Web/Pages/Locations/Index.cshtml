@page "/locations"
@model Pancras.Web.Pages.Locations.IndexModel
@using Pancras.Application.Locations
@using Pancras.Domain.Inventory
@{
    ViewData["Title"] = "Kho & Showroom";
    const string inputClass = "mt-1 w-full rounded-lg border border-slate-300 px-3 py-2";
}

<section class="bg-white rounded-xl border border-slate-200 p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="font-display text-xl sm:text-2xl font-bold text-slate-900">Kho &amp; Showroom</h1>
            <p class="mt-1 text-sm text-slate-500">Địa điểm lưu kho và bán hàng. Nhân viên, tồn kho và đơn mua đều gắn với địa điểm ở đây.</p>
        </div>
        @if (Model.CanManage)
        {
            <a href="/locations?form=1" class="px-4 py-2 text-sm font-bold text-white bg-sky-600 rounded-lg">Thêm kho/showroom</a>
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <p class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800" role="status">@Model.Notice</p>
    }
    @if (Model.HasAny)
    {
        <form method="get" action="/locations" data-live-filter class="mt-5">
            <input name="q" value="@Model.Search" type="search" placeholder="Tìm theo tên kho hoặc showroom..." aria-label="Tìm kiếm kho hoặc showroom" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" />
        </form>
    }
</section>

<div id="live-results">
@if (Model.Locations.Count == 0)
{
    @if (Model.HasAny)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("Không có kho hoặc showroom khớp từ khóa.", "Thử tên khác.")' />
    }
    else
    {
        <partial name="_EmptyState" model='Model.CanManage ? new EmptyStateModel("Chưa có kho hoặc showroom.", "Thêm địa điểm đầu tiên để gán nhân viên và lập phiếu kho.", "Thêm kho/showroom", "/locations?form=1") : new EmptyStateModel("Chưa có kho hoặc showroom.", "Admin hoặc Giám đốc cần thêm địa điểm trước.")' />
    }
}
else
{
    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
        @foreach (var location in Model.Locations)
        {
            <article class="flex items-center justify-between gap-3 bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
                <div><h2 class="text-sm font-bold text-slate-900">@location.Name</h2><partial name="_AuditStamp" model="Pancras.Application.Auditing.AuditStampView.From(location)" /></div>
                <span class="shrink-0 rounded-md px-2 py-1 text-xs font-medium @(location.Kind == StockLocationKind.Showroom ? "bg-violet-50 text-violet-700" : "bg-sky-50 text-sky-700")">@IndexModel.KindLabel(location.Kind)</span>
            </article>
        }
    </div>
}
</div>

@if (Model.CanManage && Model.ShowForm)
{
    <dialog id="location-dialog" class="m-auto !flex w-[min(28rem,calc(100%-2rem))] max-h-[calc(100%-2rem)] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/50">
        <div class="flex shrink-0 items-center justify-between gap-3 px-6 pt-6">
            <h2 class="text-lg font-bold">Thêm kho/showroom</h2>
            <a href="/locations" class="text-slate-400" aria-label="Đóng">×</a>
        </div>
        <form method="post" class="min-h-0 flex-1 overflow-y-auto px-6 pb-6">
            @if (Model.Error != LocationError.None)
            {
                <p class="mt-3 text-sm text-rose-700" role="alert">@IndexModel.ErrorText(Model.Error)</p>
            }
            <div class="mt-4 space-y-3">
                <label class="block text-sm">Tên<span class="text-rose-600" aria-hidden="true"> *</span><input asp-for="Command.Name" maxlength="200" class="@inputClass" /></label>
                <label class="block text-sm">Loại
                    <select asp-for="Command.Kind" class="@inputClass">
                        <option value="@((int)StockLocationKind.Warehouse)">Kho</option>
                        <option value="@((int)StockLocationKind.Showroom)">Showroom</option>
                    </select>
                </label>
            </div>
            <div class="mt-4 flex justify-end gap-2">
                <a href="/locations" class="px-4 py-2 text-sm rounded-lg bg-slate-100 text-slate-600">Hủy</a>
                <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-sky-600 rounded-lg">Lưu</button>
            </div>
        </form>
    </dialog>
    <script>document.getElementById("location-dialog").showModal();</script>
}
