@page "/inventory/transfers/{id:guid}/print"
@model Pancras.Web.Pages.Inventory.TransferPrintModel
@using Pancras.Web.Formatting
@{
    Layout = null;
    var slip = Model.Slip;
    var flow = slip.Flow;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Phiếu xuất kho @Model.Code</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
    <script src="~/js/print.js" asp-append-version="true" defer></script>
</head>
<body class="print-page">
    <div class="print-toolbar"><button type="button" data-print>In phiếu</button></div>
    <main class="print-sheet">
        <h1 class="font-display text-xl sm:text-2xl font-bold text-slate-900">Phiếu xuất kho</h1>
        <p class="print-sub">Chuyển kho nội bộ — @Model.Code</p>
        <div class="print-meta">
            <div><span>Kho xuất:</span> <strong>@slip.SourceName</strong></div>
            <div><span>Nơi nhận:</span> <strong>@slip.DestinationName</strong></div>
            <div><span>Trạng thái:</span> @StockLabels.TransferPill(slip.Status)</div>
            <div><span>Ngày duyệt:</span> @(flow?.ApprovedAt is { } approved ? VietnamTime.Format(approved) : "—")</div>
            <div><span>Người vận chuyển:</span> @(string.IsNullOrWhiteSpace(flow?.Carrier) ? "—" : flow!.Carrier)</div>
            <div><span>Số seal:</span> @(string.IsNullOrWhiteSpace(flow?.SealNumber) ? "—" : flow!.SealNumber)</div>
            @if (!string.IsNullOrWhiteSpace(slip.Note))
            {
                <div class="full"><span>Ghi chú:</span> @slip.Note</div>
            }
        </div>
        <table class="print-table">
            <thead>
                <tr>
                    <th class="col-stt">STT</th>
                    <th class="col-code">Mã</th>
                    <th>Tên hàng</th>
                    <th class="col-unit">Đơn vị</th>
                    <th class="num col-qty">Số lượng</th>
                    <th class="col-received">Thực nhận</th>
                </tr>
            </thead>
            <tbody>
                @for (var index = 0; index < slip.Lines.Count; index++)
                {
                    var line = slip.Lines[index];
                    <tr>
                        <td>@(index + 1)</td>
                        <td>@line.Code</td>
                        <td>@line.Name</td>
                        <td>@line.Unit</td>
                        <td class="num">@line.Quantity.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))</td>
                        <td class="blank"></td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="print-signs">
            <div><div class="role">Người lập</div><div class="hint">(Ký, ghi rõ họ tên)</div><div class="space"></div></div>
            <div><div class="role">Thủ kho xuất</div><div class="hint">(Ký, ghi rõ họ tên)</div><div class="space"></div></div>
            <div><div class="role">Người vận chuyển</div><div class="hint">(Ký, ghi rõ họ tên)</div><div class="space"></div></div>
            <div><div class="role">Người nhận</div><div class="hint">(Ký, ghi rõ họ tên)</div><div class="space"></div></div>
        </div>
        <p class="print-foot">In lúc @Model.PrintedAt</p>
    </main>
</body>
</html>
