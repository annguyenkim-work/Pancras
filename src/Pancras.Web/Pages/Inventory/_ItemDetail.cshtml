@model Pancras.Web.Pages.Inventory.IndexModel
@using Pancras.Application.Catalog
@using Pancras.Domain.Catalog
@using Pancras.Domain.Inventory
@using Pancras.Web.Formatting

@if (Model.Detail is not null)
{
    var profile = Model.Detail.Profile;
    <aside id="item-detail" class="fixed inset-y-0 right-0 z-50 flex w-full max-w-xl flex-col overflow-y-auto bg-white shadow-2xl">
        <div class="flex items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div>
                <p class="font-mono text-xs font-semibold text-slate-500">@profile.Code</p>
                <h2 class="font-display text-xl font-bold text-slate-900">@profile.Name</h2>
            </div>
            <a id="close-detail" href="@Model.CloseUrl()" class="rounded-lg px-2 py-1 text-slate-400" aria-label="Đóng">×</a>
        </div>
        <div class="space-y-6 p-5">
            <section>
                <h3 class="text-sm font-bold text-slate-900">Thông tin hàng hóa</h3>
                <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-3">
                    <div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] font-bold uppercase text-slate-500">Danh mục</p><p class="text-sm font-semibold">@CatalogLabels.Category(profile.Category)</p></div>
                    @if (!string.IsNullOrWhiteSpace(profile.Brand))
                    {
                        <div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] font-bold uppercase text-slate-500">Thương hiệu</p><p class="text-sm font-semibold">@profile.Brand</p></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(profile.Origin))
                    {
                        <div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] font-bold uppercase text-slate-500">Xuất xứ</p><p class="text-sm font-semibold">@profile.Origin</p></div>
                    }
                    @if (!string.IsNullOrWhiteSpace(profile.Unit))
                    {
                        <div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] font-bold uppercase text-slate-500">Đơn vị tính</p><p class="text-sm font-semibold">@profile.Unit</p></div>
                    }
                    @if (profile.WeightKg is decimal weight)
                    {
                        <div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] font-bold uppercase text-slate-500">Khối lượng</p><p class="text-sm font-semibold">@VndMoney.FormatMeasure(weight) kg</p></div>
                    }
                    @if (profile.WarrantyMonths is int warranty)
                    {
                        <div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] font-bold uppercase text-slate-500">Bảo hành</p><p class="text-sm font-semibold">@warranty tháng</p></div>
                    }
                    @if (profile.MinimumStock is decimal minimum)
                    {
                        <div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] font-bold uppercase text-slate-500">Tồn tối thiểu</p><p class="text-sm font-semibold">@VndMoney.FormatMeasure(minimum) @profile.Unit</p></div>
                    }
                    @if (Model.CanSeeCost)
                    {
                        <div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] font-bold uppercase text-slate-500">Giá vốn</p><p class="text-sm font-semibold">@VndMoney.FormatDong(profile.CostPrice)</p></div>
                    }
                    <div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] font-bold uppercase text-slate-500">Giá lẻ</p><p class="text-sm font-semibold">@VndMoney.FormatDong(profile.RetailPrice)</p></div>
                    <div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] font-bold uppercase text-slate-500">Giá đại lý</p><p class="text-sm font-semibold">@VndMoney.FormatDong(profile.DealerPrice)</p></div>
                    <div class="rounded-xl bg-slate-50 p-3"><p class="text-[11px] font-bold uppercase text-slate-500">Giá dự án</p><p class="text-sm font-semibold">@VndMoney.FormatDong(profile.ProjectPrice)</p></div>
                </div>
            </section>
            <section>
                <h3 class="text-sm font-bold text-slate-900">Tồn theo điểm</h3>
                @if (Model.Detail.Balances.Count == 0)
                {
                    <p class="mt-2 text-sm text-slate-500">Chưa có tồn tại địa điểm nào.</p>
                }
                else
                {
                    <table class="mt-2 w-full text-left text-sm">
                        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                            <tr>
                                <th class="px-3 py-2 font-semibold">Điểm</th>
                                <th class="px-3 py-2 font-semibold">Tồn</th>
                                <th class="px-3 py-2 font-semibold">Giữ chỗ</th>
                                <th class="px-3 py-2 font-semibold">Khả dụng</th>
                                <th class="py-2 font-semibold">Đang chuyển tới</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Detail.Balances)
                            {
                                <tr class="border-t border-slate-100">
                                    <td class="px-3 py-2">@row.LocationName</td>
                                    <td class="px-3 py-2 font-semibold">@IndexModel.Count(row.OnHand)</td>
                                    <td class="px-3 py-2 text-amber-600">@IndexModel.Count(row.Reserved)</td>
                                    <td class="px-3 py-2 text-emerald-600">@IndexModel.Count(row.Available)</td>
                                    <td class="py-2">@IndexModel.Count(row.InTransit)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
            <section>
                <div class="flex flex-wrap items-center justify-between gap-2">
                    <h3 class="text-sm font-bold text-slate-900">Lịch sử thay đổi</h3>
                    <form method="get" action="/inventory" class="flex items-center gap-2">
                        <input type="hidden" name="view" value="balances" />
                        <input type="hidden" name="item" value="@profile.Id" />
                        <input type="hidden" name="q" value="@Model.Search" />
                        <input type="hidden" name="location" value="@Model.Location" />
                        <input type="hidden" name="category" value="@Model.Category" />
                        <input type="hidden" name="kind" value="@Model.HistoryKind" />
                        <select name="size" class="rounded-lg border border-slate-200 px-2 py-1 text-xs" data-auto-submit>
                            @foreach (var size in new[] { 10, 20, 50 })
                            {
                                if (Model.HistorySize == size)
                                {
                                    <option value="@size" selected>@size</option>
                                }
                                else
                                {
                                    <option value="@size">@size</option>
                                }
                            }
                        </select>
                        <select name="place" class="rounded-lg border border-slate-200 px-2 py-1 text-xs" data-auto-submit>
                            <option value="">Tất cả địa điểm</option>
                            @foreach (var location in Model.AllLocations)
                            {
                                if (string.Equals(Model.HistoryPlace, location.Id.ToString(), StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@location.Id" selected>@location.Name</option>
                                }
                                else
                                {
                                    <option value="@location.Id">@location.Name</option>
                                }
                            }
                        </select>
                    </form>
                </div>
                <div class="mt-3 flex flex-wrap gap-1">
                    @{
                        var kinds = new (string Token, string Label)[]
                        {
                            ("", "Tất cả"),
                            ("receipt", "Nhập"),
                            ("issue", "Xuất bán"),
                            ("transfer", "Chuyển kho"),
                            ("adjustment", "Điều chỉnh")
                        };
                    }
                    @foreach (var kind in kinds)
                    {
                        var active = string.Equals(Model.HistoryKind ?? "", kind.Token, StringComparison.Ordinal);
                        <a href="@Model.HistoryKindUrl(kind.Token)" class="rounded-full px-3 py-1 text-xs font-semibold @(active ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-600")">@kind.Label</a>
                    }
                </div>
                <p class="mt-2 text-xs text-slate-500">Hiển thị @Model.VisibleHistory.Count / @Model.HistoryTotal dòng</p>
                @if (Model.VisibleHistory.Count == 0)
                {
                    <p class="mt-3 text-sm text-slate-500">Chưa có lịch sử thay đổi.</p>
                }
                <div class="mt-3 space-y-2">
                    @foreach (var entry in Model.VisibleHistory)
                    {
                        var badge = Model.MovementBadge(entry);
                        <article class="rounded-xl border border-slate-100 p-3">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <span class="@Badge.Frame @badge.ClassName">@badge.Label</span>
                                    <p class="mt-1 text-sm font-medium text-slate-900">@Model.Describe(entry)</p>
                                    <p class="text-xs text-slate-500">@VietnamTime.Format(entry.OccurredAt, "yyyy-MM-dd HH:mm") · @entry.LocationName</p>
                                </div>
                                <p class="text-sm font-bold @(entry.Quantity < 0 ? "text-rose-600" : "text-emerald-700")">@(entry.Quantity > 0 ? "+" : "")@IndexModel.Count(entry.Quantity)</p>
                            </div>
                        </article>
                    }
                </div>
                @if (Model.HistoryTotal > Model.HistorySize)
                {
                    <div class="mt-3 flex gap-2 text-sm">
                        @if (Model.HistoryPage > 1)
                        {
                            <a class="font-semibold text-sky-700" href="@Model.HistoryPageUrl(Model.HistoryPage - 1)">Trước</a>
                        }
                        @if (Model.HistoryTo < Model.HistoryTotal)
                        {
                            <a class="font-semibold text-sky-700" href="@Model.HistoryPageUrl(Model.HistoryPage + 1)">Sau</a>
                        }
                    </div>
                }
            </section>
        </div>
    </aside>
}

