@model Pancras.Web.Pages.Inventory.IndexModel
@using Pancras.Application.Catalog
@using Pancras.Domain.Catalog
@using Pancras.Domain.Inventory
@using Pancras.Web.Formatting

<section class="space-y-4">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 flex flex-col gap-3 sm:flex-row sm:items-center">
        <div>
            <h2 class="font-display text-lg font-bold text-slate-900">Kiểm Kê Kho Định Kỳ &amp; Cân Đối Tồn Kho</h2>
            <p class="mt-1 text-sm text-slate-500">Ghi nhận chênh lệch giữa số đếm thực tế và số sách. Phiếu của Thủ kho và Trưởng kho chờ duyệt; Admin, Giám đốc, Kế toán ghi thẳng.</p>
        </div>
        <div class="sm:ml-auto flex flex-wrap gap-2">
            @if (Model.CanCountStock)
            {
                <button id="open-stocktake" type="button" class="inline-flex items-center rounded-lg px-4 py-2 text-sm font-bold bg-violet-600 text-white hover:bg-violet-700 disabled:opacity-60" data-open-dialog="stocktake-dialog">+ Lập Biên Bản Kiểm Kê</button>
            }
            @if (Model.CanDraftAdjustment || Model.CanPostAdjustment)
            {
                <button type="button" class="inline-flex items-center rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white" data-open-dialog="adjustment-dialog">+ Phiếu điều chỉnh</button>
            }
            <button type="button" class="inline-flex items-center rounded-lg px-4 py-2 text-sm font-bold bg-rose-600 text-white hover:bg-rose-700 disabled:opacity-60" data-open-dialog="disposal-dialog">+ Phiếu hủy</button>
        </div>
    </div>
    @{ var slice = Model.StocktakeSlice; }
    @if (slice.Total == 0)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("Chưa có biên bản kiểm kê.", "Biên bản kiểm kê và phiếu điều chỉnh sẽ hiện ở đây.")' />
    }
    @foreach (var sheet in slice.Stocktakes)
    {
        var when = IndexModel.When(sheet.Id);
        <article id="document-@sheet.Id" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
            <div class="flex flex-wrap items-center gap-2">
                <span class="font-mono text-sm font-bold">@StockLabels.DocumentCode("KK", sheet.Id)</span>
                <span class="text-sm text-slate-600">@sheet.LocationName</span>
                <span class="@Badge.Frame @(Badge.Colors(sheet.Status == ApprovalStatus.Approved ? BadgeTone.Success : BadgeTone.Warning))">@StockLabels.StocktakePill(sheet.Status)</span>
                @if (!string.IsNullOrEmpty(when))
                {
                    <span class="ml-auto text-xs text-slate-500">@when</span>
                }
            </div>
            <div class="mt-1"><partial name="_AuditStamp" model="sheet.Stamp" /></div>
            <div class="mt-4 overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                        <tr>
                            <th class="px-3 py-2 font-semibold">Mã SKU</th>
                            <th class="px-3 py-2 font-semibold">Tên sản phẩm</th>
                            <th class="px-3 py-2 font-semibold">ĐVT</th>
                            <th class="px-3 py-2 font-semibold">Tồn sổ sách</th>
                            <th class="px-3 py-2 font-semibold">Tồn thực đếm</th>
                            <th class="px-3 py-2 font-semibold">Chênh lệch</th>
                            <th class="py-2 font-semibold">Lý do chênh lệch</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-t border-slate-100">
                            <td class="px-3 py-2 font-mono text-xs">@sheet.Code</td>
                            <td class="px-3 py-2">@sheet.Name</td>
                            <td class="px-3 py-2">@(string.IsNullOrWhiteSpace(sheet.Unit) ? "—" : sheet.Unit)</td>
                            <td class="px-3 py-2">@IndexModel.Count(sheet.BookQuantity)</td>
                            <td class="px-3 py-2 font-semibold">@IndexModel.Count(sheet.CountedQuantity)</td>
                            <td class="px-3 py-2 font-semibold @(sheet.Variance < 0 ?"text-rose-600" : "text-slate-800")">@IndexModel.Count(sheet.Variance)</td>
                            <td class="py-2">@sheet.Reason</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            @if (!string.IsNullOrWhiteSpace(sheet.DocumentRef))
            {
                <p class="mt-3 text-sm text-slate-600">Chứng từ: @sheet.DocumentRef</p>
            }
            @if (sheet.Files is { Count: > 0 })
            {
                <ul class="mt-2 flex flex-wrap gap-2 text-sm">
                    @foreach (var file in sheet.Files)
                    {
                        <li><a href="/inventory?handler=StockFile&amp;id=@file.Id" class="inline-flex items-center rounded-lg border border-slate-200 px-3 py-1 text-sky-700 hover:bg-sky-50">@file.FileName</a></li>
                    }
                </ul>
            }

            @if (sheet.Status == ApprovalStatus.Pending && sheet.CanApprove)
            {
                <form method="post" asp-antiforgery="true" action="/inventory?handler=ApproveStocktake" class="mt-4 flex justify-end">
                    <input type="hidden" name="DocumentId" value="@sheet.Id" />
                    <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white">Duyệt biên bản</button>
                </form>
            }
        </article>
    }

    @if (slice.Adjustments.Count > 0)
    {
        <h3 class="font-display text-base font-bold text-slate-900">Điều chỉnh số lượng</h3>
        @foreach (var sheet in slice.Adjustments)
        {
            <article id="document-@sheet.Id" class="bg-white rounded-2xl border border-slate-200 p-4 text-sm">
                <p class="font-semibold"><span class="font-mono text-xs font-bold">@StockLabels.DocumentCode("DC", sheet.Id)</span> @sheet.Code — @sheet.Name <span class="font-normal text-slate-500">@sheet.LocationName</span></p>
                <p class="mt-1 text-slate-600">Chênh lệch @sheet.Delta. @sheet.Reason. @StockLabels.Approval(sheet.Status)</p>
                @if (sheet.TransferSlipId is Guid fromTransfer)
                {
                    <p class="mt-1 text-xs text-slate-500">Ghi nhận tự động khi nhận hàng chuyển kho <a class="font-mono font-semibold text-sky-700" href="/inventory?view=transfers&open=@fromTransfer">@Model.TransferCodeOf(fromTransfer)</a>. Tồn kho đã đúng số thực nhận, phiếu này không cộng trừ thêm.</p>
                }
                @if (sheet.Files is { Count: > 0 })
                {
                    <ul class="mt-2 flex flex-wrap gap-2 text-sm">
                        @foreach (var file in sheet.Files)
                        {
                            <li><a href="/inventory?handler=StockFile&amp;id=@file.Id" class="inline-flex items-center rounded-lg border border-slate-200 px-3 py-1 text-sky-700 hover:bg-sky-50">@file.FileName</a></li>
                        }
                    </ul>
                }
                <partial name="_AuditStamp" model="sheet.Stamp" />
                @if (sheet.Status == ApprovalStatus.Pending && sheet.CanApprove)
                {
                    <form method="post" asp-antiforgery="true" action="/inventory?handler=ApproveAdjustment" class="mt-3">
                        <input type="hidden" name="DocumentId" value="@sheet.Id" />
                        <button type="submit" class="rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-bold text-white">Duyệt điều chỉnh</button>
                    </form>
                }
            </article>
        }
    }
    @if (slice.Disposals.Count > 0)
    {
        <h3 class="font-display text-base font-bold text-slate-900">Phiếu hủy</h3>
        @foreach (var slip in slice.Disposals)
        {
            <article id="document-@slip.Id" class="bg-white rounded-2xl border border-slate-200 p-4 text-sm">
                <p class="font-semibold"><span class="font-mono text-xs font-bold">@StockLabels.DocumentCode("HY", slip.Id)</span> @slip.Code — @slip.Name <span class="font-normal text-slate-500">@slip.LocationName</span> <span class="font-mono font-bold tabular-nums">× @slip.Quantity</span></p>
                <p class="mt-1 text-slate-600">@slip.Reason. @StockLabels.Approval(slip.Status)</p>
                @if (slip.Files is { Count: > 0 })
                {
                    <ul class="mt-2 flex flex-wrap gap-2 text-sm">
                        @foreach (var file in slip.Files)
                        {
                            <li><a href="/inventory?handler=StockFile&amp;id=@file.Id" class="inline-flex items-center rounded-lg border border-slate-200 px-3 py-1 text-sky-700 hover:bg-sky-50">@file.FileName</a></li>
                        }
                    </ul>
                }
                <partial name="_AuditStamp" model="slip.Stamp" />
                @if (slip.Status == ApprovalStatus.Pending && slip.CanApprove)
                {
                    <form method="post" asp-antiforgery="true" action="/inventory?handler=ApproveDisposal" class="mt-3">
                        <input type="hidden" name="DocumentId" value="@slip.Id" />
                        <button type="submit" class="rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-bold text-white">Duyệt hủy</button>
                    </form>
                }
            </article>
        }
    }
    <partial name="_Pager" model="Model.StocktakePager" />
</section>
