@page "/inventory"
@model Pancras.Web.Pages.Inventory.IndexModel
@using Pancras.Application.Catalog
@using Pancras.Domain.Catalog
@using Pancras.Domain.Inventory
@using Pancras.Web.Formatting
@{
    ViewData["Title"] = "Kho và điều chuyển";
    TabsModel InventoryTabs()
    {
        var tabs = new List<TabItem> { new("tab-balances", "Tra cứu tồn kho", Model.ViewUrl("balances"), Model.ActiveView == "balances") };
        if (Model.CanOperate)
        {
            tabs.Add(new("tab-transfers", "Chuyển kho", Model.ViewUrl("transfers"), Model.ActiveView == "transfers", Model.PendingForMeCount, "Phiếu đang chờ bạn xử lý"));
            tabs.Add(new("tab-stocktakes", "Kiểm kê & điều chỉnh", Model.ViewUrl("stocktakes"), Model.ActiveView == "stocktakes"));
        }

        return new TabsModel("Màn hình kho", tabs);
    }
}

<div class="space-y-4">
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
                <h1 class="font-display text-xl sm:text-2xl font-bold text-slate-900">Quản Lý Đa Kho &amp; Điều Chuyển Hàng Hóa</h1>
                <p class="mt-1 text-sm text-slate-500">@Model.Subtitle</p>
            </div>
            @if (Pancras.Web.Help.HelpTopics.Find("inventory." + Model.ActiveView) is { } help)
            {
                <partial name="_HelpButton" model="help" />
            }
        </div>
        @* Lỗi hiện ở đầu trang cả khi thao tác trên phiếu bị chặn. Người không thấy phiếu (không có trong danh sách) không nhận thông báo. *@
        @if (!string.IsNullOrEmpty(Model.ErrorMessage)
            && !Model.ShowTransferDialog
            && (Model.OpenTransferId is null || Model.Transfers.Any(slip => slip.Id == Model.OpenTransferId)))
        {
            <div class="mt-3"><partial name="_Notice" model="new NoticeModel(Model.ErrorMessage, ToastLevel.Error)" /></div>
        }
        <div class="mt-4">
            <partial name="_Tabs" model="InventoryTabs()" />
        </div>
    </section>
    @if (Model.ActiveView == "balances")
    {
        <partial name="_Balances" model="Model" />
    }
    else if (Model.ActiveView == "transfers")
    {
        <partial name="_Transfers" model="Model" />
    }
    else
    {
        <partial name="_Stocktakes" model="Model" />
    }
</div>

<partial name="_Dialogs" model="Model" />
<partial name="_ItemDetail" model="Model" />
@if (Pancras.Web.Help.HelpTopics.Find("inventory." + Model.ActiveView) is { } helpTopic)
{
    <partial name="_HelpDialog" model="helpTopic" />
}

<script type="application/json" id="stock-map">@Html.Raw(Model.BalanceJson)</script>
<div id="inventory-boot" hidden data-show-transfer-dialog="@(Model.ShowTransferDialog ? "true" : "false")" data-open-transfer="@(Model.OpenTransferId is Guid openId ? openId.ToString("D") : "")" data-show-stocktake-dialog="@(Model.ShowStocktakeDialog ? "true" : "false")"></div>
<script src="~/js/inventory-page.js" asp-append-version="true" defer></script>
