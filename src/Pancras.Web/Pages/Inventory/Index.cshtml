        <div class="mt-5 flex justify-end gap-2">
            <button type="button" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700" onclick="this.closest('dialog').close()">Hủy</button>
            <button type="submit" class="rounded-xl bg-violet-600 px-4 py-2 text-sm font-bold text-white">Lưu Biên Bản Kiểm Kê</button>
        </div>
    </form>
