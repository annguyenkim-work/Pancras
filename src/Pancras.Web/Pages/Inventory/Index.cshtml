@page "/inventory"
@model Pancras.Web.Pages.Inventory.IndexModel
@using Pancras.Application.Catalog
@using Pancras.Domain.Catalog
@using Pancras.Domain.Inventory
@using Pancras.Web.Formatting
@{
    ViewData["Title"] = "Kho và điều chuyển";
    string TabClass(string view) => Model.ActiveView == view
        ? "inline-flex items-center gap-2 px-3 py-2 text-sm font-semibold rounded-xl bg-white text-slate-900 shadow-sm border border-slate-200"
        : "inline-flex items-center gap-2 px-3 py-2 text-sm font-medium rounded-xl text-slate-600 hover:bg-white/70";
}

<div class="space-y-4">
    <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 sm:p-6">
        <h1 class="font-display text-xl sm:text-2xl font-bold text-slate-900">Quản Lý Đa Kho &amp; Điều Chuyển Hàng Hóa</h1>
        <p class="mt-1 text-sm text-slate-500">@Model.Subtitle</p>
        @if (!string.IsNullOrEmpty(Model.ErrorMessage) && Model.OpenTransferId is null)
        {
            <p class="mt-3 text-sm font-medium text-rose-700" role="alert">@Model.ErrorMessage</p>
        }
        <div class="mt-4 flex flex-wrap items-center gap-2">
            <a id="tab-balances" href="@Model.ViewUrl("balances")" class="@TabClass("balances")">Tra cứu tồn kho</a>
            @if (Model.CanOperate)
            {
                <a id="tab-transfers" href="@Model.ViewUrl("transfers")" class="@TabClass("transfers")">
                    Chuyển kho
                    @if (Model.PendingForMeCount > 0)
                    {
                        <span class="inline-flex min-w-5 justify-center rounded-full bg-sky-600 px-1.5 text-xs font-bold text-white" title="Phiếu đang chờ bạn xử lý">@Model.PendingForMeCount</span>
                    }
                </a>
                <a id="tab-stocktakes" href="@Model.ViewUrl("stocktakes")" class="@TabClass("stocktakes")">Kiểm kê &amp; điều chỉnh</a>
            }
        </div>
    </section>
    @if (Model.Notices.Count > 0)
    {
        <section class="rounded-2xl border border-sky-200 bg-sky-50 p-4">
            <h2 class="text-sm font-bold text-slate-900">Thông báo kho</h2>
            <ul class="mt-2 space-y-2 text-sm">
                @foreach (var notice in Model.Notices)
                {
                    <li class="flex flex-wrap items-center justify-between gap-2">
                        <span class="@(notice.Seen ? "text-slate-500" : "font-semibold text-slate-900")">@(notice.Kind == StockNoticeKind.Transfer ? StockLabels.DocumentCode("CK", notice.DocumentId) + ": " : "")@notice.Step @(notice.Seen ? "(đã xem)" : "")</span>
                        <form method="post" asp-antiforgery="true" action="/inventory?handler=OpenNotice">
                            <input type="hidden" name="noticeId" value="@notice.Id" />
                            <button type="submit" class="font-bold text-sky-700">Mở phiếu</button>
                        </form>
                    </li>
                }
            </ul>
        </section>
    }

    @if (Model.ActiveView == "balances")
    {
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 sm:p-5">
            <form method="get" action="/inventory" data-live-filter class="flex flex-col gap-3 lg:flex-row lg:items-center">
                <input type="search" name="q" value="@Model.Search" placeholder="Tìm theo mã SKU, tên thiết bị, thương hiệu..." aria-label="Tìm kiếm" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm lg:max-w-md" />
                @if (Model.AllLocations.Count > 1)
                {
                    <select name="location" aria-label="Kho hoặc showroom" class="rounded-lg border border-slate-200 px-3 py-2 text-sm">
                        <option value="">@Model.LocationOptionLabel</option>
                        @foreach (var location in Model.AllLocations)
                        {
                            if (string.Equals(Model.Location, location.Id.ToString(), StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@location.Id" selected>@location.Name</option>
                            }
                            else
                            {
                                <option value="@location.Id">@location.Name</option>
                            }
                        }
                    </select>
                }
                <select name="category" aria-label="Ngành hàng" class="rounded-lg border border-slate-200 px-3 py-2 text-sm">
                    <option value="">Tất cả ngành hàng</option>
                    @foreach (var category in Enum.GetValues<ProductCategory>())
                    {
                        var token = ProductCategoryToken.From(category);
                        if (string.Equals(Model.Category, token, StringComparison.Ordinal))
                        {
                            <option value="@token" selected>@CatalogLabels.Category(category)</option>
                        }
                        else
                        {
                            <option value="@token">@CatalogLabels.Category(category)</option>
                        }
                    }
                </select>
                @if (Model.CanExport)
                {
                    @Html.AntiForgeryToken()
                    <button type="submit" formmethod="post" formaction="/inventory?handler=Export" class="lg:ml-auto rounded-lg bg-emerald-50 px-4 py-2 text-sm font-bold text-emerald-700">Xuất Excel</button>
                }
            </form>
            <div id="live-results">
                <p class="mt-3 text-sm text-slate-500">@Model.Groups.Count mặt hàng</p>
                <div class="mt-4 overflow-x-auto">
                <table class="min-w-[960px] w-full text-left text-sm">
                    <thead class="text-xs uppercase tracking-wide text-slate-500">
                        <tr>
                            <th class="py-2 pr-3 font-semibold">Mã SKU</th>
                            <th class="py-2 pr-3 font-semibold">Tên hàng hóa &amp; Quy cách</th>
                            <th class="py-2 pr-3 font-semibold">ĐVT</th>
                            @if (Model.CanSeeCost)
                            {
                                <th class="py-2 pr-3 font-semibold">Giá vốn niên yết</th>
                            }
                            <th class="py-2 pr-3 font-semibold">Tồn thực tế</th>
                            <th class="py-2 pr-3 font-semibold">Đang giữ chỗ</th>
                            <th class="py-2 pr-3 font-semibold">Khả dụng</th>
                            <th class="py-2 pr-3 font-semibold">Đang chuyển</th>
                            <th class="py-2 pr-3 font-semibold">Tồn tại các điểm</th>
                            <th class="py-2 font-semibold">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Groups.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="py-8 text-center text-slate-500">Không có kết quả.</td>
                            </tr>
                        }
                        @foreach (var group in Model.Groups)
                        {
                            <tr class="border-t border-slate-100 align-top">
                                <td class="py-3 pr-3 font-mono text-xs font-semibold text-slate-800">@group.Code</td>
                                <td class="py-3 pr-3">
                                    <div class="font-medium text-slate-900">@group.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(group.Brand) || !string.IsNullOrWhiteSpace(group.Origin))
                                    {
                                        <div class="text-xs text-slate-500">@group.Brand@(!string.IsNullOrWhiteSpace(group.Brand) && !string.IsNullOrWhiteSpace(group.Origin) ? " · " : "")@group.Origin</div>
                                    }
                                </td>
                                <td class="py-3 pr-3 text-slate-600">@(string.IsNullOrWhiteSpace(group.Unit) ? "—" : group.Unit)</td>
                                @if (Model.CanSeeCost)
                                {
                                    <td class="py-3 pr-3 text-slate-700">@VndMoney.FormatDong(group.CostPrice)</td>
                                }
                                <td class="py-3 pr-3 font-semibold text-slate-900">@IndexModel.Count(group.OnHand)</td>
                                <td class="py-3 pr-3 font-semibold text-amber-600">@IndexModel.Count(group.Reserved)</td>
                                <td class="py-3 pr-3 font-semibold text-emerald-600">@IndexModel.Count(group.Available)</td>
                                <td class="py-3 pr-3 font-semibold text-sky-700">@IndexModel.Count(group.InTransit)</td>
                                <td class="py-3 pr-3">
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var place in group.Places)
                                        {
                                            var code = Model.PlaceCode(place.LocationId);
                                            <span class="rounded-md bg-slate-100 px-1.5 py-0.5 text-[11px] font-semibold text-slate-600" title="@place.Name">@code @IndexModel.Count(place.OnHand)</span>
                                        }
                                    </div>
                                </td>
                                <td class="py-3">
                                    <a class="text-sm font-semibold text-sky-700" href="@Model.ItemUrl(group.CatalogItemId)">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            </div>
        </section>
    }
    else if (Model.ActiveView == "transfers")
    {
        <section class="space-y-4">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 flex flex-col gap-3 sm:flex-row sm:items-center">
                <div>
                    <h2 class="font-display text-lg font-bold text-slate-900">Lịch Sử Điều Chuyển Hàng Giữa Các Kho &amp; Showroom</h2>
                    <p class="mt-1 text-sm text-slate-500">Hàng hóa chuyển từ kho này sang kho hoặc showroom khác được theo dõi theo trạng thái đang vận chuyển. Bấm vào một phiếu để xem chi tiết và xử lý.</p>
                </div>
                <button id="open-transfer" type="button" class="sm:ml-auto inline-flex items-center rounded-xl bg-sky-600 px-4 py-2 text-sm font-bold text-white hover:bg-sky-700" onclick="document.getElementById('transfer-dialog').showModal()">+ Tạo Phiếu Đề Nghị Chuyển Kho</button>
            </div>

            @{
                var quickFilters = new (string Token, string Label)[]
                {
                    ("all", "Tất cả"),
                    ("decide", "Chờ tôi duyệt"),
                    ("ship", "Chờ tôi xuất kho"),
                    ("receive", "Chờ tôi nhận hàng"),
                    ("resolve", "Chờ xử lý chênh lệch")
                };
                var activeQuick = string.IsNullOrWhiteSpace(Model.TransferQuick) ? "all" : Model.TransferQuick;
            }
            <div class="flex flex-wrap items-center gap-2" id="transfer-quick-filters">
                @foreach (var quick in quickFilters)
                {
                    var count = quick.Token == "all" ? 0 : Model.CountFor(quick.Token);
                    if (quick.Token != "all" && count == 0 && activeQuick != quick.Token)
                    {
                        continue;
                    }

                    <a href="@Model.TransferUrl(quick.Token, null, keepFilters: false)" class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-sm font-semibold @(activeQuick == quick.Token ? "bg-slate-900 text-white" : "bg-white text-slate-600 border border-slate-200 hover:bg-slate-50")">
                        @quick.Label
                        @if (quick.Token != "all")
                        {
                            <span class="inline-flex min-w-5 justify-center rounded-full bg-sky-600 px-1.5 text-xs font-bold text-white">@count</span>
                        }
                    </a>
                }
            </div>

            <form method="get" action="/inventory" id="transfer-filter" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-4 grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-6">
                <input type="hidden" name="view" value="transfers" />
                @if (!string.IsNullOrWhiteSpace(Model.TransferQuick) && Model.TransferQuick != "all")
                {
                    <input type="hidden" name="tf" value="@Model.TransferQuick" />
                }
                <input type="search" name="tq" value="@Model.TransferSearch" placeholder="Mã phiếu, mã SKU, tên hàng..." aria-label="Tìm phiếu" class="rounded-lg border border-slate-200 px-3 py-2 text-sm lg:col-span-2" />
                <select name="ts" aria-label="Trạng thái" class="rounded-lg border border-slate-200 px-3 py-2 text-sm">
                    <option value="">Mọi trạng thái</option>
                    @foreach (var status in new[] { TransferStatus.Requested, TransferStatus.Approved, TransferStatus.InTransit, TransferStatus.ReceivedWithDiscrepancy, TransferStatus.Received, TransferStatus.Rejected, TransferStatus.Cancelled, TransferStatus.Returned })
                    {
                        <option value="@status" selected="@(string.Equals(Model.TransferStatusFilter, status.ToString(), StringComparison.OrdinalIgnoreCase))">@StockLabels.TransferPill(status)</option>
                    }
                </select>
                <select name="tl" aria-label="Kho hoặc showroom" class="rounded-lg border border-slate-200 px-3 py-2 text-sm">
                    <option value="">Mọi kho / showroom</option>
                    @foreach (var place in Model.AllLocations)
                    {
                        <option value="@place.Id" selected="@(string.Equals(Model.TransferLocation, place.Id.ToString(), StringComparison.OrdinalIgnoreCase))">@place.Name</option>
                    }
                </select>
                <input type="date" name="tfrom" value="@Model.TransferFrom" aria-label="Từ ngày" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
                <input type="date" name="tto" value="@Model.TransferTo" aria-label="Đến ngày" class="rounded-lg border border-slate-200 px-3 py-2 text-sm" />
                <div class="flex gap-2 md:col-span-2 lg:col-span-6 lg:justify-end">
                    <button type="submit" class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-bold text-white">Lọc</button>
                    @if (Model.HasTransferFilter)
                    {
                        <a href="/inventory?view=transfers" class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700">Xóa lọc</a>
                    }
                </div>
            </form>

            @if (Model.Transfers.Count == 0)
            {
                <partial name="_EmptyState" model='new EmptyStateModel("Chưa có phiếu chuyển.", "Phiếu chuyển kho giữa các kho và showroom sẽ hiện ở đây.")' />
            }
            else if (Model.TransferTotal == 0)
            {
                <partial name="_EmptyState" model='new EmptyStateModel("Không có phiếu phù hợp.", "Thử bỏ bớt điều kiện lọc.")' />
            }
            else
            {
                <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-x-auto">
                    <table id="transfer-table" class="w-full text-left text-sm">
                        <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
                            <tr>
                                <th class="px-4 py-3 font-semibold">Mã phiếu</th>
                                <th class="px-4 py-3 font-semibold">Kho xuất → Nơi nhận</th>
                                <th class="px-4 py-3 font-semibold">Hàng</th>
                                <th class="px-4 py-3 font-semibold">Trạng thái</th>
                                <th class="px-4 py-3 font-semibold">Người lập</th>
                                <th class="px-4 py-3 font-semibold">Ngày lập</th>
                                <th class="px-4 py-3 font-semibold">Việc của bạn</th>
                                <th class="px-4 py-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slip in Model.FilteredTransfers.Skip((Model.CurrentTransferPage - 1) * IndexModel.TransferPageSize).Take(IndexModel.TransferPageSize))
                            {
                                var flow = slip.Flow;
                                var todo = flow is null ? null
                                    : flow.CanDecide ? "Chờ bạn duyệt"
                                    : flow.CanShip ? "Chờ bạn xuất kho"
                                    : flow.CanReceive ? "Chờ bạn nhận hàng"
                                    : flow.CanResolve ? "Chờ bạn xử lý chênh lệch"
                                    : null;
                                <tr class="border-t border-slate-100 hover:bg-slate-50 cursor-pointer" onclick="openTransfer('@slip.Id')">
                                    <td class="px-4 py-3 font-mono text-xs font-bold text-slate-900">@StockLabels.DocumentCode("CK", slip.Id)</td>
                                    <td class="px-4 py-3">@slip.SourceName <span class="text-slate-400">→</span> @slip.DestinationName</td>
                                    <td class="px-4 py-3 text-slate-600">@slip.Lines.Count mặt hàng · @IndexModel.Count(slip.Lines.Sum(line => line.Quantity)) sản phẩm</td>
                                    <td class="px-4 py-3"><span class="rounded-full px-2 py-0.5 text-xs font-bold @StockLabels.TransferPillClass(slip.Status)">@StockLabels.TransferPill(slip.Status)</span></td>
                                    <td class="px-4 py-3 text-slate-600">@(string.IsNullOrEmpty(slip.Stamp?.CreatedBy) ? "—" : slip.Stamp!.CreatedBy)</td>
                                    <td class="px-4 py-3 text-slate-600">@(IndexModel.When(slip.Id) is { Length: > 0 } created ? created : "—")</td>
                                    <td class="px-4 py-3">@if (todo is not null) { <span class="rounded-full bg-sky-600 px-2 py-0.5 text-xs font-bold text-white">@todo</span> } else { <span class="text-slate-400">—</span> }</td>
                                    <td class="px-4 py-3 text-right"><button type="button" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-bold text-slate-700 hover:bg-white" onclick="event.stopPropagation(); openTransfer('@slip.Id')">Chi tiết</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.TransferPageCount > 1)
                {
                    <nav class="flex flex-wrap items-center justify-between gap-2 text-sm" aria-label="Phân trang phiếu chuyển">
                        <p class="text-slate-500">Trang @Model.CurrentTransferPage / @Model.TransferPageCount · @Model.TransferTotal phiếu</p>
                        <div class="flex gap-2">
                            @if (Model.CurrentTransferPage > 1)
                            {
                                <a class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-semibold text-sky-700" href="@Model.TransferUrl(activeQuick, Model.CurrentTransferPage - 1)">Trước</a>
                            }
                            @if (Model.CurrentTransferPage < Model.TransferPageCount)
                            {
                                <a class="rounded-lg border border-slate-200 bg-white px-3 py-1.5 font-semibold text-sky-700" href="@Model.TransferUrl(activeQuick, Model.CurrentTransferPage + 1)">Sau</a>
                            }
                        </div>
                    </nav>
                }
            }

            @foreach (var slip in Model.PagedTransfers)
            {
                var flow = slip.Flow;
                var slipCode = StockLabels.DocumentCode("CK", slip.Id);
                var hasDiscrepancy = flow?.HasDiscrepancy == true || slip.Status == TransferStatus.ReceivedWithDiscrepancy;
                var stepTotal = hasDiscrepancy ? StockLabels.TransferSteps.Count : StockLabels.TransferSteps.Count - 1;
                var stepsDone = slip.Status == TransferStatus.Received ? stepTotal : StockLabels.TransferProgress(slip.Status);
                var showSteps = slip.Status is TransferStatus.Requested or TransferStatus.Approved or TransferStatus.InTransit or TransferStatus.Received or TransferStatus.ReceivedWithDiscrepancy;
                var attention = Model.OpenTransferId == slip.Id && !string.IsNullOrEmpty(Model.ErrorMessage);
                <dialog id="transfer-@slip.Id" data-transfer-dialog class="w-[min(56rem,calc(100%-2rem))] max-h-[90vh] overflow-hidden rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/50">
                    <div class="flex max-h-[90vh] min-h-0 flex-col overflow-hidden">
                        <div class="flex shrink-0 items-start justify-between gap-3 border-b border-slate-100 p-5">
                            <div>
                                <div class="flex flex-wrap items-center gap-2">
                                    <h2 class="font-mono text-base font-bold text-slate-900">@slipCode</h2>
                                    <span class="rounded-full px-2 py-0.5 text-xs font-bold @StockLabels.TransferPillClass(slip.Status)">@StockLabels.TransferPill(slip.Status)</span>
                                </div>
                                <partial name="_AuditStamp" model="slip.Stamp" />
                            </div>
                            <button type="button" class="text-2xl leading-none text-slate-400" onclick="this.closest('dialog').close()" aria-label="Đóng">×</button>
                        </div>
                        <div class="min-h-0 flex-1 space-y-4 overflow-y-auto p-5">
                            @if (attention)
                            {
                                <p class="rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700" role="alert">@Model.ErrorMessage</p>
                            }

                            @if (showSteps)
                            {
                                <ol class="flex items-center gap-2 overflow-x-auto text-xs" aria-label="Tiến trình phiếu">
                                    @for (var step = 0; step < stepTotal; step++)
                                    {
                                        var done = step < stepsDone;
                                        var current = step == stepsDone;
                                        <li class="flex items-center gap-2 whitespace-nowrap">
                                            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full font-bold @(done ? "bg-emerald-600 text-white" : current ? "bg-sky-600 text-white ring-4 ring-sky-100" : "bg-slate-100 text-slate-400")">@(done ? "✓" : (step + 1).ToString())</span>
                                            <span class="font-semibold @(current ? "text-sky-700" : done ? "text-slate-800" : "text-slate-400")">@StockLabels.TransferSteps[step]</span>
                                            @if (step < stepTotal - 1)
                                            {
                                                <span class="h-px w-6 bg-slate-200"></span>
                                            }
                                        </li>
                                    }
                                </ol>
                            }
                            else if (slip.Status is TransferStatus.Rejected or TransferStatus.Cancelled or TransferStatus.Returned)
                            {
                                <p class="rounded-xl px-3 py-2 text-sm font-semibold @StockLabels.TransferPillClass(slip.Status)">@StockLabels.TransferPill(slip.Status)</p>
                            }

                            <div class="grid grid-cols-1 items-center gap-3 md:grid-cols-[1fr_auto_1fr]">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Kho xuất hàng</p>
                                    <p class="font-semibold text-slate-900">@slip.SourceName</p>
                                </div>
                                <div class="text-center text-xs font-semibold text-amber-600">@StockLabels.TransferLeg(slip.Status)</div>
                                <div class="md:text-right">
                                    <p class="text-xs font-bold uppercase tracking-wide text-slate-500">Nơi nhận</p>
                                    <p class="font-semibold text-slate-900">@slip.DestinationName</p>
                                </div>
                            </div>

                            <div class="overflow-x-auto">
                                <table class="w-full text-left text-sm">
                                    <thead class="text-xs uppercase tracking-wide text-slate-500">
                                        <tr>
                                            <th class="py-2 pr-3 font-semibold">Mã SKU</th>
                                            <th class="py-2 pr-3 font-semibold">Tên sản phẩm</th>
                                            <th class="py-2 pr-3 font-semibold">Số lượng chuyển</th>
                                            <th class="py-2 pr-3 font-semibold">Thực nhận</th>
                                            <th class="py-2 font-semibold">ĐVT</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in slip.Lines)
                                        {
                                            <tr class="border-t border-slate-100">
                                                <td class="py-2 pr-3 font-mono text-xs">@line.Code</td>
                                                <td class="py-2 pr-3">@line.Name</td>
                                                <td class="py-2 pr-3 font-semibold">@IndexModel.Count(line.Quantity)</td>
                                                <td class="py-2 pr-3 font-semibold @(line.ReceivedQuantity is int got && got != line.Quantity ? "text-rose-700" : "")">@(line.ReceivedQuantity is int received ? IndexModel.Count(received) : "—")</td>
                                                <td class="py-2">@(string.IsNullOrWhiteSpace(line.Unit) ? "—" : line.Unit)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(slip.Note))
                            {
                                <p class="text-sm text-slate-600">Lý do / ghi chú: @slip.Note</p>
                            }

                            @if (flow is not null)
                            {
                                if (!string.IsNullOrEmpty(flow.SealNumber) || !string.IsNullOrEmpty(flow.Carrier))
                                {
                                    <p class="text-sm text-slate-600">
                                        @if (!string.IsNullOrEmpty(flow.SealNumber)) { <span>Số seal: <span class="font-mono">@flow.SealNumber</span></span> }
                                        @if (!string.IsNullOrEmpty(flow.Carrier)) { <span class="ml-3">Vận chuyển: @flow.Carrier</span> }
                                    </p>
                                }

                                if (flow.Attachments.Count > 0)
                                {
                                    <ul class="flex flex-wrap gap-2 text-sm">
                                        @foreach (var file in flow.Attachments)
                                        {
                                            <li><a href="/inventory?handler=TransferFile&amp;id=@file.Id" class="inline-flex items-center rounded-lg border border-slate-200 px-3 py-1 text-sky-700 hover:bg-sky-50">@file.FileName</a></li>
                                        }
                                    </ul>
                                }

                                if (flow.CanAttach)
                                {
                                    <form method="post" asp-antiforgery="true" action="/inventory?handler=AttachTransferFile" enctype="multipart/form-data" class="flex flex-wrap items-center gap-2">
                                        <input type="hidden" name="DocumentId" value="@slip.Id" />
                                        <input type="hidden" name="view" value="transfers" />
                                        <input type="file" name="files" multiple accept="image/*,.pdf,.jpg,.jpeg,.png,.xlsx,.docx" class="text-xs text-slate-600" />
                                        <button type="submit" class="rounded-lg bg-slate-100 px-3 py-1.5 text-xs font-bold text-slate-700">Đính kèm file</button>
                                    </form>
                                }

                                <section aria-label="Lịch sử phiếu" class="rounded-xl border border-slate-200 p-4">
                                    <h3 class="text-sm font-bold text-slate-900">Lịch sử phiếu</h3>
                                    @if ((flow.History?.Count ?? 0) == 0)
                                    {
                                        <p class="mt-2 text-sm text-slate-500">Chưa có lịch sử.</p>
                                    }
                                    else
                                    {
                                        <ol class="mt-3 space-y-3 border-l-2 border-slate-100 pl-4">
                                            @foreach (var entry in flow.History!)
                                            {
                                                <li class="relative">
                                                    <span class="absolute -left-[1.4rem] top-1.5 h-2.5 w-2.5 rounded-full bg-sky-500"></span>
                                                    <p class="text-sm"><span class="font-semibold text-slate-900">@StockLabels.TransferEvent(entry.Kind)</span> <span class="text-slate-500">· @(string.IsNullOrEmpty(entry.ActorCode) ? "không rõ" : entry.ActorCode) · @entry.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></p>
                                                    @if (!string.IsNullOrWhiteSpace(entry.Note))
                                                    {
                                                        <p class="mt-0.5 text-sm text-slate-600">@entry.Note</p>
                                                    }
                                                </li>
                                            }
                                        </ol>
                                    }
                                </section>

                                if (flow.CanEdit)
                                {
                                    <details class="rounded-xl border border-slate-200 p-4">
                                        <summary class="cursor-pointer text-sm font-bold text-slate-700">Sửa phiếu đề nghị</summary>
                                        <form method="post" asp-antiforgery="true" action="/inventory?handler=UpdateTransfer" class="mt-3 space-y-3">
                                            <input type="hidden" name="DocumentId" value="@slip.Id" />
                                            <input type="hidden" name="view" value="transfers" />
                                            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                                                <label class="text-sm font-medium text-slate-700">Kho xuất
                                                    <select name="Transfer.SourceLocationId" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2">
                                                        @foreach (var place in Model.AllLocations)
                                                        {
                                                            <option value="@place.Id" selected="@(place.Id == slip.SourceId)">@place.Name</option>
                                                        }
                                                    </select>
                                                </label>
                                                <label class="text-sm font-medium text-slate-700">Nơi nhận
                                                    <select name="Transfer.DestinationLocationId" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2">
                                                        @foreach (var place in Model.AllLocations)
                                                        {
                                                            <option value="@place.Id" selected="@(place.Id == slip.DestinationId)">@place.Name</option>
                                                        }
                                                    </select>
                                                </label>
                                            </div>
                                            <p class="text-xs text-slate-500">Mỗi dòng một mặt hàng. Để trống mặt hàng hoặc số lượng 0 để bỏ dòng đó.</p>
                                            @for (var row = 0; row < slip.Lines.Count + 2; row++)
                                            {
                                                var current = row < slip.Lines.Count ? slip.Lines[row] : null;
                                                <div class="flex flex-wrap items-center gap-3">
                                                    <select name="Transfer.Lines[@row].CatalogItemId" class="min-w-[14rem] flex-1 rounded-xl border border-slate-200 px-3 py-2 text-sm">
                                                        <option value="@Guid.Empty">— Chọn mặt hàng —</option>
                                                        @foreach (var choice in Model.Items)
                                                        {
                                                            <option value="@choice.Id" selected="@(current is not null && current.CatalogItemId == choice.Id)">@choice.Code — @choice.Name</option>
                                                        }
                                                    </select>
                                                    <input type="number" min="0" name="Transfer.Lines[@row].Quantity" value="@(current?.Quantity.ToString() ?? "")" placeholder="Số lượng" class="w-28 rounded-xl border border-slate-200 px-3 py-2 text-sm" />
                                                </div>
                                            }
                                            <label class="block text-sm font-medium text-slate-700">Lý do / ghi chú
                                                <textarea name="Transfer.Note" rows="3" maxlength="500" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm">@slip.Note</textarea>
                                            </label>
                                            <div class="flex justify-end"><button type="submit" class="rounded-xl bg-sky-600 px-4 py-2 text-sm font-bold text-white">Lưu thay đổi</button></div>
                                        </form>
                                    </details>
                                }

                                if (flow.CanReceive)
                                {
                                    <form method="post" asp-antiforgery="true" action="/inventory?handler=ReceiveTransfer" enctype="multipart/form-data" data-confirm data-confirm-title="Xác nhận đã nhận hàng" data-confirm-message="Tồn kho nơi nhận sẽ tăng theo số thực nhận bạn nhập. Số liệu này không sửa lại được." class="space-y-3 rounded-xl border border-emerald-200 bg-emerald-50/40 p-4">
                                        <input type="hidden" name="DocumentId" value="@slip.Id" />
                                        <input type="hidden" name="view" value="transfers" />
                                        <h3 class="text-sm font-bold text-emerald-800">Kiểm nhận hàng</h3>
                                        <p class="text-xs text-slate-600">Đếm và nhập số thực nhận của từng mặt hàng, kể cả khi nhận đủ. Số thực nhận khác số xuất, thừa hay thiếu, đều bắt buộc có lý do và file đính kèm; hệ thống sẽ tự lập phiếu điều chỉnh ghi nhận phần chênh lệch.</p>
                                        @for (var index = 0; index < slip.Lines.Count; index++)
                                        {
                                            var line = slip.Lines[index];
                                            var echoed = attention && Model.EchoReceived.TryGetValue(line.LineId, out var echoedValue) ? echoedValue.ToString() : "";
                                            <div class="flex flex-wrap items-center gap-3 text-sm">
                                                <input type="hidden" name="receiveLines[@index].LineId" value="@line.LineId" />
                                                <span class="min-w-[12rem] flex-1">@line.Code · @line.Name <span class="text-slate-500">(xuất @IndexModel.Count(line.Quantity))</span></span>
                                                <input type="number" min="0" required name="receiveLines[@index].Quantity" value="@echoed" placeholder="Thực nhận" aria-label="Thực nhận @line.Code" class="w-28 rounded-lg border border-slate-300 px-3 py-1.5" />
                                            </div>
                                        }
                                        <label class="block text-sm">Lý do chênh lệch (bắt buộc nếu số nhận khác số xuất)
                                            <textarea name="receiveNote" maxlength="500" rows="3" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">@(attention ? Model.EchoReceiveNote : "")</textarea>
                                        </label>
                                        <label class="block text-sm">File đính kèm (ảnh hàng, biên bản)
                                            <input type="file" name="files" multiple accept="image/*,.pdf,.jpg,.jpeg,.png,.xlsx,.docx" class="mt-1 block text-xs" />
                                        </label>
                                        <div class="flex justify-end">
                                            <button type="submit" class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-bold text-white">Xác Nhận Đã Nhận Hàng &amp; Nhập Kho</button>
                                        </div>
                                    </form>
                                }

                                if (flow.CanResolve)
                                {
                                    <form method="post" asp-antiforgery="true" action="/inventory?handler=ResolveTransfer" data-confirm data-confirm-title="Xác nhận đã xử lý chênh lệch" data-confirm-message="Phiếu sẽ được đóng sau khi xác nhận." class="space-y-2 rounded-xl border border-amber-200 bg-amber-50/40 p-4">
                                        <input type="hidden" name="DocumentId" value="@slip.Id" />
                                        <input type="hidden" name="view" value="transfers" />
                                        <label class="block text-sm font-bold text-amber-900">Xử lý chênh lệch (Kế toán / Giám đốc)
                                            <textarea name="resolution" maxlength="500" rows="3" required class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 font-normal"></textarea>
                                        </label>
                                        <div class="flex justify-end"><button type="submit" class="rounded-xl bg-amber-600 px-4 py-2 text-sm font-bold text-white">Xác nhận đã xử lý</button></div>
                                    </form>
                                }

                                if (flow.CanDecide || flow.CanShip || flow.CanCancel || flow.CanReturn)
                                {
                                    <div class="flex flex-wrap items-start justify-end gap-2 border-t border-slate-100 pt-4">
                                        @if (flow.CanDecide)
                                        {
                                            <form method="post" asp-antiforgery="true" action="/inventory?handler=DecideTransfer" data-confirm class="flex flex-wrap gap-2">
                                                <input type="hidden" name="DocumentId" value="@slip.Id" />
                                                <input type="hidden" name="view" value="transfers" />
                                                <input type="hidden" name="reason" value="" />
                                                <button type="submit" name="approve" value="false" data-confirm-title="Từ chối phiếu @slipCode" data-confirm-message="Người lập phiếu sẽ được thông báo. Nhập lý do từ chối." data-reason="required" data-confirm-label="Từ chối" data-confirm-tone="danger" class="rounded-xl border border-rose-200 bg-white px-4 py-2 text-sm font-bold text-rose-700">Từ chối</button>
                                                <button type="submit" name="approve" value="true" data-confirm-title="Duyệt phiếu @slipCode" data-confirm-message="Hệ thống sẽ kiểm tồn khả dụng và giữ hàng ở @slip.SourceName cho tới khi xuất kho hoặc hủy phiếu." data-confirm-label="Duyệt" class="rounded-xl bg-sky-600 px-4 py-2 text-sm font-bold text-white">Duyệt</button>
                                            </form>
                                        }
                                        @if (flow.CanShip)
                                        {
                                            <form method="post" asp-antiforgery="true" action="/inventory?handler=ShipTransfer" data-confirm data-confirm-title="Xuất kho phiếu @slipCode" data-confirm-message="Tồn @slip.SourceName giảm ngay theo số lượng trên phiếu và hàng chuyển sang trạng thái đang vận chuyển." data-confirm-label="Xuất kho" class="flex flex-wrap items-center gap-2">
                                                <input type="hidden" name="DocumentId" value="@slip.Id" />
                                                <input type="hidden" name="view" value="transfers" />
                                                <input name="sealNumber" maxlength="100" placeholder="Số seal niêm phong" class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm" />
                                                <input name="carrier" maxlength="200" placeholder="Người vận chuyển (ghi chú)" class="rounded-lg border border-slate-200 px-3 py-1.5 text-sm" />
                                                <button type="submit" class="rounded-xl bg-sky-600 px-4 py-2 text-sm font-bold text-white">Xuất kho</button>
                                            </form>
                                        }
                                        @if (flow.CanReturn)
                                        {
                                            <form method="post" asp-antiforgery="true" action="/inventory?handler=ReturnTransfer" data-confirm data-confirm-title="Trả hàng về kho xuất" data-confirm-message="Hàng đang vận chuyển sẽ được hoàn về tồn của @slip.SourceName và phiếu đóng lại. Nhập lý do trả hàng." data-reason="required" data-confirm-label="Trả hàng" data-confirm-tone="danger">
                                                <input type="hidden" name="DocumentId" value="@slip.Id" />
                                                <input type="hidden" name="view" value="transfers" />
                                                <input type="hidden" name="reason" value="" />
                                                <button type="submit" class="rounded-xl border border-violet-200 bg-white px-4 py-2 text-sm font-bold text-violet-700">Trả về kho xuất</button>
                                            </form>
                                        }
                                        @if (flow.CanCancel)
                                        {
                                            <form method="post" asp-antiforgery="true" action="/inventory?handler=CancelTransfer" data-confirm data-confirm-title="Hủy phiếu @slipCode" data-confirm-message="Phiếu sẽ đóng lại và phần hàng đang giữ (nếu đã duyệt) được nhả. Nhập lý do hủy." data-reason="required" data-confirm-label="Hủy phiếu" data-confirm-tone="danger">
                                                <input type="hidden" name="DocumentId" value="@slip.Id" />
                                                <input type="hidden" name="view" value="transfers" />
                                                <input type="hidden" name="reason" value="" />
                                                <button type="submit" class="rounded-xl border border-rose-200 bg-white px-4 py-2 text-sm font-bold text-rose-700">Hủy phiếu</button>
                                            </form>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </dialog>
            }
        </section>
    }
    else
    {
        <section class="space-y-4">
            <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5 flex flex-col gap-3 sm:flex-row sm:items-center">
                <div>
                    <h2 class="font-display text-lg font-bold text-slate-900">Kiểm Kê Kho Định Kỳ &amp; Cân Đối Tồn Kho</h2>
                    <p class="mt-1 text-sm text-slate-500">Ghi nhận chênh lệch giữa số đếm thực tế và số sách. Phiếu của Thủ kho và Trưởng kho chờ duyệt; Admin, Giám đốc, Kế toán ghi thẳng.</p>
                </div>
                <div class="sm:ml-auto flex flex-wrap gap-2">
                    @if (Model.CanCountStock)
                    {
                        <button id="open-stocktake" type="button" class="inline-flex items-center rounded-xl bg-violet-600 px-4 py-2 text-sm font-bold text-white" onclick="document.getElementById('stocktake-dialog').showModal()">+ Lập Biên Bản Kiểm Kê</button>
                    }
                    @if (Model.CanDraftAdjustment || Model.CanPostAdjustment)
                    {
                        <button type="button" class="inline-flex items-center rounded-xl bg-slate-900 px-4 py-2 text-sm font-bold text-white" onclick="document.getElementById('adjustment-dialog').showModal()">+ Phiếu điều chỉnh</button>
                    }
                    <button type="button" class="inline-flex items-center rounded-xl bg-rose-600 px-4 py-2 text-sm font-bold text-white" onclick="document.getElementById('disposal-dialog').showModal()">+ Phiếu hủy</button>
                </div>
            </div>
            @if (Model.Stocktakes.Count == 0)
            {
                <partial name="_EmptyState" model='new EmptyStateModel("Chưa có biên bản kiểm kê.", "Biên bản kiểm kê và phiếu điều chỉnh sẽ hiện ở đây.")' />
            }
            @foreach (var sheet in Model.Stocktakes)
            {
                var when = IndexModel.When(sheet.Id);
                <article id="document-@sheet.Id" class="bg-white rounded-2xl border border-slate-200 shadow-sm p-5">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="font-mono text-sm font-bold">@StockLabels.DocumentCode("KK", sheet.Id)</span>
                        <span class="text-sm text-slate-600">@sheet.LocationName</span>
                        <span class="rounded-full px-2 py-0.5 text-xs font-bold @(sheet.Status == ApprovalStatus.Approved ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">@StockLabels.StocktakePill(sheet.Status)</span>
                        @if (!string.IsNullOrEmpty(when))
                        {
                            <span class="ml-auto text-xs text-slate-500">@when</span>
                        }
                    </div>
                    <div class="mt-1"><partial name="_AuditStamp" model="sheet.Stamp" /></div>
                    <div class="mt-4 overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="text-xs uppercase tracking-wide text-slate-500">
                                <tr>
                                    <th class="py-2 pr-3 font-semibold">Mã SKU</th>
                                    <th class="py-2 pr-3 font-semibold">Tên sản phẩm</th>
                                    <th class="py-2 pr-3 font-semibold">ĐVT</th>
                                    <th class="py-2 pr-3 font-semibold">Tồn sổ sách</th>
                                    <th class="py-2 pr-3 font-semibold">Tồn thực đếm</th>
                                    <th class="py-2 pr-3 font-semibold">Chênh lệch</th>
                                    <th class="py-2 font-semibold">Lý do chênh lệch</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="border-t border-slate-100">
                                    <td class="py-2 pr-3 font-mono text-xs">@sheet.Code</td>
                                    <td class="py-2 pr-3">@sheet.Name</td>
                                    <td class="py-2 pr-3">@(string.IsNullOrWhiteSpace(sheet.Unit) ? "—" : sheet.Unit)</td>
                                    <td class="py-2 pr-3">@IndexModel.Count(sheet.BookQuantity)</td>
                                    <td class="py-2 pr-3 font-semibold">@IndexModel.Count(sheet.CountedQuantity)</td>
                                    <td class="py-2 pr-3 font-semibold @(sheet.Variance < 0 ? "text-rose-600" : "text-slate-800")">@IndexModel.Count(sheet.Variance)</td>
                                    <td class="py-2">@sheet.Reason</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(sheet.DocumentRef))
                    {
                        <p class="mt-3 text-sm text-slate-600">Chứng từ: @sheet.DocumentRef</p>
                    }
                    @if (sheet.Status == ApprovalStatus.Pending && sheet.CanApprove)
                    {
                        <form method="post" asp-antiforgery="true" action="/inventory?handler=ApproveStocktake" class="mt-4 flex justify-end">
                            <input type="hidden" name="DocumentId" value="@sheet.Id" />
                            <button type="submit" class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-bold text-white">Duyệt biên bản</button>
                        </form>
                    }
                </article>
            }

            @if (Model.Adjustments.Count > 0)
            {
                <h3 class="font-display text-base font-bold text-slate-900">Điều chỉnh số lượng</h3>
                @foreach (var sheet in Model.Adjustments)
                {
                    <article id="document-@sheet.Id" class="bg-white rounded-2xl border border-slate-200 p-4 text-sm">
                        <p class="font-semibold">@sheet.Code — @sheet.Name <span class="font-normal text-slate-500">@sheet.LocationName</span></p>
                        <p class="mt-1 text-slate-600">Chênh lệch @sheet.Delta. @sheet.Reason. @StockLabels.Approval(sheet.Status)</p>
                        @if (sheet.TransferSlipId is Guid fromTransfer)
                        {
                            <p class="mt-1 text-xs text-slate-500">Ghi nhận tự động khi nhận hàng chuyển kho <a class="font-mono font-semibold text-sky-700" href="/inventory?view=transfers&open=@fromTransfer">@StockLabels.DocumentCode("CK", fromTransfer)</a>. Tồn kho đã đúng số thực nhận, phiếu này không cộng trừ thêm.</p>
                        }
                        <partial name="_AuditStamp" model="sheet.Stamp" />
                        @if (sheet.Status == ApprovalStatus.Pending && sheet.CanApprove)
                        {
                            <form method="post" asp-antiforgery="true" action="/inventory?handler=ApproveAdjustment" class="mt-3">
                                <input type="hidden" name="DocumentId" value="@sheet.Id" />
                                <button type="submit" class="rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-bold text-white">Duyệt điều chỉnh</button>
                            </form>
                        }
                    </article>
                }
            }
            @if (Model.Disposals.Count > 0)
            {
                <h3 class="font-display text-base font-bold text-slate-900">Phiếu hủy</h3>
                @foreach (var slip in Model.Disposals)
                {
                    <article id="document-@slip.Id" class="bg-white rounded-2xl border border-slate-200 p-4 text-sm">
                        <p class="font-semibold">@slip.Code — @slip.Name <span class="font-normal text-slate-500">@slip.LocationName</span></p>
                        <p class="mt-1 text-slate-600">@slip.Reason. @StockLabels.Approval(slip.Status)</p>
                        <partial name="_AuditStamp" model="slip.Stamp" />
                        @if (slip.Status == ApprovalStatus.Pending && slip.CanApprove)
                        {
                            <form method="post" asp-antiforgery="true" action="/inventory?handler=ApproveDisposal" class="mt-3">
                                <input type="hidden" name="DocumentId" value="@slip.Id" />
                                <button type="submit" class="rounded-lg bg-slate-900 px-3 py-1.5 text-xs font-bold text-white">Duyệt hủy</button>
                            </form>
                        }
                    </article>
                }
            }
        </section>
    }
</div>

<dialog id="transfer-dialog" class="w-[min(42rem,calc(100%-2rem))] max-h-[90vh] overflow-hidden rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/50">
    <form method="post" asp-antiforgery="true" action="/inventory?handler=RequestTransfer" class="flex max-h-[90vh] min-h-0 flex-col overflow-hidden">
        <div class="flex shrink-0 items-start justify-between gap-3 border-b border-slate-100 p-5">
            <div>
                <h2 class="font-display text-lg font-bold">Tạo Phiếu Đề Nghị Chuyển Kho</h2>
                <p class="mt-1 text-xs text-slate-500">Chọn kho nào cũng được, miễn kho xuất hoặc nơi nhận là kho/showroom của bạn. Phiếu chờ duyệt, chưa trừ tồn.</p>
            </div>
            <button type="button" class="text-2xl leading-none text-slate-400" onclick="this.closest('dialog').close()" aria-label="Đóng">×</button>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto p-5">
            @if (Model.ShowTransferDialog && !string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p class="mb-4 rounded-xl border border-rose-200 bg-rose-50 px-3 py-2 text-sm font-medium text-rose-700" role="alert">@Model.ErrorMessage</p>
            }
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                <label class="text-sm font-medium text-slate-700">Kho xuất
                    <select id="transfer-source" name="Transfer.SourceLocationId" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2">
                        <option value="">Chọn kho xuất</option>
                        @foreach (var location in Model.AllLocations)
                        {
                            <option value="@location.Id" selected="@(location.Id == Model.Transfer.SourceLocationId)">@location.Name</option>
                        }
                    </select>
                </label>
                <label class="text-sm font-medium text-slate-700">Nơi nhận (kho / showroom)
                    <select name="Transfer.DestinationLocationId" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2">
                        <option value="">Chọn nơi nhận</option>
                        @foreach (var location in Model.AllLocations)
                        {
                            <option value="@location.Id" selected="@(location.Id == Model.Transfer.DestinationLocationId)">@location.Name</option>
                        }
                    </select>
                </label>
            </div>
            <div class="mt-4 flex items-center justify-between">
                <p class="text-sm font-semibold text-slate-800">Danh sách thiết bị chuyển</p>
                <button id="add-transfer-line" type="button" class="text-sm font-semibold text-sky-700">+ Thêm mặt hàng</button>
            </div>
            <datalist id="transfer-items">
                @foreach (var item in Model.Items)
                {
                    <option value="@item.Code — @item.Name" data-id="@item.Id"></option>
                }
            </datalist>
            <div id="transfer-lines" class="mt-2 space-y-3">
                @for (var index = 0; index < Model.Transfer.Lines.Count; index++)
                {
                    var chosen = Model.Items.FirstOrDefault(item => item.Id == Model.Transfer.Lines[index].CatalogItemId);
                    <div class="transfer-line grid grid-cols-1 gap-1 md:grid-cols-[1fr_8rem] md:gap-x-2">
                        <input type="text" list="transfer-items" autocomplete="off" value="@(chosen is null ? "" : chosen.Code + " — " + chosen.Name)" placeholder="Gõ mã SKU hoặc tên để tìm..." aria-label="Mặt hàng" class="transfer-item-search rounded-xl border border-slate-200 px-3 py-2 text-sm" />
                        <input type="hidden" class="transfer-item" name="Transfer.Lines[@index].CatalogItemId" value="@(chosen?.Id.ToString() ?? "")" />
                        <input name="Transfer.Lines[@index].Quantity" type="number" min="1" value="@(Model.Transfer.Lines[index].Quantity == 0 ? "" : Model.Transfer.Lines[index].Quantity)" placeholder="Số lượng" aria-label="Số lượng" class="transfer-qty rounded-xl border border-slate-200 px-3 py-2 text-sm" />
                        <p class="transfer-stock text-xs text-slate-500 md:col-span-2"></p>
                    </div>
                }
            </div>
            <label class="mt-4 block text-sm font-medium text-slate-700">Lý do / ghi chú
                <textarea name="Transfer.Note" rows="3" maxlength="500" class="mt-1 w-full rounded-xl border border-slate-200 px-3 py-2 text-sm" placeholder="Ví dụ: chuyển mẫu trưng bày hoặc bù tồn kho.">@Model.Transfer.Note</textarea>
            </label>
        </div>
        <div class="flex shrink-0 justify-end gap-2 border-t border-slate-100 p-4">
            <button type="button" class="rounded-xl bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700" onclick="this.closest('dialog').close()">Hủy bỏ</button>
            <button type="submit" class="rounded-xl bg-sky-600 px-4 py-2 text-sm font-bold text-white">Gửi Đề Nghị Chuyển Kho</button>
        </div>
    </form>
</dialog>

<dialog id="confirm-dialog" class="w-[min(30rem,calc(100%-2rem))] overflow-hidden rounded-2xl p-0 shadow-2xl backdrop:bg-slate-900/60">
    <div class="flex max-h-[90vh] min-h-0 flex-col overflow-hidden">
        <div class="flex shrink-0 items-start justify-between gap-3 border-b border-slate-100 p-5">
            <h2 id="confirm-title" class="font-display text-lg font-bold text-slate-900">Xác nhận</h2>
