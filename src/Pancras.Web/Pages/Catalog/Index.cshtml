@page "/catalog"
@model Pancras.Web.Pages.Catalog.IndexModel
@using Pancras.Application.Catalog
@using Pancras.Web.Catalog
@using Pancras.Web.Formatting
@{
    ViewData["Title"] = "Danh mục sản phẩm và giá";
    var inputClass = Pancras.Web.Formatting.UiClasses.Input;
    var fieldClass = "w-full px-3 py-2.5 text-sm rounded-lg border border-slate-200 bg-white text-slate-800 outline-none focus:border-sky-500 focus:ring-2 focus:ring-sky-100";
    var labelClass = Pancras.Web.Formatting.UiClasses.Label;
}

<section class="bg-white rounded-xl border border-slate-200 p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <h1 class="font-display text-xl sm:text-2xl font-bold text-slate-900">Danh mục sản phẩm và giá</h1>
            <p class="mt-1 text-sm text-slate-500"><span class="font-mono tabular-nums">@Model.ItemPage.TotalCount</span> mặt hàng</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="@Model.ExportUrl" class="px-4 py-2 text-sm font-bold rounded-lg bg-emerald-50 text-emerald-700">Xuất CSV</a>
            <a href="@Model.AddUrl" class="rounded-lg px-4 py-2 text-sm font-bold bg-sky-600 text-white hover:bg-sky-700 disabled:opacity-60">Thêm sản phẩm</a>
        </div>
    </div>
    <form method="get" action="/catalog" data-live-filter class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-[14rem_12rem_1fr] sm:items-end">
        <div>
            <label class="block text-sm font-medium text-slate-600" for="catalog-category">Ngành</label>
            <select id="catalog-category" name="category" class="@inputClass">
                @if (string.IsNullOrEmpty(Model.CategoryToken))
                {
                    <option value="" selected>Tất cả</option>
                }
                else
                {
                    <option value="">Tất cả</option>
                }
                @if (Model.CategoryToken == ProductCategoryToken.Sanitary)
                {
                    <option value="@ProductCategoryToken.Sanitary" selected>Thiết bị vệ sinh</option>
                }
                else
                {
                    <option value="@ProductCategoryToken.Sanitary">Thiết bị vệ sinh</option>
                }
                @if (Model.CategoryToken == ProductCategoryToken.Bathroom)
                {
                    <option value="@ProductCategoryToken.Bathroom" selected>Nội thất phòng tắm</option>
                }
                else
                {
                    <option value="@ProductCategoryToken.Bathroom">Nội thất phòng tắm</option>
                }
                @if (Model.CategoryToken == ProductCategoryToken.Building)
                {
                    <option value="@ProductCategoryToken.Building" selected>Vật tư xây dựng</option>
                }
                else
                {
                    <option value="@ProductCategoryToken.Building">Vật tư xây dựng</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-600" for="catalog-status">Trạng thái</label>
            <select id="catalog-status" name="status" class="@inputClass">
                <option value="" selected="@(Model.StatusFilter == CatalogStatusFilter.Active)">Active</option>
                <option value="disabled" selected="@(Model.StatusFilter == CatalogStatusFilter.Disabled)">Disabled</option>
                <option value="all" selected="@(Model.StatusFilter == CatalogStatusFilter.All)">Tất cả</option>
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-slate-600" for="catalog-search">Tìm kiếm</label>
            <input id="catalog-search" name="q" value="@Model.Search" type="search" placeholder="Tìm theo mã, tên hoặc thương hiệu..." class="@inputClass" />
        </div>
    </form>
    @if (Model.ErrorMessages.Count > 0 && !Model.ShowForm && !Model.ShowPriceForm)
    {
        <div class="mt-4"><partial name="_Notice" model="new NoticeModel(Model.ErrorTitle, ToastLevel.Error, Model.ErrorMessages)" /></div>
    }
</section>

<div id="live-results">
@if (Model.Rows.Count == 0)
{
    <partial name="_EmptyState" model='Model.HasFilter ? new EmptyStateModel("Không có mặt hàng khớp bộ lọc.", "Thử đổi ngành hoặc từ khóa tìm kiếm.", "Bỏ lọc", "/catalog") : new EmptyStateModel("Chưa có mặt hàng.", "Thêm sản phẩm đầu tiên để bắt đầu quản lý giá và tồn kho.", "Thêm sản phẩm", Model.AddUrl)' />
}
else
{
    <div class="mt-4 max-w-full overflow-x-auto rounded-xl border border-slate-200 bg-white">
        <table class="min-w-full whitespace-nowrap text-xs">
            <thead class="bg-slate-50 text-left text-slate-500">
                <tr>
                    <th class="sticky left-0 z-10 bg-slate-50 px-3 py-3 font-medium"><partial name="_SortHeader" model='new SortHeaderModel("Mã", Model.SortUrl("code"), Model.Sort.Key == "code", Model.Sort.Descending)' /></th>
                    <th class="px-3 py-3 font-medium"></th>
                    <th class="px-3 py-3 font-medium">Ảnh</th>
                    <th class="px-3 py-3 font-medium"><partial name="_SortHeader" model='new SortHeaderModel("Tên", Model.SortUrl("name"), Model.Sort.Key == "name", Model.Sort.Descending)' /></th>
                    <th class="px-3 py-3 font-medium">Ngành</th>
                    <th class="px-3 py-3 font-medium"><partial name="_SortHeader" model='new SortHeaderModel("Thương hiệu", Model.SortUrl("brand"), Model.Sort.Key == "brand", Model.Sort.Descending)' /></th>
                    <th class="px-3 py-3 font-medium">Đơn vị</th>
                    <th class="px-3 py-3 font-medium text-right">Giá vốn</th>
                    <th class="px-3 py-3 font-medium text-right">Giá lẻ</th>
                    <th class="px-3 py-3 font-medium text-right">Giá đại lý</th>
                    <th class="px-3 py-3 font-medium text-right">Giá nhà phân phối</th>
                    <th class="px-3 py-3 font-medium text-right">Giá dự án</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr class="group border-t border-slate-100 hover:bg-slate-50">
                        <td class="sticky left-0 z-10 bg-white px-3 py-3 font-mono text-slate-700 group-hover:bg-slate-50">@row.Code</td>
                        <td class="px-3 py-3 text-right whitespace-nowrap">
                            <a href="@Model.DetailUrl(row.Id)" class="rounded-lg px-3 py-1.5 text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:opacity-60">Chi tiết</a>
                            <a href="@Model.PriceUrl(row.Id)" class="ml-2 rounded-lg px-3 py-1.5 text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:opacity-60">Sửa</a>
                            @if (Model.CanDisable)
                            {
                                <form method="post" asp-page-handler="SetActive" class="inline" data-confirm data-confirm-title="@(row.IsActive ? "Disable mặt hàng" : "Active mặt hàng")" data-confirm-message="@(row.IsActive ? "Disable mặt hàng này? Mặt hàng sẽ không còn hiện trong danh sách chọn (đơn mua, phiếu kho); lịch sử vẫn được giữ." : "Active lại mặt hàng này?")" data-confirm-label="@(row.IsActive ? "Disable" : "Active")" data-confirm-tone="@(row.IsActive ? "danger" : "")">
                                    <input type="hidden" name="id" value="@row.Id" />
                                    <input type="hidden" name="active" value="@(row.IsActive ? "false" : "true")" />
                                    <input type="hidden" name="version" value="@row.Version" />
                                    <button type="submit" class="ml-2 px-3 py-1.5 text-xs font-bold rounded-lg @(row.IsActive ? "text-rose-700 hover:bg-rose-50" : "text-emerald-700 hover:bg-emerald-50")">@(row.IsActive ? "Disable" : "Active")</button>
                                </form>
                            }
                        </td>
                        <td class="px-3 py-3">
                            @{
                                var imageUrl = CatalogImageStore.PublicUrl(row.ImagePath);
                            }
                            @if (imageUrl is null)
                            {
                                <span class="inline-flex h-12 w-12 items-center justify-center rounded-lg bg-slate-100 text-slate-400">—</span>
                            }
                            else
                            {
                                <img src="@imageUrl" alt="@row.Name" class="h-12 w-12 rounded-lg object-cover" />
                            }
                        </td>
                        <td class="px-3 py-3 font-medium text-slate-900">@row.Name@if (!row.IsActive) { <span class="ml-2 @Badge.Classes(BadgeTone.Neutral)">Disabled</span> }<partial name="_AuditStamp" model="row.Stamp" /></td>
                        <td class="px-3 py-3 text-slate-700">@CatalogLabels.Category(row.Category)</td>
                        <td class="px-3 py-3 text-slate-700">@CatalogLabels.Text(row.Brand)</td>
                        <td class="px-3 py-3 text-slate-700">@CatalogLabels.Text(row.Unit)</td>
                        <td class="px-3 py-3 text-right font-mono tabular-nums text-slate-800">@VndMoney.FormatDong(row.CostPrice)</td>
                        <td class="px-3 py-3 text-right font-mono tabular-nums text-slate-800">@VndMoney.FormatDong(row.RetailPrice)</td>
                        <td class="px-3 py-3 text-right font-mono tabular-nums text-slate-800">@VndMoney.FormatDong(row.DealerPrice)</td>
                        <td class="px-3 py-3 text-right font-mono tabular-nums text-slate-800">@VndMoney.FormatDong(row.DistributorPrice)</td>
                        <td class="px-3 py-3 text-right font-mono tabular-nums text-slate-800">@VndMoney.FormatDong(row.ProjectPrice)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
}
</div>

@if (Model.ShowForm)
{
<dialog id="catalog-dialog" data-autoshow class="m-auto !flex w-[min(56rem,calc(100%-2rem))] max-h-[calc(100%-2rem)] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/50">
    <div class="flex shrink-0 items-center justify-between gap-3 px-6 pt-6 sm:px-8">
            <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-sky-600">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12" />
                    </svg>
                </span>
                <h2 class="text-base font-semibold text-slate-900">Thêm sản phẩm vào danh mục</h2>
            </div>
            <a href="@Model.FilteredListUrl" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600" aria-label="Đóng">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
                </svg>
            </a>
    </div>
        <form method="post" enctype="multipart/form-data" asp-page-handler="Create" class="min-h-0 flex-1 overflow-y-auto px-6 pb-6 pt-4 sm:px-8">
            <input type="hidden" name="q" value="@Model.Search" />
            <input type="hidden" name="category" value="@Model.CategoryToken" />
            <input type="hidden" name="page" value="@Model.ItemPage.PageNumber" />
            <partial name="_ListState" model="(Model.RequestedSize, Model.SortToken)" />
            @if (Model.ShowForm && Model.ErrorMessages.Count > 0)
            {
                <div class="mb-4"><partial name="_Notice" model="new NoticeModel(Model.ErrorTitle, ToastLevel.Error, Model.ErrorMessages)" /></div>
            }
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div>
                    <label class="@labelClass" for="Form_Code">Mã SKU</label>
                    <input asp-for="Form.Code" id="Form_Code" maxlength="32" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Form_Brand">Thương hiệu</label>
                    <input asp-for="Form.Brand" id="Form_Brand" maxlength="100" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Form_Unit">Đơn vị tính</label>
                    <input asp-for="Form.Unit" id="Form_Unit" maxlength="32" class="@fieldClass" />
                </div>
            </div>
            <div class="mt-4">
                <label class="@labelClass" for="Form_Name">Tên sản phẩm</label>
                <input asp-for="Form.Name" id="Form_Name" maxlength="200" class="@fieldClass" />
            </div>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div>
                    <label class="@labelClass" for="Form_Category">Danh mục</label>
                    <select asp-for="Form.Category" id="Form_Category" class="@fieldClass">
                        @if (Model.Form.Category == ProductCategoryToken.Sanitary)
                        {
                            <option value="@ProductCategoryToken.Sanitary" selected>Thiết bị vệ sinh</option>
                        }
                        else
                        {
                            <option value="@ProductCategoryToken.Sanitary">Thiết bị vệ sinh</option>
                        }
                        @if (Model.Form.Category == ProductCategoryToken.Bathroom)
                        {
                            <option value="@ProductCategoryToken.Bathroom" selected>Nội thất phòng tắm</option>
                        }
                        else
                        {
                            <option value="@ProductCategoryToken.Bathroom">Nội thất phòng tắm</option>
                        }
                        @if (Model.Form.Category == ProductCategoryToken.Building)
                        {
                            <option value="@ProductCategoryToken.Building" selected>Vật tư xây dựng</option>
                        }
                        else
                        {
                            <option value="@ProductCategoryToken.Building">Vật tư xây dựng</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="@labelClass" for="Form_Origin">Xuất xứ</label>
                    <input asp-for="Form.Origin" id="Form_Origin" maxlength="100" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Form_WarrantyMonths">Bảo hành (tháng)</label>
                    <input asp-for="Form.WarrantyMonths" id="Form_WarrantyMonths" inputmode="numeric" class="@fieldClass" />
                </div>
            </div>
            <p class="mt-4 text-xs font-medium text-slate-500">@CatalogLabels.PricesIncludeVat</p>
            <div class="mt-2 grid grid-cols-2 gap-4 lg:grid-cols-5">
                <div>
                    <label class="@labelClass" for="Form_CostPrice">Giá vốn (VNĐ)</label>
                    <input asp-for="Form.CostPrice" id="Form_CostPrice" data-vnd="true" inputmode="decimal" class="@fieldClass font-mono tabular-nums" />
                </div>
                <div>
                    <label class="@labelClass" for="Form_RetailPrice">Giá lẻ (VNĐ)</label>
                    <input asp-for="Form.RetailPrice" id="Form_RetailPrice" data-vnd="true" inputmode="decimal" class="@fieldClass font-mono tabular-nums" />
                </div>
                <div>
                    <label class="@labelClass" for="Form_DealerPrice">Giá đại lý (VNĐ)</label>
                    <input asp-for="Form.DealerPrice" id="Form_DealerPrice" data-vnd="true" inputmode="decimal" class="@fieldClass font-mono tabular-nums" />
                </div>
                <div>
                    <label class="@labelClass" for="Form_DistributorPrice">Giá nhà phân phối (VNĐ)</label>
                    <input asp-for="Form.DistributorPrice" id="Form_DistributorPrice" data-vnd="true" inputmode="decimal" class="@fieldClass font-mono tabular-nums" />
                </div>
                <div>
                    <label class="@labelClass" for="Form_ProjectPrice">Giá dự án (VNĐ)</label>
                    <input asp-for="Form.ProjectPrice" id="Form_ProjectPrice" data-vnd="true" inputmode="decimal" class="@fieldClass font-mono tabular-nums" />
                </div>
            </div>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div>
                    <label class="@labelClass" for="Form_WeightKg">Khối lượng (kg)</label>
                    <input asp-for="Form.WeightKg" id="Form_WeightKg" inputmode="decimal" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Form_VolumeM3">Thể tích (m³)</label>
                    <input asp-for="Form.VolumeM3" id="Form_VolumeM3" inputmode="decimal" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Form_MinimumStock">Định mức tồn tối thiểu</label>
                    <input asp-for="Form.MinimumStock" id="Form_MinimumStock" inputmode="decimal" class="@fieldClass" />
                </div>
            </div>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div>
                    <label class="@labelClass" for="Form_HeightMm">Chiều cao (mm)</label>
                    <input asp-for="Form.HeightMm" id="Form_HeightMm" inputmode="numeric" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Form_LengthMm">Chiều dài (mm)</label>
                    <input asp-for="Form.LengthMm" id="Form_LengthMm" inputmode="numeric" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Form_WidthMm">Chiều rộng (mm)</label>
                    <input asp-for="Form.WidthMm" id="Form_WidthMm" inputmode="numeric" class="@fieldClass" />
                </div>
            </div>
            <div class="mt-4">
                <label class="@labelClass" for="Form_Image">Ảnh sản phẩm</label>
                <input id="Form_Image" name="Image" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="block w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-sky-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-sky-700" />
                <p class="mt-1 text-xs text-slate-500">JPG, PNG, WEBP hoặc GIF, tối đa 5 MB.</p>
            </div>
            <div class="mt-6 flex justify-end gap-3 border-t border-slate-100 pt-4">
                <a href="@Model.FilteredListUrl" class="rounded-lg px-4 py-2 text-sm font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:opacity-60">Quay lại</a>
                <button type="submit" class="rounded-lg px-4 py-2 text-sm font-bold bg-sky-600 text-white hover:bg-sky-700 disabled:opacity-60">Lưu sản phẩm</button>
            </div>
        </form>
</dialog>
}

@if (Model.ShowPriceForm)
{
<dialog id="catalog-price-dialog" data-autoshow class="m-auto !flex w-[min(56rem,calc(100%-2rem))] max-h-[calc(100%-2rem)] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/50">
    <div class="flex shrink-0 items-center justify-between gap-3 px-6 pt-6 sm:px-8">
            <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-sky-600">
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.27 6.96 12 12.01l8.73-5.05M12 22.08V12" />
                    </svg>
                </span>
                <h2 class="text-base font-semibold text-slate-900">Sửa sản phẩm</h2>
            </div>
            <a href="@Model.FilteredListUrl" class="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 hover:text-slate-600" aria-label="Đóng">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
                </svg>
            </a>
    </div>
        <form method="post" enctype="multipart/form-data" asp-page-handler="UpdatePrices" class="min-h-0 flex-1 overflow-y-auto px-6 pb-6 pt-4 sm:px-8">
            <input type="hidden" asp-for="Prices.Id" />
            <input type="hidden" asp-for="Prices.IncludeDetails" />
            <input type="hidden" asp-for="Prices.Version" />
            <input type="hidden" name="q" value="@Model.Search" />
            <input type="hidden" name="category" value="@Model.CategoryToken" />
            <input type="hidden" name="page" value="@Model.ItemPage.PageNumber" />
            <partial name="_ListState" model="(Model.RequestedSize, Model.SortToken)" />
            @if (Model.ShowPriceForm && Model.ErrorMessages.Count > 0)
            {
                <div class="mb-4"><partial name="_Notice" model="new NoticeModel(Model.ErrorTitle, ToastLevel.Error, Model.ErrorMessages)" /></div>
            }
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div>
                    <label class="@labelClass" for="Prices_Code">Mã SKU</label>
                    <input asp-for="Prices.Code" id="Prices_Code" maxlength="32" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Prices_Brand">Thương hiệu</label>
                    <input asp-for="Prices.Brand" id="Prices_Brand" maxlength="100" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Prices_Unit">Đơn vị tính</label>
                    <input asp-for="Prices.Unit" id="Prices_Unit" maxlength="32" class="@fieldClass" />
                </div>
            </div>
            <div class="mt-4">
                <label class="@labelClass" for="Prices_Name">Tên sản phẩm</label>
                <input asp-for="Prices.Name" id="Prices_Name" maxlength="200" class="@fieldClass" />
            </div>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div>
                    <label class="@labelClass" for="Prices_Category">Danh mục</label>
                    <select asp-for="Prices.Category" id="Prices_Category" class="@fieldClass">
                        @if (Model.Prices.Category == ProductCategoryToken.Sanitary)
                        {
                            <option value="@ProductCategoryToken.Sanitary" selected>Thiết bị vệ sinh</option>
                        }
                        else
                        {
                            <option value="@ProductCategoryToken.Sanitary">Thiết bị vệ sinh</option>
                        }
                        @if (Model.Prices.Category == ProductCategoryToken.Bathroom)
                        {
                            <option value="@ProductCategoryToken.Bathroom" selected>Nội thất phòng tắm</option>
                        }
                        else
                        {
                            <option value="@ProductCategoryToken.Bathroom">Nội thất phòng tắm</option>
                        }
                        @if (Model.Prices.Category == ProductCategoryToken.Building)
                        {
                            <option value="@ProductCategoryToken.Building" selected>Vật tư xây dựng</option>
                        }
                        else
                        {
                            <option value="@ProductCategoryToken.Building">Vật tư xây dựng</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="@labelClass" for="Prices_Origin">Xuất xứ</label>
                    <input asp-for="Prices.Origin" id="Prices_Origin" maxlength="100" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Prices_WarrantyMonths">Bảo hành (tháng)</label>
                    <input asp-for="Prices.WarrantyMonths" id="Prices_WarrantyMonths" inputmode="numeric" class="@fieldClass" />
                </div>
            </div>
            <p class="mt-4 text-xs font-medium text-slate-500">@CatalogLabels.PricesIncludeVat</p>
            <div class="mt-2 grid grid-cols-2 gap-4 lg:grid-cols-5">
                <div>
                    <label class="@labelClass" for="Prices_CostPrice">Giá vốn (VNĐ)</label>
                    @if (Model.CostLocked)
                    {
                        <input id="Prices_CostPrice" value="@Model.Prices.CostPrice" disabled class="@fieldClass bg-slate-50 font-mono tabular-nums text-slate-500" />
                        <input type="hidden" asp-for="Prices.CostPrice" />
                        <p class="mt-1 text-xs text-slate-500">Giá vốn không sửa được khi mặt hàng đã có tồn. Giá vốn cập nhật theo nhập kho.</p>
                    }
                    else
                    {
                        <input asp-for="Prices.CostPrice" id="Prices_CostPrice" data-vnd="true" inputmode="decimal" class="@fieldClass font-mono tabular-nums" />
                    }
                </div>
                <div>
                    <label class="@labelClass" for="Prices_RetailPrice">Giá lẻ (VNĐ)</label>
                    <input asp-for="Prices.RetailPrice" id="Prices_RetailPrice" data-vnd="true" inputmode="decimal" class="@fieldClass font-mono tabular-nums" />
                </div>
                <div>
                    <label class="@labelClass" for="Prices_DealerPrice">Giá đại lý (VNĐ)</label>
                    <input asp-for="Prices.DealerPrice" id="Prices_DealerPrice" data-vnd="true" inputmode="decimal" class="@fieldClass font-mono tabular-nums" />
                </div>
                <div>
                    <label class="@labelClass" for="Prices_DistributorPrice">Giá nhà phân phối (VNĐ)</label>
                    <input asp-for="Prices.DistributorPrice" id="Prices_DistributorPrice" data-vnd="true" inputmode="decimal" class="@fieldClass font-mono tabular-nums" />
                </div>
                <div>
                    <label class="@labelClass" for="Prices_ProjectPrice">Giá dự án (VNĐ)</label>
                    <input asp-for="Prices.ProjectPrice" id="Prices_ProjectPrice" data-vnd="true" inputmode="decimal" class="@fieldClass font-mono tabular-nums" />
                </div>
            </div>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div>
                    <label class="@labelClass" for="Prices_WeightKg">Khối lượng (kg)</label>
                    <input asp-for="Prices.WeightKg" id="Prices_WeightKg" inputmode="decimal" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Prices_VolumeM3">Thể tích (m³)</label>
                    <input asp-for="Prices.VolumeM3" id="Prices_VolumeM3" inputmode="decimal" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Prices_MinimumStock">Định mức tồn tối thiểu</label>
                    <input asp-for="Prices.MinimumStock" id="Prices_MinimumStock" inputmode="decimal" class="@fieldClass" />
                </div>
            </div>
            <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
                <div>
                    <label class="@labelClass" for="Prices_HeightMm">Chiều cao (mm)</label>
                    <input asp-for="Prices.HeightMm" id="Prices_HeightMm" inputmode="numeric" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Prices_LengthMm">Chiều dài (mm)</label>
                    <input asp-for="Prices.LengthMm" id="Prices_LengthMm" inputmode="numeric" class="@fieldClass" />
                </div>
                <div>
                    <label class="@labelClass" for="Prices_WidthMm">Chiều rộng (mm)</label>
                    <input asp-for="Prices.WidthMm" id="Prices_WidthMm" inputmode="numeric" class="@fieldClass" />
                </div>
            </div>
            <div class="mt-4">
                <label class="@labelClass" for="Prices_Image">Ảnh sản phẩm</label>
                @{
                    var priceImage = CatalogImageStore.PublicUrl(Model.CurrentImagePath);
                }
                @if (priceImage is not null)
                {
                    <img src="@priceImage" alt="" class="mb-3 h-24 w-24 rounded-lg object-cover" />
                }
                <input id="Prices_Image" name="Image" type="file" accept="image/jpeg,image/png,image/webp,image/gif" class="block w-full text-sm text-slate-600 file:mr-3 file:rounded-lg file:border-0 file:bg-sky-50 file:px-3 file:py-2 file:text-sm file:font-medium file:text-sky-700" />
                <p class="mt-1 text-xs text-slate-500">JPG, PNG, WEBP hoặc GIF, tối đa 5 MB. Để trống nếu giữ ảnh hiện tại.</p>
            </div>
            <div class="mt-6 flex justify-end gap-3 border-t border-slate-100 pt-4">
                <a href="@Model.FilteredListUrl" class="rounded-lg px-4 py-2 text-sm font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:opacity-60">Quay lại</a>
                <button type="submit" class="rounded-lg px-4 py-2 text-sm font-bold bg-sky-600 text-white hover:bg-sky-700 disabled:opacity-60">Lưu sản phẩm</button>
            </div>
        </form>
</dialog>
}

@if (Model.Detail is not null)
{
    var detail = Model.Detail;
    var detailImage = CatalogImageStore.PublicUrl(detail.ImagePath);
    <dialog id="catalog-detail-dialog" data-autoshow class="m-auto !flex w-[min(40rem,calc(100%-2rem))] max-h-[calc(100%-2rem)] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/50">
        <div class="flex shrink-0 items-center justify-between gap-3 px-6 pt-6">
            <div>
                <h2 class="text-base font-bold text-slate-900">@detail.Name</h2>
                <p class="mt-1 font-mono text-xs text-slate-500">@detail.Code</p>
            </div>
            <a href="@Model.FilteredListUrl" class="rounded-lg px-3 py-1.5 text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:opacity-60">Đóng</a>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto px-6 pb-6">
            @if (detailImage is not null)
            {
                <img src="@detailImage" alt="@detail.Name" class="mt-4 h-40 w-40 rounded-xl object-cover" />
            }
            <dl class="mt-6 grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
                <div><dt class="text-slate-500">Ngành</dt><dd class="font-medium text-slate-900">@CatalogLabels.Category(detail.Category)</dd></div>
                <div><dt class="text-slate-500">Thương hiệu</dt><dd class="font-medium text-slate-900">@CatalogLabels.Text(detail.Brand)</dd></div>
                <div><dt class="text-slate-500">Xuất xứ</dt><dd class="font-medium text-slate-900">@CatalogLabels.Text(detail.Origin)</dd></div>
                <div><dt class="text-slate-500">Đơn vị</dt><dd class="font-medium text-slate-900">@CatalogLabels.Text(detail.Unit)</dd></div>
                <div><dt class="text-slate-500">Chiều cao (mm)</dt><dd class="font-mono tabular-nums text-slate-900">@CatalogLabels.Millimeters(detail.HeightMm)</dd></div>
                <div><dt class="text-slate-500">Chiều dài (mm)</dt><dd class="font-mono tabular-nums text-slate-900">@CatalogLabels.Millimeters(detail.LengthMm)</dd></div>
                <div><dt class="text-slate-500">Chiều rộng (mm)</dt><dd class="font-mono tabular-nums text-slate-900">@CatalogLabels.Millimeters(detail.WidthMm)</dd></div>
                <div><dt class="text-slate-500">Trọng lượng</dt><dd class="font-mono tabular-nums text-slate-900">@CatalogLabels.Measure(detail.WeightKg)</dd></div>
                <div><dt class="text-slate-500">Thể tích</dt><dd class="font-mono tabular-nums text-slate-900">@CatalogLabels.Measure(detail.VolumeM3)</dd></div>
                <div><dt class="text-slate-500">Số tháng bảo hành</dt><dd class="font-mono tabular-nums text-slate-900">@CatalogLabels.Months(detail.WarrantyMonths)</dd></div>
                <div><dt class="text-slate-500">Mức tồn tối thiểu</dt><dd class="font-mono tabular-nums text-slate-900">@CatalogLabels.Measure(detail.MinimumStock)</dd></div>
                <div><dt class="text-slate-500">Giá vốn</dt><dd class="font-mono tabular-nums text-slate-900">@VndMoney.FormatDong(detail.CostPrice)</dd></div>
                <div><dt class="text-slate-500">Giá lẻ</dt><dd class="font-mono tabular-nums text-slate-900">@VndMoney.FormatDong(detail.RetailPrice)</dd></div>
                <div><dt class="text-slate-500">Giá đại lý</dt><dd class="font-mono tabular-nums text-slate-900">@VndMoney.FormatDong(detail.DealerPrice)</dd></div>
                <div><dt class="text-slate-500">Giá nhà phân phối</dt><dd class="font-mono tabular-nums text-slate-900">@VndMoney.FormatDong(detail.DistributorPrice)</dd></div>
                <div><dt class="text-slate-500">Giá dự án</dt><dd class="font-mono tabular-nums text-slate-900">@VndMoney.FormatDong(detail.ProjectPrice)</dd></div>
            </dl>
            <p class="mt-6 text-sm font-medium text-slate-700">@CatalogLabels.PricesIncludeVat</p>
        </div>
    </dialog>
}

<script src="~/js/catalog-form.js" asp-append-version="true" defer></script>
