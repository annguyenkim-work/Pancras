@page "/audit"
@model Pancras.Web.Pages.Audit.IndexModel
@using Pancras.Web.Formatting
@{
    ViewData["Title"] = "Nhật ký hệ thống";
}

<section class="bg-white rounded-xl border border-slate-200 p-6">
    <h1 class="font-display text-xl sm:text-2xl font-bold text-slate-900">Nhật ký hệ thống</h1>
    <p class="mt-1 text-sm text-slate-500">Đăng nhập, đổi quyền, duyệt phiếu, đổi giá. Không ghi mật khẩu hay mã xác thực.</p>
    <form method="get" action="/audit" data-live-filter class="mt-5">
        <input name="q" value="@Model.Search" type="search" placeholder="Tìm theo hành động, mã nhân viên, đối tượng, địa chỉ IP..." aria-label="Tìm kiếm" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" />
    </form>
</section>

<div id="live-results">
@if (Model.Entries.Count == 0)
{
    <partial name="_EmptyState" model='new EmptyStateModel("Chưa có dòng nhật ký nào.", "Các thao tác quan trọng sẽ được ghi tại đây.")' />
}
else
{
    <div class="mt-4 overflow-x-auto rounded-xl border border-slate-200 bg-white">
        <table class="min-w-full text-sm">
            <thead class="bg-slate-50 text-left text-xs uppercase tracking-wide text-slate-500">
                <tr>
                    <th class="px-4 py-2 font-semibold"><partial name="_SortHeader" model='new SortHeaderModel("Thời điểm", Model.SortUrl(), true, Model.Sort.Descending)' /></th>
                    <th class="px-4 py-2 font-semibold">Người thực hiện</th>
                    <th class="px-4 py-2 font-semibold">Hành động</th>
                    <th class="px-4 py-2 font-semibold">Đối tượng</th>
                    <th class="px-4 py-2 font-semibold">Chi tiết</th>
                    <th class="px-4 py-2 font-semibold">IP</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in Model.Entries)
                {
                    <tr class="border-t border-slate-100 align-top">
                        <td class="px-4 py-2 whitespace-nowrap tabular-nums text-slate-700">@VietnamTime.Format(entry.OccurredAt, "dd/MM/yyyy HH:mm:ss")</td>
                        <td class="px-4 py-2 font-mono text-xs text-slate-800">@(string.IsNullOrEmpty(entry.ActorCode) ? "—" : entry.ActorCode)</td>
                        <td class="px-4 py-2 text-slate-900">@AuditLabels.Of(entry.Action)<span class="block font-mono text-[11px] text-slate-500">@entry.Action</span></td>
                        <td class="px-4 py-2 text-slate-700">@entry.TargetType <span class="font-mono text-[11px] text-slate-500">@entry.TargetId</span></td>
                        <td class="px-4 py-2 text-slate-700">@entry.Detail</td>
                        <td class="px-4 py-2 font-mono text-xs text-slate-600">@entry.IpAddress</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
}
</div>
