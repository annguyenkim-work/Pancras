@page "/nha-cung-cap"
@model Pancras.Web.Pages.Suppliers.IndexModel
@{
    ViewData["Title"] = "Nhà cung cấp nhập khẩu";
}

<section class="bg-white rounded-xl border border-slate-200 p-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-lg sm:text-xl font-bold text-slate-900">Nhà cung cấp nhập khẩu</h1>
        <a href="@Model.AddUrl" class="px-4 py-2 text-sm font-bold text-white bg-sky-600 rounded-lg" onclick="document.getElementById('supplier-edit-dialog').classList.add('hidden'); document.getElementById('supplier-dialog').classList.remove('hidden'); return false;">Thêm nhà cung cấp</a>
    </div>
    <form method="get" action="/nha-cung-cap" class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-end">
        <div class="flex-1">
            <label class="block text-sm font-medium text-slate-600" for="supplier-search">Tìm kiếm</label>
            <input id="supplier-search" name="q" value="@Model.Search" placeholder="Mã hoặc tên nhà cung cấp" class="mt-1.5 w-full px-3 py-2 text-sm rounded-lg border border-slate-200 bg-white outline-none focus:border-slate-900" />
        </div>
        <div class="flex gap-2">
            <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-sky-600 rounded-lg">Tìm kiếm</button>
            @if (Model.HasSearch)
            {
                <a href="/nha-cung-cap" class="px-4 py-2 text-sm font-medium rounded-lg bg-slate-100 text-slate-600">Bỏ lọc</a>
            }
        </div>
    </form>
    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <p class="mt-4 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-800" role="status">@Model.Notice</p>
    }
    @if (Model.ErrorMessages.Count > 0 && !Model.ShowForm && !Model.ShowEditForm)
    {
        <div class="mt-4">
            <partial name="_ErrorNotice" />
        </div>
    }
</section>

@if (Model.Cards.Count == 0)
{
    <p class="mt-4 text-sm text-slate-600">@(Model.HasSearch ? "Không tìm thấy nhà cung cấp." : "Chưa có nhà cung cấp.")</p>
}
else
{
    <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        @foreach (var card in Model.Cards)
        {
            <article class="flex flex-col bg-white rounded-xl border border-slate-200 p-5 shadow-sm">
                <div class="flex items-start gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-sky-50 text-sky-600">
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M6 21V8l6-4 6 4v13M10 21v-5h4v5M9 11h.01M15 11h.01M9 15h.01M15 15h.01" />
                        </svg>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-3">
                            <h2 class="text-sm font-bold leading-snug text-slate-900">@card.Name</h2>
                            <span class="shrink-0 rounded-md bg-slate-100 px-2 py-1 text-xs text-slate-600">@card.Country</span>
                        </div>
                        <p class="mt-1 font-mono text-xs font-medium tracking-wide text-slate-400">@card.Code</p>
                    </div>
                </div>
                <dl class="mt-5 space-y-2.5 text-sm">
                    <div class="grid grid-cols-[5.25rem_1fr] gap-3">
                        <dt class="text-slate-500">Liên hệ</dt>
                        <dd class="text-right text-slate-800">@card.ContactName</dd>
                    </div>
                    <div class="grid grid-cols-[5.25rem_1fr] gap-3">
                        <dt class="text-slate-500">Điện thoại</dt>
                        <dd class="text-right font-mono tabular-nums text-slate-800">@card.Phone</dd>
                    </div>
                    <div class="grid grid-cols-[5.25rem_1fr] gap-3">
                        <dt class="text-slate-500">Email</dt>
                        <dd class="break-all text-right text-slate-800">@card.Email</dd>
                    </div>
                    <div class="grid grid-cols-[5.25rem_1fr] gap-3">
                        <dt class="text-slate-500">Tài khoản</dt>
                        <dd class="break-words text-right text-slate-800">@card.Account</dd>
                    </div>
                </dl>
                <div class="mt-auto flex items-center justify-between gap-3 pt-5 text-sm">
                    <p class="text-slate-500"><span class="font-mono tabular-nums">@card.PurchaseOrderCount</span> đơn mua</p>
                    @if (card.LotsNotReceived == 0)
                    {
                        <p class="font-medium text-emerald-600">Không có lô đang về</p>
                    }
                    else
                    {
                        <p class="font-medium text-orange-500"><span class="font-mono tabular-nums">@card.LotsNotReceived</span> lô chưa nhập kho</p>
                    }
                </div>
                <div class="mt-4 flex justify-end gap-2">
                    <a href="@Model.EditUrl(card.Id)" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-slate-100 text-slate-700">Sửa</a>
                    <a href="@Model.DeleteUrl(card.Id)" class="px-3 py-1.5 text-xs font-bold rounded-lg bg-rose-50 text-rose-700" data-supplier-id="@card.Id" data-supplier-name="@card.Name" onclick="openDeleteSupplier(this); return false;">Xóa</a>
                </div>
            </article>
        }
    </div>
    @if (Model.CardPage.TotalPages > 1)
    {
        <nav class="mt-4 flex flex-wrap items-center justify-center gap-2" aria-label="Phân trang">
            @if (Model.CardPage.HasPrevious)
            {
                <a href="@Model.PageUrl(Model.CardPage.PageNumber - 1)" class="px-3 py-1.5 text-sm font-medium rounded-lg bg-white border border-slate-200 text-slate-700">Trước</a>
            }
            else
            {
                <span class="px-3 py-1.5 text-sm font-medium rounded-lg bg-white border border-slate-200 text-slate-300">Trước</span>
            }
            @foreach (var page in Model.VisiblePages)
            {
                if (page == Model.CardPage.PageNumber)
                {
                    <span class="px-3 py-1.5 text-sm font-bold rounded-lg bg-sky-600 text-white" aria-current="page">@(page)</span>
                }
                else
                {
                    <a href="@Model.PageUrl(page)" class="px-3 py-1.5 text-sm font-bold rounded-lg bg-white border border-slate-200 text-slate-700">@(page)</a>
                }
            }
            @if (Model.CardPage.HasNext)
            {
                <a href="@Model.PageUrl(Model.CardPage.PageNumber + 1)" class="px-3 py-1.5 text-sm font-medium rounded-lg bg-white border border-slate-200 text-slate-700">Sau</a>
            }
            else
            {
                <span class="px-3 py-1.5 text-sm font-medium rounded-lg bg-white border border-slate-200 text-slate-300">Sau</span>
            }
        </nav>
    }
}

<div id="supplier-dialog" class="@(Model.ShowForm ? string.Empty : "hidden") fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 p-4">
    <div class="mx-auto my-8 w-full max-w-2xl bg-white rounded-2xl shadow-xl border border-slate-200 p-6">
        <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-sky-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M6 21V8l6-4 6 4v13M10 21v-5h4v5M9 11h.01M15 11h.01M9 15h.01M15 15h.01" />
                </svg>
                <h2 class="text-base font-bold text-slate-900">Thêm nhà cung cấp</h2>
            </div>
            <a href="@Model.FilteredListUrl" class="p-1.5 rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-600" aria-label="Đóng">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
                </svg>
            </a>
        </div>
        <form method="post" class="mt-6">
            <input type="hidden" name="q" value="@Model.Search" />
            <input type="hidden" name="page" value="@Model.CardPage.PageNumber" />
            @if (Model.ShowForm)
            {
                <partial name="_ErrorNotice" />
            }
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-600" asp-for="Command.Code">Mã NCC</label>
                    <input asp-for="Command.Code" maxlength="32" spellcheck="false" class="@Model.FieldClass(SupplierField.Code)" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-600" asp-for="Command.Country">Quốc gia / khu vực</label>
                    <input asp-for="Command.Country" maxlength="100" class="@Model.FieldClass(SupplierField.Country)" />
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-slate-600" asp-for="Command.Name">Tên nhà cung cấp</label>
                    <input asp-for="Command.Name" maxlength="200" class="@Model.FieldClass(SupplierField.Name)" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-600" asp-for="Command.ContactName">Người liên hệ</label>
                    <input asp-for="Command.ContactName" maxlength="200" class="@Model.FieldClass(SupplierField.ContactName)" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-600" asp-for="Command.Phone">Điện thoại</label>
                    <input asp-for="Command.Phone" inputmode="tel" maxlength="30" autocomplete="tel" spellcheck="false" placeholder="0901234567 hoặc +84901234567" aria-describedby="create-phone-hint" class="@Model.FieldClass(SupplierField.Phone)" />
                    <p id="create-phone-hint" class="mt-1.5 text-xs text-slate-500">8–15 chữ số. Có thể bắt đầu bằng 0 hoặc +. Dấu cách, gạch ngang và ngoặc được giữ lại.</p>
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-slate-600" asp-for="Command.Email">Email</label>
                    <input asp-for="Command.Email" maxlength="254" inputmode="email" autocomplete="email" spellcheck="false" placeholder="ten@congty.com" class="@Model.FieldClass(SupplierField.Email)" />
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-slate-600" asp-for="Command.Account">Tài khoản</label>
                    <input asp-for="Command.Account" maxlength="64" spellcheck="false" class="@Model.FieldClass(SupplierField.Account)" />
                </div>
            </div>
            <div class="flex justify-end gap-2 mt-6">
                <a href="@Model.FilteredListUrl" class="px-4 py-2 text-sm font-medium rounded-lg bg-slate-100 text-slate-600">Hủy</a>
                <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-sky-600 rounded-lg">Lưu nhà cung cấp</button>
            </div>
        </form>
    </div>
</div>

<div id="supplier-edit-dialog" class="@(Model.ShowEditForm ? string.Empty : "hidden") fixed inset-0 z-50 overflow-y-auto bg-slate-900/50 p-4">
    <div class="mx-auto my-8 w-full max-w-2xl bg-white rounded-2xl shadow-xl border border-slate-200 p-6">
        <div class="flex items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-sky-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M6 21V8l6-4 6 4v13M10 21v-5h4v5M9 11h.01M15 11h.01M9 15h.01M15 15h.01" />
                </svg>
                <h2 class="text-base font-bold text-slate-900">Sửa nhà cung cấp</h2>
            </div>
            <a href="@Model.FilteredListUrl" class="p-1.5 rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-600" aria-label="Đóng">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
                </svg>
            </a>
        </div>
        <form method="post" asp-page-handler="Edit" class="mt-6">
            <input type="hidden" name="q" value="@Model.Search" />
            <input type="hidden" name="page" value="@Model.CardPage.PageNumber" />
            <input type="hidden" asp-for="EditCommand.Id" />
            @if (Model.ShowEditForm)
            {
                <partial name="_ErrorNotice" />
            }
            <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-4">
                <div>
                    <label class="block text-sm font-medium text-slate-600" asp-for="EditCommand.Code">Mã NCC</label>
                    <input asp-for="EditCommand.Code" maxlength="32" spellcheck="false" class="@Model.FieldClass(SupplierField.Code)" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-600" asp-for="EditCommand.Country">Quốc gia / khu vực</label>
                    <input asp-for="EditCommand.Country" maxlength="100" class="@Model.FieldClass(SupplierField.Country)" />
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-slate-600" asp-for="EditCommand.Name">Tên nhà cung cấp</label>
                    <input asp-for="EditCommand.Name" maxlength="200" class="@Model.FieldClass(SupplierField.Name)" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-600" asp-for="EditCommand.ContactName">Người liên hệ</label>
                    <input asp-for="EditCommand.ContactName" maxlength="200" class="@Model.FieldClass(SupplierField.ContactName)" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-600" asp-for="EditCommand.Phone">Điện thoại</label>
                    <input asp-for="EditCommand.Phone" inputmode="tel" maxlength="30" autocomplete="tel" spellcheck="false" placeholder="0901234567 hoặc +84901234567" aria-describedby="edit-phone-hint" class="@Model.FieldClass(SupplierField.Phone)" />
                    <p id="edit-phone-hint" class="mt-1.5 text-xs text-slate-500">8–15 chữ số. Có thể bắt đầu bằng 0 hoặc +. Dấu cách, gạch ngang và ngoặc được giữ lại.</p>
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-slate-600" asp-for="EditCommand.Email">Email</label>
                    <input asp-for="EditCommand.Email" maxlength="254" inputmode="email" autocomplete="email" spellcheck="false" placeholder="ten@congty.com" class="@Model.FieldClass(SupplierField.Email)" />
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-sm font-medium text-slate-600" asp-for="EditCommand.Account">Tài khoản</label>
                    <input asp-for="EditCommand.Account" maxlength="64" spellcheck="false" class="@Model.FieldClass(SupplierField.Account)" />
                </div>
            </div>
            <div class="flex justify-end gap-2 mt-6">
                <a href="@Model.FilteredListUrl" class="px-4 py-2 text-sm font-medium rounded-lg bg-slate-100 text-slate-600">Hủy</a>
                <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-sky-600 rounded-lg">Lưu thay đổi</button>
            </div>
        </form>
    </div>
</div>

<div id="delete-dialog" class="@(Model.ShowDelete ? string.Empty : "hidden") fixed inset-0 z-50 flex items-center justify-center bg-slate-900/50 p-4">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-xl border border-slate-200 p-6">
        <h2 class="text-base font-bold text-slate-900">Xóa nhà cung cấp</h2>
        <p class="mt-3 text-sm text-slate-600"><span id="delete-supplier-name" class="font-medium text-slate-900">@Model.DeleteName</span> sẽ không còn trên danh bạ.</p>
        <form method="post" asp-page-handler="Delete" class="flex justify-end gap-2 mt-6">
            <input type="hidden" name="q" value="@Model.Search" />
            <input type="hidden" name="page" value="@Model.CardPage.PageNumber" />
            <input asp-for="DeleteId" id="delete-supplier-id" type="hidden" />
            <a href="@Model.FilteredListUrl" class="px-4 py-2 text-sm font-medium rounded-lg bg-slate-100 text-slate-600">Hủy</a>
            <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-rose-600 rounded-lg">Xóa</button>
        </form>
    </div>
</div>

<script>
    function openDeleteSupplier(button) {
        document.getElementById('delete-supplier-id').value = button.dataset.supplierId;
        document.getElementById('delete-supplier-name').textContent = button.dataset.supplierName;
        document.getElementById('delete-dialog').classList.remove('hidden');
    }
</script>
