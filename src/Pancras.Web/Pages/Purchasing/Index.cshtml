                    </select>
                </label>
                <label class="flex flex-col justify-between gap-1 text-sm">
                    <span>Tỷ giá (đ / USD)</span>
                    <span class="relative block">
                        <input name="Form.ExchangeRate" value="@Model.Form.ExchangeRate.ToString("0", CultureInfo.InvariantCulture)" id="rate" inputmode="numeric" class="vnd draft w-full rounded-lg border border-slate-300 py-2 pl-3 pr-8" />
                        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-500">đ</span>
                    </span>
                </label>
                <label class="text-sm">Số hiệu Container<input asp-for="Form.ContainerNumber" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
                <label class="text-sm">Số Vận đơn (Bill of Lading)<input asp-for="Form.BillOfLading" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
