                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="mt-2 text-xs text-slate-500">FOB <span id="sum-fob">0 đ</span> · Thuế NK <span id="sum-duty">0 đ</span> · VAT <span id="sum-vat">0 đ</span></p>

            <section class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4">
                <div class="flex items-center justify-between gap-3">
                    <h3 class="text-sm font-bold text-slate-900">VAT CHUNG VÀ PHÍ LOGISTICS CỦA CONTAINER</h3>
                    <p class="text-sm font-bold">Tổng chi phí: <span id="sum-extra">0 đ</span></p>
                </div>
                <p class="mt-1 text-xs leading-5 text-slate-600">Một suất VAT cho mọi dòng. Thuế nhập khẩu nằm trên từng mặt hàng. Khoản nào không có thì để 0.</p>
                <p class="mt-2 text-xs leading-5 text-slate-700" role="note">Cước tàu biển (mua giá FOB, để 0 nếu nhà cung cấp đã gồm cước) cộng vào trị giá tính thuế. Phí nâng hạ cảng (THC), D/O, vệ sinh container, kiểm định và kéo xe về kho là logistics, cộng thẳng vào giá vốn. Các khoản chia theo thể tích nếu mặt hàng đã khai báo thể tích, nếu chưa thì chia theo trị giá FOB. Có thể thêm khoản khác và đổi nhóm ở chi tiết đơn.</p>
                <label class="mt-3 flex items-start gap-2 text-sm text-slate-800">
                    <input asp-for="Form.VatDeductible" id="vat-deductible" type="checkbox" class="mt-1 draft" />
                    <span>VAT đầu vào được khấu trừ <span class="block text-xs text-slate-500">Mặc định tắt: VAT cộng vào giá vốn (theo yêu cầu của công ty). Chỉ bật nếu đơn này được khấu trừ VAT, khi đó VAT không vào giá vốn.</span></span>
                </label>
                @* Mọi ô cùng một kiểu: nhãn ở trên, ô nhập dưới cùng (justify-between) nên các ô thẳng hàng dù nhãn dài ngắn khác nhau; đơn vị nằm trong ô. *@
                <div class="mt-3 grid grid-cols-1 gap-x-4 gap-y-3 sm:grid-cols-2 lg:grid-cols-3">
                    <label class="flex flex-col justify-between gap-1 text-sm">
                        <span>Thuế VAT</span>
                        <span class="relative block">
                            <input name="Form.VatPercent" value="@Model.Form.VatPercent.ToString("0.####", CultureInfo.InvariantCulture)" id="vat-percent" inputmode="decimal" class="draft w-full rounded-lg border border-slate-300 py-2 pl-3 pr-9" />
                            <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-500">%</span>
                        </span>
                    </label>
                    <div class="@(Model.EditingId is null ? "contents" : "hidden")">
                        <label class="flex flex-col justify-between gap-1 text-sm">
                            <span>Cước tàu biển quốc tế (Ocean Freight)</span>
                            <span class="relative block">
                                <input asp-for="Form.OceanFreight" id="ocean" inputmode="numeric" class="vnd draft w-full rounded-lg border border-slate-300 py-2 pl-3 pr-8" />
                                <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-500">đ</span>
                            </span>
                        </label>
                        <label class="flex flex-col justify-between gap-1 text-sm">
                            <span>Phí nâng hạ bãi cảng (THC, D/O, vệ sinh cont)</span>
                            <span class="relative block">
                                <input asp-for="Form.PortHandling" id="port-fee" inputmode="numeric" class="vnd draft w-full rounded-lg border border-slate-300 py-2 pl-3 pr-8" />
                                <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-500">đ</span>
                            </span>
                        </label>
                        <label class="flex flex-col justify-between gap-1 text-sm">
                            <span>Phí kiểm định chất lượng sản phẩm</span>
                            <span class="relative block">
                                <input asp-for="Form.InspectionFee" id="inspection" inputmode="numeric" class="vnd draft w-full rounded-lg border border-slate-300 py-2 pl-3 pr-8" />
                                <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-500">đ</span>
                            </span>
                        </label>
                        <label class="flex flex-col justify-between gap-1 text-sm">
                            <span>Vận chuyển kéo xe container từ cảng về kho</span>
                            <span class="relative block">
                                <input asp-for="Form.InlandTrucking" id="trucking" inputmode="numeric" class="vnd draft w-full rounded-lg border border-slate-300 py-2 pl-3 pr-8" />
                                <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-500">đ</span>
                            </span>
                        </label>
                    </div>
                </div>
            </section>

            <div class="mt-4 rounded-xl bg-slate-900 px-4 py-3 text-white sm:flex sm:items-center sm:justify-between">
                <p>Tổng tiền thực chi cho container (gồm VAT nộp khi thông quan): <span id="sum-order" class="text-lg font-bold">0 đ</span></p>
                <p class="text-xs text-slate-300">Tiền hàng <span id="foot-fob">0 đ</span> · Thuế NK <span id="foot-duty">0 đ</span> · VAT <span id="foot-vat">0 đ</span> · Phí logistics <span id="foot-logistics">0 đ</span></p>
            </div>
            <div class="mt-4 flex justify-end gap-2">
                <a href="/purchasing" class="px-4 py-2 text-sm font-medium rounded-lg bg-slate-100 text-slate-600">Hủy</a>
                <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-sky-600 rounded-lg">@(Model.EditingId is null ? "Lưu Đơn Mua Hàng & Container" : "Lưu thay đổi")</button>
            </div>
        </form>
    </dialog>
    <script>
        (function () {
            const body = document.getElementById("line-body");
            const money = new Intl.NumberFormat("vi-VN");
            const dong = (value) => money.format(Math.round(value)) + " đ";
            const roundDong = (value) => Math.sign(value) * Math.round(Math.abs(value));
            const plainNumber = (input) => {
                if (input.classList.contains("vnd")) {
                    const digits = String(input.value).replace(/\D/g, "");
                    return digits === "" ? 0 : Number(digits);
                }

                const value = Number(String(input.value).trim().replace(",", "."));
                return Number.isFinite(value) ? value : 0;
            };
            const template = body.querySelector(".line-row")?.cloneNode(true) ?? null;
            function formatVndInputs() {
                document.querySelectorAll(".vnd").forEach((input) => {
                    const formatted = money.format(plainNumber(input));
                    if (input.value !== formatted) {
                        input.value = formatted;
                    }
                });
            }
            function reindex() {
                [...body.querySelectorAll(".line-row")].forEach((row, index) => {
                    row.querySelector("select").name = `Form.Lines[${index}].CatalogItemId`;
                    row.querySelector(".line-qty").name = `Form.Lines[${index}].Quantity`;
                    row.querySelector(".line-unit").name = `Form.UnitPrices[${index}]`;
                    row.querySelector(".line-duty").name = `Form.DutyPercents[${index}]`;
                    row.querySelector(".line-other").name = `Form.Lines[${index}].SupplementalDuty`;
                    row.querySelector(".line-id").name = `Form.Lines[${index}].LineId`;
                });
            }
            function paint() {
                formatVndInputs();
                const rate = roundDong(plainNumber(document.getElementById("rate")));
                const vatRate = Math.round(plainNumber(document.getElementById("vat-percent")) * 100) / 10000;
                const ocean = roundDong(plainNumber(document.getElementById("ocean")));
                const logistics = ["port-fee", "inspection", "trucking"].reduce((sum, id) => sum + roundDong(plainNumber(document.getElementById(id))), 0);
                const deductible = document.getElementById("vat-deductible").checked;
                const rows = [...body.querySelectorAll(".line-row")];
                const drafts = rows.map((row) => {
                    const qty = plainNumber(row.querySelector(".line-qty"));
                    const unit = Math.round(plainNumber(row.querySelector(".line-unit")) * 100) / 100;
                    const dutyRate = Math.round(plainNumber(row.querySelector(".line-duty")) * 100) / 10000;
                    const fob = roundDong(unit * qty * rate);
                    const other = Math.max(0, roundDong(plainNumber(row.querySelector(".line-other"))));
                    return { row, qty, fob, dutyRate, other };
                }).filter((line) => line.qty > 0 && line.fob > 0);
                const totalFob = drafts.reduce((sum, line) => sum + line.fob, 0);
                // Bản xem thử chia theo trị giá FOB; khi lưu, hệ thống chia theo thể tích nếu đã có số đo.
                const split = (amount) => {
                    const result = [];
                    let taken = 0;
                    drafts.forEach((line, index) => {
                        const share = index === drafts.length - 1 ? amount - taken : Math.trunc(amount * line.fob / totalFob);
                        taken += share;
                        result.push(share);
                    });
                    return result;
                };
                const oceanShares = split(ocean);
                const shares = split(logistics);
                drafts.forEach((line, index) => {
                    line.customs = line.fob + oceanShares[index];
                    line.duty = line.customs * line.dutyRate;
                });
                rows.forEach((row) => {
                    row.querySelector(".out-fob").textContent = "0 đ";
                    row.querySelector(".out-duty").textContent = "0 đ";
                    row.querySelector(".out-logistics").textContent = "0 đ";
                    row.querySelector(".out-unit").textContent = "0 đ";
                });
                let dutySum = 0;
                let vatSum = 0;
                let costSum = 0;
                drafts.forEach((line, index) => {
                    const vat = (line.customs + line.duty + line.other) * vatRate;
                    const landed = line.customs + line.duty + line.other + shares[index] + (deductible ? 0 : vat);
                    dutySum += line.duty;
                    vatSum += vat;
                    costSum += landed;
                    line.row.querySelector(".out-fob").textContent = dong(line.fob);
                    line.row.querySelector(".out-duty").textContent = dong(line.duty);
                    line.row.querySelector(".out-logistics").textContent = dong(oceanShares[index] + shares[index]);
                    line.row.querySelector(".out-unit").textContent = dong(line.qty === 0 ? 0 : landed / line.qty);
                });
                document.getElementById("line-count").textContent = String(rows.length);
                document.getElementById("sum-fob").textContent = dong(totalFob);
                document.getElementById("sum-duty").textContent = dong(dutySum);
                document.getElementById("sum-vat").textContent = dong(vatSum);
                document.getElementById("sum-extra").textContent = dong(ocean + logistics + vatSum);
                document.getElementById("sum-order").textContent = dong(costSum + (deductible ? vatSum : 0));
                document.getElementById("foot-fob").textContent = dong(totalFob);
                document.getElementById("foot-duty").textContent = dong(dutySum);
                document.getElementById("foot-vat").textContent = dong(vatSum);
                document.getElementById("foot-logistics").textContent = dong(ocean + logistics);
            }
            document.getElementById("add-line").addEventListener("click", () => {
                if (!template) {
                    return;
                }

                const row = template.cloneNode(true);
                row.querySelectorAll("input").forEach((input) => { input.value = "0"; });
                row.querySelector(".line-id").value = "";
                row.querySelector("select").selectedIndex = 0;
                body.appendChild(row);
                reindex();
                paint();
            });
            body.addEventListener("click", (event) => {
                const button = event.target.closest(".remove-line");
                if (!button) {
                    return;
                }

                button.closest(".line-row")?.remove();
                reindex();
                paint();
            });
            document.getElementById("purchase-draft").addEventListener("input", paint);
            document.getElementById("purchase-draft").addEventListener("submit", () => {
                document.querySelectorAll(".vnd").forEach((input) => {
                    input.value = String(plainNumber(input));
                });
            });
            reindex();
            paint();
        })();
    </script>
}
