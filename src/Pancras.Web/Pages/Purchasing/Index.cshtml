@page "/purchasing"
@model Pancras.Web.Pages.Purchasing.IndexModel
@using System.Globalization
@using Pancras.Domain.Purchasing
@using Pancras.Web.Formatting
@{
    ViewData["Title"] = "Mua hàng & Container Nhập";
    const string costNote = "Giá vốn dòng = trị giá hải quan + thuế nhập khẩu + thuế khác không khấu trừ + phí logistics được chia. Trị giá hải quan = FOB quy đổi (số lượng × đơn giá USD × tỷ giá) + cước biển được chia. Thuế nhập khẩu = trị giá hải quan × suất thuế. Phí chia theo cách chọn ở từng khoản, phần dư đồng về dòng cuối. VAT đầu vào được khấu trừ thì không vào giá vốn.";
}

<section class="bg-white rounded-xl border border-slate-200 p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="font-display text-xl sm:text-2xl font-bold text-slate-900">Mua Hàng, Container Nhập Khẩu &amp; Phân Bổ Giá Vốn (Landed Cost)</h1>
            <p class="mt-1 text-sm text-slate-500">Hỗ trợ lập phiếu mua nhiều mặt hàng trong cùng 1 container, tự động phân bổ chi phí logistics và thuế nhập khẩu vào giá vốn từng sản phẩm.</p>
        </div>
        @if (Model.CanManage)
        {
            <a href="/purchasing?form=1" class="px-4 py-2 text-sm font-bold text-white bg-sky-600 rounded-lg">+ Tạo Đơn Mua Hàng &amp; Container</a>
        }
    </div>
    @* Khi modal đang mở, lỗi hiện trong modal (bên dưới); hiện ở đây sẽ nằm sau lớp phủ và người dùng không thấy. *@
    @if (!string.IsNullOrEmpty(Model.ErrorMessage) && !Model.ShowForm)
    {
        <p class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800" role="alert">@Model.ErrorMessage</p>
    }
    @if (Model.HasAnyOrders)
    {
        <form method="get" action="/purchasing" data-live-filter class="mt-5">
            @if (Model.SupplierFilter is Guid supplierFilter)
            {
                <input type="hidden" name="supplier" value="@supplierFilter" />
            }
            <input name="q" value="@Model.Search" type="search" placeholder="Tìm theo mã đơn, nhà cung cấp, container, B/L, cảng..." aria-label="Tìm kiếm đơn mua" class="w-full rounded-lg border border-slate-200 px-3 py-2 text-sm" />
        </form>
        @if (Model.SupplierFilter is not null)
        {
            <p class="mt-3 flex flex-wrap items-center gap-2 text-sm text-slate-600">
                <span>Đang lọc theo một nhà cung cấp.</span>
                <a href="/purchasing" class="font-medium text-sky-700 hover:underline">Bỏ lọc</a>
            </p>
        }
    }
</section>

<div id="live-results">
@if (Model.Orders.Count == 0)
{
    @if (Model.HasAnyOrders)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("Không có đơn mua khớp từ khóa.", "Thử mã đơn, nhà cung cấp, số container hoặc B/L khác.")' />
    }
    else
    {
        @if (Model.CanManage)
        {
            <partial name="_EmptyState" model='new EmptyStateModel("Chưa có đơn mua.", "Tạo đơn mua đầu tiên để theo dõi container và phân bổ giá vốn.", "+ Tạo Đơn Mua Hàng & Container", "/purchasing?form=1")' />
        }
        else
        {
            <partial name="_EmptyState" model='new EmptyStateModel("Chưa có đơn mua nào về kho của bạn.", "Đơn mua hiện ở đây sau khi được duyệt.")' />
        }
    }
}
else
{
    <div class="mt-4 grid grid-cols-1 gap-4 xl:grid-cols-[22rem_minmax(0,1fr)]">
        <section class="space-y-3">
            <h2 class="text-xs font-bold tracking-wide text-slate-500">DANH SÁCH ĐƠN MUA CONTAINER (@Model.Orders.Count)</h2>
            @foreach (var card in Model.Orders)
            {
                var selected = Model.Selected?.Id == card.Id;
                <a href="/purchasing?order=@card.Id" class="block rounded-xl border bg-white p-4 @(selected ? "border-sky-500 shadow-sm" : "border-slate-200")">
                    <div class="flex items-start justify-between gap-2">
                        <p class="font-mono text-sm font-bold text-slate-900">@card.Code <span class="font-sans font-medium text-slate-500">@card.LineCount mặt hàng</span></p>
                        <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-bold @Pancras.Web.Pages.Purchasing.IndexModel.StatusClass(card.Status)">@Pancras.Web.Pages.Purchasing.IndexModel.StatusLabel(card.Status)</span>
                    </div>
                    <p class="mt-2 text-sm font-medium text-slate-800">@card.SupplierName</p>
                    <p class="mt-1 text-xs text-slate-500">Cont: @card.ContainerNumber · B/L: @card.BillOfLading</p>
                    <p class="text-xs text-slate-500">Cảng @card.Port @(card.ExpectedOn is null ? "" : $"· ETA {card.ExpectedOn:dd/MM/yyyy}")</p>
                    <div class="mt-3 flex items-end justify-between gap-2 text-xs text-slate-500">
                        <span>Kho nhận: @card.ReceiveLocationName</span>
                        @if (card.CostVisible) { <span class="font-bold tabular-nums text-slate-900">@VndMoney.FormatDong(card.LandedTotal)</span> }
                    </div>
                </a>
            }
        </section>

        @if (Model.Selected is { } order)
        {
            var quantity = order.Lines.Sum(line => line.Quantity);
            // Giá vốn còn là dự toán cho đến khi nhận hàng lần đầu.
            var estimated = order.Status is not (PurchaseStatus.Received or PurchaseStatus.PartiallyReceived);
            <section class="min-w-0 rounded-xl border border-slate-200 bg-white p-5">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                        <h2 class="text-base font-bold text-slate-900">@order.Code · @order.SupplierName</h2>
                        <p class="mt-1 text-sm text-slate-500">Cont: @order.ContainerNumber · B/L: @order.BillOfLading · Cảng: @order.Port · Kho nhận: @order.ReceiveLocationName</p>
                        @if (order.CostVisible)
                        {
                            <p class="mt-1 text-sm text-slate-500">Tỷ giá @VndMoney.FormatDong(order.ExchangeRate) / USD · VAT @((order.VatRate * 100m).ToString("0.####"))% @(order.VatDeductible ? "(được khấu trừ)" : "(không khấu trừ, tính vào giá vốn)")</p>
                        }
                        @* Lần ghi cuối trên đơn (kể cả lúc tạo) và lần nhận kho. Chi tiết từng bước nằm ở Nhật ký hệ thống. *@
                        <p class="mt-1 text-xs text-slate-500" id="order-stamps">
                            Cập nhật @order.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(string.IsNullOrEmpty(order.UpdatedBy) ? "" : " bởi " + order.UpdatedBy)
                            @if (order.ReceivedAt is DateTimeOffset receivedAt)
                            {
                                <text>· Nhận kho @receivedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(string.IsNullOrEmpty(order.ReceivedBy) ? "" : " bởi " + order.ReceivedBy)</text>
                            }
                        </p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                        <span class="self-center rounded-full px-2 py-0.5 text-xs font-bold @Pancras.Web.Pages.Purchasing.IndexModel.StatusClass(order.Status)">@Pancras.Web.Pages.Purchasing.IndexModel.StatusLabel(order.Status)</span>
                        <form method="post" asp-page-handler="Export">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <button type="submit" class="px-3 py-2 text-sm font-bold rounded-lg bg-slate-100 text-slate-700">Xuất CSV</button>
                        </form>
                        @if (Model.CanManage && Pancras.Web.Pages.Purchasing.IndexModel.IsEditable(order.Status))
                        {
                            <a href="/purchasing?edit=@order.Id" class="px-3 py-2 text-sm font-bold rounded-lg bg-slate-100 text-slate-700">Sửa đơn</a>
                        }
                        @if (Model.CanReceiveSelected && Pancras.Web.Pages.Purchasing.IndexModel.IsReceivable(order.Status))
                        {
                            <form id="receive-form" method="post" asp-page-handler="Receive" data-confirm data-confirm-title="Ghi nhận hàng vào kho" data-confirm-message="Ghi số thực nhận vào tồn và cập nhật giá vốn bình quân? Thao tác này không hoàn tác được." data-confirm-label="Ghi nhận" data-confirm-tone="danger">
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <input type="hidden" name="note" value="" />
                                <label class="flex items-center gap-2 self-center text-xs font-medium text-slate-600">
                                    <input type="checkbox" name="closeOrder" value="true" class="rounded border-slate-300" />
                                    Đóng đơn dù nhận thiếu
                                </label>
                                <button type="submit" class="px-3 py-2 text-sm font-bold text-white bg-emerald-600 rounded-lg">Nhập Kho &amp; Cập Nhật Giá Vốn (@order.Lines.Count món)</button>
                            </form>
                        }
                    </div>
                </div>

                @if (Model.CanManage && order.Status is PurchaseStatus.Draft or PurchaseStatus.PendingApproval or PurchaseStatus.Approved or PurchaseStatus.InTransit)
                {
                    @* Luồng đơn: Nháp → Chờ duyệt → Đã duyệt → Hàng đang về → nhận hàng. Trả về nháp và hủy phải ghi lý do. *@
                    <div class="mt-4 flex flex-wrap gap-2" id="order-workflow">
                        @if (order.Status == PurchaseStatus.Draft)
                        {
                            <form method="post" asp-page-handler="ChangeStatus" data-confirm data-confirm-title="Gửi duyệt" data-confirm-message="Gửi đơn này đi duyệt?" data-confirm-label="Gửi duyệt">
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <input type="hidden" name="action" value="@((int)Pancras.Application.Purchasing.PurchaseStatusAction.Submit)" />
                                <button type="submit" class="rounded-lg bg-sky-600 px-3 py-2 text-sm font-bold text-white">Gửi duyệt</button>
                            </form>
                        }
                        @if (order.Status == PurchaseStatus.PendingApproval)
                        {
                            <form method="post" asp-page-handler="ChangeStatus" data-confirm data-confirm-title="Duyệt đơn" data-confirm-message="Duyệt đơn này?" data-confirm-label="Duyệt đơn">
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <input type="hidden" name="action" value="@((int)Pancras.Application.Purchasing.PurchaseStatusAction.Approve)" />
                                <button type="submit" class="rounded-lg bg-emerald-600 px-3 py-2 text-sm font-bold text-white">Duyệt đơn</button>
                            </form>
                            <form method="post" asp-page-handler="ChangeStatus" data-confirm data-confirm-title="Trả về nháp" data-confirm-message="Đơn quay về nháp để sửa. Nhập lý do trả về." data-confirm-label="Trả về nháp" data-reason="required">
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <input type="hidden" name="action" value="@((int)Pancras.Application.Purchasing.PurchaseStatusAction.ReturnToDraft)" />
                                <input type="hidden" name="note" value="" />
                                <button type="submit" class="rounded-lg bg-slate-200 px-3 py-2 text-sm font-bold text-slate-800">Trả về nháp</button>
                            </form>
                        }
                        @if (order.Status == PurchaseStatus.Approved)
                        {
                            <form method="post" asp-page-handler="ChangeStatus" data-confirm data-confirm-title="Hàng đang về" data-confirm-message="Đánh dấu hàng đang trên đường về?" data-confirm-label="Hàng đang về">
                                <input type="hidden" name="orderId" value="@order.Id" />
                                <input type="hidden" name="action" value="@((int)Pancras.Application.Purchasing.PurchaseStatusAction.MarkInTransit)" />
                                <button type="submit" class="rounded-lg bg-sky-600 px-3 py-2 text-sm font-bold text-white">Hàng đang về</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="ChangeStatus" data-confirm data-confirm-title="Hủy đơn" data-confirm-message="Hủy đơn này? Không hoàn tác được." data-confirm-label="Hủy đơn" data-confirm-tone="danger" data-reason="required">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <input type="hidden" name="action" value="@((int)Pancras.Application.Purchasing.PurchaseStatusAction.Cancel)" />
                            <input type="hidden" name="note" value="" />
                            <button type="submit" class="rounded-lg border border-rose-200 bg-white px-3 py-2 text-sm font-bold text-rose-700">Hủy đơn</button>
                        </form>
                    </div>
                }

                <div class="mt-5 flex items-end justify-between gap-3">
                    <h3 class="text-xs font-bold tracking-wide text-slate-500">DANH SÁCH MẶT HÀNG TRONG CONTAINER</h3>
                    <p class="text-xs text-slate-500">Tổng SL: @quantity</p>
                </div>
                @if (order.CostVisible)
                {
                    <p class="mt-2 text-xs leading-5 text-slate-500">@costNote</p>
                }
                <div class="mt-3 max-w-full overflow-x-auto">
                    <table class="min-w-full whitespace-nowrap text-sm">
                        <thead class="text-left text-xs font-bold uppercase tracking-wide text-slate-500">
                            <tr>
                                <th class="py-2 pr-3">Mã SKU</th>
                                <th class="py-2 pr-3">Tên sản phẩm</th>
                                <th class="py-2 pr-3">SL đặt</th>
                                <th class="py-2 pr-3">SL đã nhận</th>
                                @if (Model.CanReceiveSelected && Pancras.Web.Pages.Purchasing.IndexModel.IsReceivable(order.Status))
                                {
                                    <th class="py-2 pr-3">SL nhận lần này</th>
                                }
                                @if (order.CostVisible)
                                {
                                    <th class="py-2 pr-3">Giá FOB (USD)</th>
                                    <th class="py-2 pr-3">Thuế NK</th>
                                    <th class="py-2 pr-3">Trị giá hải quan</th>
                                    <th class="py-2 pr-3">Giá tính VAT</th>
                                    <th class="py-2 pr-3">VAT</th>
                                    <th class="py-2 pr-3">Chi phí phân bổ</th>
                                    <th class="py-2 pr-3">@(estimated ? "Dự toán giá vốn dòng" : "Giá vốn dòng")</th>
                                    <th class="py-2 pr-3">@(estimated ? "Dự toán giá vốn / đơn vị" : "Giá vốn / đơn vị")</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in order.Lines)
                            {
                                <tr class="border-t border-slate-100 align-top">
                                    <td class="py-2 pr-3 font-mono">@line.ItemCode</td>
                                    <td class="py-2 pr-3">@line.ItemName</td>
                                    <td class="py-2 pr-3 tabular-nums">@line.Quantity</td>
                                    <td class="py-2 pr-3 tabular-nums">@line.ReceivedQuantity</td>
                                    @if (Model.CanReceiveSelected && Pancras.Web.Pages.Purchasing.IndexModel.IsReceivable(order.Status))
                                    {
                                        var remaining = Math.Max(0, line.Quantity - line.ReceivedQuantity);
                                        <td class="py-2 pr-3">
                                            <input form="receive-form" type="number" name="actuals[@line.Id]" value="@remaining" min="0" data-remaining="@remaining" class="w-20 rounded-lg border border-slate-300 px-2 py-1 text-right tabular-nums" />
                                        </td>
                                    }
                                    @if (order.CostVisible)
                                    {
                                        <td class="py-2 pr-3 tabular-nums">@((line.Quantity == 0 ? line.FobUsd : line.FobUsd / line.Quantity).ToString("#,##0.##", CultureInfo.GetCultureInfo("vi-VN"))) USD</td>
                                        <td class="py-2 pr-3 tabular-nums">@((line.DutyRate * 100m).ToString("0.####"))%</td>
                                        <td class="py-2 pr-3 tabular-nums">@VndMoney.FormatDong(line.Cost.CustomsInUse)</td>
                                        <td class="py-2 pr-3 tabular-nums">@VndMoney.FormatDong(line.Cost.VatBase)</td>
                                        <td class="py-2 pr-3 tabular-nums">@VndMoney.FormatDong(line.Cost.VatInUse)</td>
                                        <td class="py-2 pr-3 tabular-nums text-emerald-700">@VndMoney.FormatDong(line.Cost.LogisticsAllocated)</td>
                                        <td class="py-2 pr-3 tabular-nums">@VndMoney.FormatDong(line.Cost.LandedCost)</td>
                                        <td class="py-2 pr-3 tabular-nums font-bold">
                                            <a class="text-sky-700" href="/purchasing?order=@order.Id&amp;formula=@line.Id">@VndMoney.FormatDong(line.Cost.UnitCost)</a>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (order.CostVisible)
                {
                if (Model.FormulaLine is { } formula)
                {
                    <section class="mt-4 rounded-xl border border-sky-200 bg-sky-50 p-4 text-sm text-slate-700">
                        <h3 class="font-bold text-slate-900">Công thức giá vốn · @formula.ItemCode</h3>
                        <p class="mt-2">@costNote</p>
                        <p class="mt-2">Dòng này: FOB quy đổi @VndMoney.FormatDong(formula.Cost.FobConverted), thuế nhập khẩu @VndMoney.FormatDong(formula.Cost.DutyInUse), phí logistics @VndMoney.FormatDong(formula.Cost.LogisticsAllocated), giá vốn dòng @VndMoney.FormatDong(formula.Cost.LandedCost), đơn giá @VndMoney.FormatDong(formula.Cost.UnitCost).</p>
                    </section>
                }
                    var totalFob = order.Lines.Sum(line => line.Cost.FobConverted);
                    var totalDuty = order.Lines.Sum(line => line.Cost.DutyInUse);
                    var totalOtherTaxes = order.Lines.Sum(line => line.Cost.OtherTaxes);
                    var totalVat = order.Lines.Sum(line => line.Cost.VatInUse);
                    var totalLanded = order.Lines.Sum(line => line.Cost.LandedCost);
                    var totalExtra = totalLanded - totalFob;
                    var deductibleCharges = order.Charges.Where(charge => charge.Group == ChargeGroup.DeductibleTax).Sum(charge => charge.Amount);
                    // Tiền thực chi gồm cả VAT được khấu trừ và các khoản thuế khấu trừ khác: chúng không vào giá vốn nhưng vẫn phải trả.
                    var cashOut = totalLanded + (order.VatDeductible ? totalVat : 0m) + deductibleCharges;
                    var isOpen = Model.CanManage && Pancras.Web.Pages.Purchasing.IndexModel.IsEditable(order.Status);
                    var ungrouped = order.Charges.Count(charge => charge.Group is null);
                <div class="mt-6 flex flex-wrap items-center justify-between gap-2">
                    <h3 id="charges" class="scroll-mt-4 text-xs font-bold tracking-wide text-slate-500">BẢNG CHI PHÍ NHẬP KHẨU &amp; PHÂN BỔ (LANDED COST BREAKDOWN)</h3>
                    @if (isOpen)
                    {
                        <a href="/purchasing?edit=@order.Id&amp;focus=charges" class="rounded-lg bg-sky-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-sky-700">Sửa chi phí</a>
                    }
                </div>
                <p class="mt-1 text-xs leading-5 text-slate-600">Mỗi khoản chi phí của container thuộc một nhóm. <b>Điều chỉnh trị giá hải quan</b> (cước biển, bảo hiểm) cộng vào trị giá tính thuế. <b>Logistics</b> (THC, D/O, kiểm định, kéo xe) cộng thẳng vào giá vốn. <b>Thuế không được khấu trừ</b> cộng vào giá vốn. <b>Thuế được khấu trừ</b> không vào giá vốn. Bản scan tờ khai và hóa đơn đính kèm ở mục "Chứng từ đính kèm" bên dưới.</p>
                @if (ungrouped > 0)
                {
                    <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs font-medium text-amber-800" role="alert">Có @ungrouped khoản chưa gán nhóm (dữ liệu cũ). Bấm "Sửa chi phí" để chọn nhóm; khoản chưa gán nhóm không được tính vào giá vốn và chặn việc nhập kho.</p>
                }
                <div class="mt-3 space-y-2 text-sm">
                    <div class="flex items-start justify-between gap-3 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
                        <div>
                            <p class="font-medium text-slate-900">Thuế nhập khẩu theo từng mặt hàng</p>
                            <p class="text-xs text-slate-500">Trị giá hải quan × suất thuế của từng mặt hàng</p>
                        </div>
                        <span class="tabular-nums font-bold text-slate-900">@VndMoney.FormatDong(totalDuty)</span>
                    </div>
                    @if (totalOtherTaxes > 0)
                    {
                        <div class="flex items-start justify-between gap-3 rounded-lg border border-slate-100 bg-slate-50 px-4 py-3">
                            <div>
                                <p class="font-medium text-slate-900">Thuế bổ sung, tiêu thụ đặc biệt, môi trường</p>
                                <p class="text-xs text-slate-500">Không được khấu trừ, tính vào giá vốn</p>
                            </div>
                            <span class="tabular-nums font-bold text-slate-900">@VndMoney.FormatDong(totalOtherTaxes)</span>
                        </div>
                    }
                    @foreach (var charge in order.Charges)
                    {
                        var methodName = charge.Method switch
                        {
                            ChargeSplitMethod.FobValue => "Theo trị giá FOB",
                            ChargeSplitMethod.Quantity => "Theo số lượng",
                            ChargeSplitMethod.Weight => "Theo cân nặng",
                            ChargeSplitMethod.Volume => "Theo thể tích",
                            _ => "Nhập tay"
                        };
                        var groupName = charge.Group switch
                        {
                            ChargeGroup.Logistics => "Logistics",
                            ChargeGroup.CustomsValueAdjustment => "Điều chỉnh trị giá hải quan",
                            ChargeGroup.DeductibleTax => "Thuế được khấu trừ",
                            ChargeGroup.NonDeductibleTax => "Thuế không được khấu trừ",
                            _ => "Chưa gán nhóm"
                        };
                        <div class="rounded-lg border @(charge.Group is null ? "border-amber-300 bg-amber-50" : "border-slate-100 bg-slate-50") px-4 py-3">
                            <div class="flex items-start justify-between gap-3">
                                <div>
                                    <p class="font-medium text-slate-900">@(string.IsNullOrWhiteSpace(charge.Label) ? "Khoản chi phí container" : charge.Label)</p>
                                    <p class="text-xs text-slate-500">@groupName · @methodName</p>
                                </div>
                                <span class="tabular-nums font-bold text-slate-900">@VndMoney.FormatDong(charge.Amount)</span>
                            </div>
                        </div>
                    }
                </div>

                @if (order.Charges.Count > 0 && order.Lines.Count > 0)
                {
                    @* Bảng phân bổ: mỗi khoản chi phí được chia bao nhiêu cho từng mặt hàng, để kế toán đối chiếu. *@
                    <details class="mt-3 rounded-lg border border-slate-200 p-4" open>
                        <summary class="cursor-pointer text-sm font-bold text-sky-700">Bảng phân bổ chi phí cho từng mặt hàng</summary>
                        <div class="mt-3 max-w-full overflow-x-auto">
                            <table class="min-w-full whitespace-nowrap text-xs">
                                <thead class="text-right font-bold text-slate-600">
                                    <tr class="border-b border-slate-200">
                                        <th class="py-2 pr-3 text-left">Khoản chi phí</th>
                                        <th class="py-2 pr-3 text-left">Cách chia</th>
                                        <th class="py-2 pr-3">Số tiền</th>
                                        @foreach (var column in order.Lines)
                                        {
                                            <th class="py-2 pr-3 font-mono" title="@column.ItemName">@column.ItemCode</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody class="text-right tabular-nums">
                                    @foreach (var charge in order.Charges)
                                    {
                                        <tr class="border-b border-slate-100">
                                            <td class="py-1.5 pr-3 text-left">@(string.IsNullOrWhiteSpace(charge.Label) ? "Khoản chi phí container" : charge.Label)<span class="block text-slate-500">@(charge.Group switch { ChargeGroup.Logistics => "Logistics", ChargeGroup.CustomsValueAdjustment => "Trị giá hải quan", ChargeGroup.DeductibleTax => "Thuế khấu trừ", ChargeGroup.NonDeductibleTax => "Thuế không khấu trừ", _ => "Chưa gán nhóm" })</span></td>
                                            <td class="py-1.5 pr-3 text-left">@(charge.Method switch { ChargeSplitMethod.FobValue => "Theo trị giá FOB", ChargeSplitMethod.Quantity => "Bình quân theo số lượng", ChargeSplitMethod.Weight => "Theo khối lượng", ChargeSplitMethod.Volume => "Theo thể tích", _ => "Nhập tay" })</td>
                                            <td class="py-1.5 pr-3 font-medium">@VndMoney.FormatDong(charge.Amount)</td>
                                            @foreach (var column in order.Lines)
                                            {
                                                <td class="py-1.5 pr-3">@VndMoney.FormatDong(charge.Shares.Where(share => share.LineId == column.Id).Sum(share => share.Amount))</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="text-right font-bold tabular-nums">
                                    <tr class="border-t-2 border-slate-300">
                                        <td class="py-2 pr-3 text-left" colspan="2">Tổng</td>
                                        <td class="py-2 pr-3">@VndMoney.FormatDong(order.Charges.Sum(charge => charge.Amount))</td>
                                        @foreach (var column in order.Lines)
                                        {
                                            <td class="py-2 pr-3">@VndMoney.FormatDong(order.Charges.Sum(charge => charge.Shares.Where(share => share.LineId == column.Id).Sum(share => share.Amount)))</td>
                                        }
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </details>
                }

                <div class="mt-4 rounded-xl bg-slate-900 px-5 py-4 text-sm text-slate-300">
                    <div class="flex justify-between gap-3 py-1"><span>Tổng tiền hàng FOB (@order.Lines.Count mặt hàng quy đổi)</span><span class="tabular-nums">@VndMoney.FormatDong(totalFob)</span></div>
                    <div class="flex justify-between gap-3 py-1"><span>Tổng chi phí nhập khẩu &amp; logistics</span><span class="tabular-nums text-amber-300">@(totalExtra < 0 ? "−" : "+") @VndMoney.FormatDong(Math.Abs(totalExtra))</span></div>
                    <div class="mt-2 flex justify-between gap-3 border-t border-slate-700 pt-3 text-base font-bold text-emerald-300"><span>@(estimated ? "Dự toán giá vốn hàng nhập (chưa ghi nhận)" : "Giá vốn hàng nhập đã ghi nhận (Landed Total)")</span><span class="tabular-nums">@VndMoney.FormatDong(totalLanded)</span></div>
                    <div class="mt-3 flex justify-between gap-3 py-1"><span>@(order.VatDeductible ? "VAT đầu vào được khấu trừ (không vào giá vốn)" : "VAT đầu vào (không khấu trừ, đã nằm trong giá vốn)")</span><span class="tabular-nums">@VndMoney.FormatDong(totalVat)</span></div>
                    @if (deductibleCharges > 0)
                    {
                        <div class="flex justify-between gap-3 py-1"><span>Khoản thuế khấu trừ khác (không vào giá vốn)</span><span class="tabular-nums">@VndMoney.FormatDong(deductibleCharges)</span></div>
                    }
                    <div class="flex justify-between gap-3 py-1 font-bold text-white"><span>Tổng tiền thực chi cho container</span><span class="tabular-nums">@VndMoney.FormatDong(cashOut)</span></div>
                </div>

                @if (order.Adjustments is { Count: > 0 } adjustments)
                {
                    <section class="mt-6" aria-labelledby="adjustments-title">
                        <h3 id="adjustments-title" class="text-xs font-bold tracking-wide text-slate-500">ĐIỀU CHỈNH CHI PHÍ SAU KHI NHẬN (@adjustments.Count)</h3>
                        <div class="mt-2 overflow-x-auto">
                            <table class="min-w-full text-sm">
                                <thead class="text-left text-xs font-bold uppercase tracking-wide text-slate-500">
                                    <tr>
                                        <th class="py-2 pr-3">Khoản</th>
                                        <th class="py-2 pr-3">Số tiền</th>
                                        <th class="py-2 pr-3">Vào giá vốn hàng còn tồn</th>
                                        <th class="py-2 pr-3">Chênh lệch (hàng đã xuất)</th>
                                        <th class="py-2 pr-3">Lý do</th>
                                        <th class="py-2 pr-3">Ai, lúc nào</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var adjustment in adjustments)
                                    {
                                        <tr class="border-t border-slate-100 align-top">
                                            <td class="py-2 pr-3">@adjustment.Label</td>
                                            <td class="py-2 pr-3 tabular-nums">@VndMoney.FormatDong(adjustment.Amount)</td>
                                            <td class="py-2 pr-3 tabular-nums">@VndMoney.FormatDong(adjustment.AppliedToStock)</td>
                                            <td class="py-2 pr-3 tabular-nums">@VndMoney.FormatDong(adjustment.Variance)</td>
                                            <td class="py-2 pr-3">@adjustment.Reason</td>
                                            <td class="py-2 pr-3 text-xs text-slate-500">@adjustment.CreatedBy · @adjustment.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </section>
                }
                @if (Model.CanManage && order.Status == PurchaseStatus.Received)
                {
                    <details class="mt-3 rounded-lg border border-slate-200 p-4" id="adjust-cost">
                        <summary class="cursor-pointer text-sm font-bold text-sky-700">Ghi điều chỉnh chi phí (hóa đơn về muộn)</summary>
                        <p class="mt-2 text-xs leading-5 text-slate-600">Số tiền có dấu: dương làm tăng giá vốn, âm làm giảm. Khoản này được chia cho các dòng đã nhận theo cách chọn; phần ứng với hàng còn trong kho cộng vào giá vốn bình quân, phần ứng với hàng đã xuất được ghi là chênh lệch và không sửa ngược.</p>
                        <form method="post" asp-page-handler="AdjustCost" class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-4" data-confirm data-confirm-title="Ghi điều chỉnh chi phí" data-confirm-message="Giá vốn của hàng còn tồn sẽ đổi." data-confirm-label="Ghi điều chỉnh">
                            <input type="hidden" name="orderId" value="@order.Id" />
                            <label class="text-sm">Tên khoản<input name="label" required maxlength="200" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
                            <label class="text-sm">Số tiền (VNĐ, có dấu)<input name="amount" required inputmode="numeric" pattern="-?[0-9]+" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
                            <label class="text-sm">Cách chia
                                <select name="method" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
                                    <option value="@((int)ChargeSplitMethod.FobValue)">Theo trị giá FOB</option>
                                    <option value="@((int)ChargeSplitMethod.Quantity)">Theo số lượng</option>
                                    <option value="@((int)ChargeSplitMethod.Weight)">Theo cân nặng</option>
                                    <option value="@((int)ChargeSplitMethod.Volume)">Theo thể tích</option>
                                </select>
                            </label>
                            <label class="text-sm">Lý do<input name="reason" required maxlength="500" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
                            <div class="md:col-span-4"><button type="submit" class="rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white">Ghi điều chỉnh</button></div>
                        </form>
                    </details>
                }
                }

                <section class="mt-6" aria-labelledby="attachments-title">
                    <h3 id="attachments-title" class="text-xs font-bold tracking-wide text-slate-500">CHỨNG TỪ ĐÍNH KÈM (@Model.Attachments.Count)</h3>
                    <p class="mt-1 text-xs leading-5 text-slate-600">Đính kèm bản scan tờ khai hải quan, hóa đơn nhà cung cấp, vận đơn (B/L), packing list, hóa đơn phí logistics. Nhận @AttachmentRules.AllowedExtensionsText, tối đa 10 MB mỗi file, 30 file mỗi đơn. Admin, Giám đốc, Kế toán đính kèm và xóa chứng từ; kho tải được mọi file của đơn về kho mình.</p>
                    @if (Model.Attachments.Count > 0)
                    {
                        <ul class="mt-3 divide-y divide-slate-100 rounded-lg border border-slate-200 text-sm">
                            @foreach (var file in Model.Attachments)
                            {
                                <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
                                    <div class="min-w-0">
                                        <a href="/purchasing?handler=Download&amp;id=@file.Id" class="break-all font-medium text-sky-700 hover:underline">@file.FileName</a>
                                        <p class="text-xs text-slate-500">@(file.Kind switch
                                        {
                                            AttachmentKind.CustomsDeclaration => "Tờ khai hải quan",
                                            AttachmentKind.SupplierInvoice => "Hóa đơn nhà cung cấp",
                                            AttachmentKind.BillOfLading => "Vận đơn (B/L)",
                                            AttachmentKind.PackingList => "Packing list",
                                            AttachmentKind.LogisticsInvoice => "Hóa đơn phí logistics",
                                            _ => "Khác"
                                        }) · @(file.SizeBytes >= 1048576 ? (file.SizeBytes / 1048576m).ToString("0.#", CultureInfo.GetCultureInfo("vi-VN")) + " MB" : Math.Max(1, file.SizeBytes / 1024).ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) + " KB") · @file.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") @(string.IsNullOrEmpty(file.UploadedBy) ? "" : "· " + file.UploadedBy)</p>
                                    </div>
                                    @if (Model.CanManage && Pancras.Web.Pages.Purchasing.IndexModel.IsEditable(order.Status))
                                    {
                                        <form method="post" asp-page-handler="DeleteAttachment" data-confirm data-confirm-title="Xóa chứng từ" data-confirm-message="Xóa chứng từ này?" data-confirm-label="Xóa" data-confirm-tone="danger">
                                            <input type="hidden" name="orderId" value="@order.Id" />
                                            <input type="hidden" name="attachmentId" value="@file.Id" />
                                            <button type="submit" class="text-xs font-bold text-rose-600 hover:underline">Xóa</button>
                                        </form>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="mt-3 rounded-lg border border-dashed border-slate-300 px-4 py-3 text-sm text-slate-500">Chưa có chứng từ đính kèm.</p>
                    }
                    @if (Model.CanManage)
                    {
                    <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="mt-3 flex flex-wrap items-end gap-3">
                        <input type="hidden" name="orderId" value="@order.Id" />
                        <label class="text-xs">Loại chứng từ
                            <select name="kind" class="mt-1 block rounded-lg border border-slate-300 px-3 py-2 text-sm">
                                <option value="@((int)AttachmentKind.CustomsDeclaration)">Tờ khai hải quan</option>
                                <option value="@((int)AttachmentKind.SupplierInvoice)">Hóa đơn nhà cung cấp</option>
                                <option value="@((int)AttachmentKind.BillOfLading)">Vận đơn (B/L)</option>
                                <option value="@((int)AttachmentKind.PackingList)">Packing list</option>
                                <option value="@((int)AttachmentKind.LogisticsInvoice)">Hóa đơn phí logistics</option>
                                <option value="@((int)AttachmentKind.Other)">Khác</option>
                            </select>
                        </label>
                        <label class="text-xs">File
                            <input type="file" name="file" required accept=".pdf,.jpg,.jpeg,.png,.xlsx,.docx" class="mt-1 block max-w-xs text-sm" />
                        </label>
                        <button type="submit" class="rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white">Đính kèm</button>
                    </form>
                    }
                </section>

                @if (order.Events is { Count: > 0 } events)
                {
                    <section class="mt-6" aria-labelledby="history-title" id="order-history">
                        <h3 id="history-title" class="text-xs font-bold tracking-wide text-slate-500">LỊCH SỬ ĐƠN</h3>
                        <ol class="mt-2 space-y-2 border-l-2 border-slate-200 pl-4 text-sm">
                            @foreach (var step in events.OrderBy(item => item.OccurredAt))
                            {
                                <li>
                                    <p class="font-medium text-slate-900">@Pancras.Web.Pages.Purchasing.IndexModel.EventLabel(step.Kind)</p>
                                    <p class="text-xs text-slate-500">@step.OccurredAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(string.IsNullOrEmpty(step.ActorCode) ? "" : " · " + step.ActorCode)@(string.IsNullOrWhiteSpace(step.Note) ? "" : " · " + step.Note)</p>
                                </li>
                            }
                        </ol>
                    </section>
                }
            </section>
        }
    </div>
}
</div>

@if (Model.ShowForm)
{
    <dialog id="purchase-dialog" class="m-auto w-[min(72rem,calc(100%-2rem))] max-h-[calc(100%-2rem)] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/50 open:flex">
        <div class="flex shrink-0 items-center justify-between gap-3 border-b border-slate-200 bg-white px-5 py-4 sm:px-6">
            <h2 class="text-lg font-bold text-slate-900">@(Model.EditingId is null ? "Lập Phiếu Mua Hàng & Container Nhập Khẩu (Nhiều Mặt Hàng)" : "Sửa Đơn Mua Hàng (chưa nhập kho)")</h2>
            <a href="/purchasing" data-leave class="grid h-8 w-8 shrink-0 place-items-center rounded-lg text-2xl leading-none text-slate-400 hover:bg-slate-100 hover:text-slate-700" aria-label="Đóng">×</a>
        </div>
        <form method="post" asp-page-handler="@(Model.EditingId is null ? "Create" : "Update")" id="purchase-draft" class="min-h-0 flex-1 overflow-y-auto px-5 py-5 sm:px-6">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p id="form-error" class="mb-3 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800" role="alert">@Model.ErrorMessage</p>
            }
            @if (Model.EditingId is Guid editingId)
            {
                <input type="hidden" name="orderId" value="@editingId" />
                <input type="hidden" asp-for="Form.Version" />
                <p class="rounded-lg border border-sky-200 bg-sky-50 px-3 py-2 text-xs text-sky-900">Sửa mặt hàng, giá, tỷ giá, thuế sẽ tự chia lại các khoản chi phí của container. Thêm, sửa, xóa khoản chi phí ngay trong bảng "Chi phí chung của cả đơn" bên dưới.</p>
            }
            @if (Model.Suppliers.Count == 0 || Model.Locations.Count == 0 || Model.Items.Count == 0)
            {
                <p class="mt-3 text-sm text-amber-800">Cần có nhà cung cấp, địa điểm kho và mặt hàng trong danh mục trước khi tạo đơn.</p>
            }
            <div class="mt-4 grid grid-cols-1 gap-3 md:grid-cols-3">
                <label class="text-sm">Mã đơn<input asp-for="Form.Code" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
                <label class="text-sm">Nhà cung cấp quốc tế
                    <select asp-for="Form.SupplierId" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
                        <option value="">Chọn nhà cung cấp</option>
                        @foreach (var supplier in Model.Suppliers)
                        {
                            <option value="@supplier.Id">@supplier.Code — @supplier.Name</option>
                        }
                    </select>
                </label>
                <label class="text-sm">Kho tiếp nhận đích
                    <select asp-for="Form.ReceiveLocationId" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
                        <option value="">Chọn kho nhận</option>
                        @foreach (var location in Model.Locations)
                        {
                            <option value="@location.Id">@location.Name</option>
                        }
                    </select>
                </label>
                <label class="flex flex-col justify-between gap-1 text-sm">
                    <span>Tỷ giá (VNĐ / USD)</span>
                    <span class="relative block">
                        <input name="Form.ExchangeRate" value="@Model.Form.ExchangeRate.ToString("0", CultureInfo.InvariantCulture)" id="rate" inputmode="numeric" class="vnd draft w-full rounded-lg border border-slate-300 py-2 pl-3 pr-8" />
                        <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-500">VNĐ</span>
                    </span>
                </label>
                <label class="text-sm">Số hiệu Container<input asp-for="Form.ContainerNumber" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
                <label class="text-sm">Số Vận đơn (Bill of Lading)<input asp-for="Form.BillOfLading" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
                <label class="text-sm">Cảng Đến Tiếp Nhận<input asp-for="Form.Port" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
                <label class="text-sm">Ngày Dự Kiến Cập Cảng (ETA)<input asp-for="Form.ExpectedOn" type="date" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2" /></label>
            </div>

            <div class="mt-6 flex flex-wrap items-end justify-between gap-3">
                <div>
                    <h3 class="text-sm font-bold text-slate-900">DANH SÁCH CÁC MẶT HÀNG ĐẶT MUA TRONG CONTAINER (<span id="line-count">0</span> MẶT HÀNG)</h3>
                    <p class="mt-1 max-w-3xl text-xs leading-5 text-slate-500">@costNote</p>
                </div>
                <button type="button" id="add-line" class="text-sm font-bold text-sky-700">+ Thêm Mặt Hàng Nhập</button>
            </div>
            <div class="mt-3 overflow-x-auto">
                @* Chỉ các ô nhập và một kết quả (giá vốn / đơn vị). Các bước tính trung gian nằm ở "Bảng kiểm tra tính giá vốn" bên dưới, không lặp lại ở đây. *@
                <table class="min-w-[46rem] w-full text-sm">
                    <thead class="text-left text-xs font-bold text-slate-500">
                        <tr>
                            <th class="py-2 pr-2">Sản phẩm / Thiết bị</th>
                            <th class="py-2 pr-2">Số lượng</th>
                            <th class="py-2 pr-2">Đơn giá FOB (USD)</th>
                            <th class="py-2 pr-2">Thuế NK %</th>
                            <th class="py-2 pr-2" title="Thuế bổ sung, tiêu thụ đặc biệt, môi trường (tổng). Không khấu trừ nên tính vào giá vốn.">Thuế khác (VNĐ)</th>
                            <th class="py-2 pr-2 text-right">Giá vốn / đơn vị</th>
                            <th class="py-2"></th>
                        </tr>
                    </thead>
                    <tbody id="line-body">
                        @for (var index = 0; index < Model.Form.Lines.Count; index++)
                        {
                            var line = Model.Form.Lines[index];
                            var unitPrice = index < Model.Form.UnitPrices.Count ? Model.Form.UnitPrices[index] : 0m;
                            var dutyPercent = index < Model.Form.DutyPercents.Count ? Model.Form.DutyPercents[index] : 0m;
                            <tr class="line-row border-t border-slate-100">
                                <td class="py-2 pr-2">
                                    <input type="hidden" class="line-id" name="Form.Lines[@index].LineId" value="@(line.LineId?.ToString() ?? "")" />
                                    <select name="Form.Lines[@index].CatalogItemId" class="w-64 rounded-lg border border-slate-300 px-2 py-2">
                                        <option value="">Chọn mặt hàng</option>
                                        @foreach (var item in Model.Items)
                                        {
                                            Model.ItemMeasures.TryGetValue(item.Id, out var measure);
                                            @* Cân nặng/thể tích để bản xem thử chia chi phí theo khối lượng/thể tích đúng như máy chủ. *@
                                            <option value="@item.Id" data-code="@item.Code" data-weight="@(measure?.WeightKg?.ToString("0.####", CultureInfo.InvariantCulture))" data-volume="@(measure?.VolumeM3?.ToString("0.#####", CultureInfo.InvariantCulture))" selected="@(item.Id == line.CatalogItemId)">@item.Code — @item.Name</option>
                                        }
                                    </select>
                                </td>
                                <td class="py-2 pr-2"><input name="Form.Lines[@index].Quantity" value="@line.Quantity.ToString(CultureInfo.InvariantCulture)" class="line-qty draft w-20 rounded-lg border border-slate-300 px-2 py-2" /></td>
                                <td class="py-2 pr-2"><input name="Form.UnitPrices[@index]" value="@unitPrice.ToString("0.####", CultureInfo.InvariantCulture)" class="line-unit draft w-24 rounded-lg border border-slate-300 px-2 py-2" /></td>
                                <td class="py-2 pr-2"><input name="Form.DutyPercents[@index]" value="@dutyPercent.ToString("0.####", CultureInfo.InvariantCulture)" class="line-duty draft w-16 rounded-lg border border-amber-200 bg-amber-50 px-2 py-2" /></td>
                                <td class="py-2 pr-2"><input name="Form.Lines[@index].SupplementalDuty" value="@line.SupplementalDuty.ToString("0", CultureInfo.InvariantCulture)" inputmode="numeric" class="line-other draft w-28 rounded-lg border border-slate-300 px-2 py-2" /></td>
                                <td class="out-unit py-2 pr-2 text-right font-bold tabular-nums">0 VNĐ</td>
                                <td class="py-2 text-right">
                                    <button type="button" class="remove-line rounded-lg p-2 text-slate-400 hover:bg-rose-50 hover:text-rose-600" aria-label="Xóa mặt hàng" title="Xóa mặt hàng">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-9 0 1 12h8l1-12" />
                                        </svg>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <section id="charge-section" class="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <h3 class="text-sm font-bold text-slate-900">CHI PHÍ CHUNG CỦA CẢ ĐƠN</h3>
                    <p class="text-sm font-bold">Tổng chi phí chung: <span id="sum-charges">0 VNĐ</span></p>
                </div>
                <p class="mt-1 text-xs leading-5 text-slate-600">Mỗi dòng là một khoản chi phí của cả container (không thuộc riêng mặt hàng nào), nhập số tiền <b>chưa gồm VAT của hóa đơn dịch vụ</b>. Chọn <b>Nhóm</b> và <b>Cách chia</b> cho từng dòng, hệ thống chia cho các mặt hàng và hiện kết quả ở bảng kiểm tra bên dưới. Không có khoản nào thì để số tiền 0 hoặc xóa dòng.</p>
                <p class="mt-1 text-xs leading-5 text-slate-600">Gợi ý cách chia: cước biển, kéo xe theo thể tích hoặc khối lượng; bảo hiểm, kiểm định theo trị giá; khoản chung nhỏ theo số lượng.</p>
                @* Thứ tự nhập: mặt hàng và số lượng trước, chi phí chung sau. Chưa có mặt hàng đủ số lượng và đơn giá thì khóa
                   (inert: không bấm/nhập được nhưng vẫn gửi cùng form, nên không làm mất các khoản đã có khi sửa đơn). *@
                <p id="charge-lock-note" class="mt-3 rounded-lg border border-amber-300 bg-white px-3 py-2 text-sm font-medium text-amber-900">Nhập mặt hàng, số lượng và đơn giá FOB ở bảng phía trên trước, rồi mới nhập chi phí chung.</p>
                <div id="charge-area">
                <div class="mt-3 overflow-x-auto">
                    <table class="min-w-[52rem] w-full text-sm">
                        <thead class="text-left text-xs font-bold text-slate-600">
                            <tr>
                                <th class="py-2 pr-2">Tên khoản chi phí</th>
                                <th class="py-2 pr-2">Số tiền (VNĐ)</th>
                                <th class="py-2 pr-2">Nhóm</th>
                                <th class="py-2 pr-2">Cách chia cho các mặt hàng</th>
                                <th class="py-2"></th>
                            </tr>
                        </thead>
                        <tbody id="charge-body">
                            @for (var chargeIndex = 0; chargeIndex < Model.Form.Charges.Count; chargeIndex++)
                            {
                                <partial name="_ChargeRow" model="new ChargeRowView(Model.Form.Charges[chargeIndex], chargeIndex.ToString(CultureInfo.InvariantCulture))" />
                            }
                        </tbody>
                        <tfoot>
                            <tr class="border-t-2 border-amber-300 bg-amber-100/60 align-top">
                                <td class="py-2 pr-2">
                                    <p class="font-medium text-slate-900">VAT hàng nhập khẩu (tự tính)</p>
                                    <p class="text-xs text-slate-600">= (trị giá hải quan + thuế NK + thuế khác) × suất VAT</p>
                                </td>
                                <td class="py-2 pr-2 text-right text-base font-bold tabular-nums text-slate-900"><span id="vat-amount">0 VNĐ</span></td>
                                <td class="py-2 pr-2">
                                    <label class="block text-xs text-slate-600">Suất VAT
                                        <span class="relative mt-1 block">
                                            <input name="Form.VatPercent" value="@Model.Form.VatPercent.ToString("0.####", CultureInfo.InvariantCulture)" id="vat-percent" inputmode="decimal" class="draft w-full rounded-lg border border-slate-300 bg-white py-2 pl-3 pr-9 text-sm text-slate-900" />
                                            <span class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-sm text-slate-500">%</span>
                                        </span>
                                    </label>
                                </td>
                                <td class="py-2 pr-2">
                                    <label class="flex items-start gap-2 text-sm text-slate-800">
                                        <input asp-for="Form.VatDeductible" id="vat-deductible" type="checkbox" class="draft mt-1" />
                                        <span>VAT đầu vào được khấu trừ <span class="block text-xs text-slate-600">Tắt (mặc định): VAT cộng vào giá vốn. Bật: VAT không vào giá vốn.</span></span>
                                    </label>
                                </td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <button type="button" id="add-charge" class="mt-2 text-sm font-bold text-sky-700">+ Thêm dòng chi phí</button>
                <details class="mt-3 rounded-lg border border-amber-200 bg-white p-3 text-xs leading-5 text-slate-700">
                    <summary class="cursor-pointer font-bold text-slate-900">Các nhóm chi phí nghĩa là gì?</summary>
                    <ul class="mt-2 list-disc space-y-1 pl-5">
                        <li><b>Trị giá hải quan</b> (cước biển, bảo hiểm): cộng vào trị giá tính thuế, nên làm tăng thuế nhập khẩu và VAT, rồi vào giá vốn.</li>
                        <li><b>Logistics</b> (THC, D/O, kiểm định, kéo xe): cộng thẳng vào giá vốn, không tính thuế nhập khẩu.</li>
                        <li><b>Thuế không khấu trừ</b>: khoản thuế không được khấu trừ, tính vào giá vốn.</li>
                        <li><b>Thuế khấu trừ</b> (ví dụ VAT của hóa đơn dịch vụ): không vào giá vốn nhưng vẫn là tiền phải trả, được cộng vào tổng thực chi.</li>
                    </ul>
                </details>
                <template id="charge-template">
                    <partial name="_ChargeRow" model='new ChargeRowView(new ChargeRowInput(), "__i__")' />
                </template>
                </div>
            </section>

            @* Thu gọn mặc định để form không quá dài; mở ra khi kế toán cần đối chiếu từng bước. Kết quả chính luôn hiện ở thanh dưới cùng. *@
            <details id="check-details" class="mt-5 rounded-xl border border-slate-200 p-4">
                <summary id="check-title" class="cursor-pointer text-sm font-bold text-slate-900">BẢNG KIỂM TRA TÍNH GIÁ VỐN (để đối chiếu) <span class="font-normal text-sky-700">· bấm để mở / thu gọn</span></summary>
                <p class="mt-2 text-xs leading-5 text-slate-600">Từng bước tính cho mỗi mặt hàng, cập nhật ngay khi nhập. ③ = ① + ② · ④ = ③ × thuế NK % · ⑥ = ③ + ④ + ⑤ · ⑦ = ⑥ × suất VAT · ⑨ = ③ + ④ + ⑤ + ⑧ (+ ⑦ nếu VAT không khấu trừ) · ⑩ = ⑨ ÷ số lượng. Rê chuột vào tiêu đề cột để xem giải thích. Phần dư làm tròn đồng của mỗi khoản chia dồn về mặt hàng cuối.</p>
                <div class="mt-3 overflow-x-auto">
                    <table class="min-w-[66rem] w-full text-xs">
                        <thead class="text-right font-bold text-slate-600">
                            <tr class="border-b border-slate-200">
                                <th class="py-2 pr-2 text-left">Mặt hàng</th>
                                <th class="py-2 pr-2">SL</th>
                                <th class="py-2 pr-2" title="Số lượng × đơn giá USD × tỷ giá">① FOB quy đổi</th>
                                <th class="py-2 pr-2" title="Các khoản nhóm Trị giá hải quan được chia cho mặt hàng">② Cước / bảo hiểm</th>
                                <th class="py-2 pr-2">③ Trị giá hải quan</th>
                                <th class="py-2 pr-2">④ Thuế NK</th>
                                <th class="py-2 pr-2">⑤ Thuế khác</th>
                                <th class="py-2 pr-2">⑥ Giá tính VAT</th>
                                <th class="py-2 pr-2">⑦ VAT</th>
                                <th class="py-2 pr-2" title="Các khoản nhóm Logistics và nhóm Thuế không khấu trừ được chia cho mặt hàng">⑧ Logistics &amp; thuế không khấu trừ</th>
                                <th class="py-2 pr-2">⑨ Giá vốn dòng</th>
                                <th class="py-2">⑩ Giá vốn / đơn vị</th>
                            </tr>
                        </thead>
                        <tbody id="check-body" class="text-right tabular-nums"></tbody>
                        <tfoot id="check-foot" class="text-right font-bold tabular-nums"></tfoot>
                    </table>
                </div>
            </details>

            <div class="mt-4 rounded-xl bg-slate-900 px-5 py-4 text-sm text-slate-300">
                <div class="flex justify-between gap-3 py-0.5"><span>Tổng tiền hàng FOB quy đổi</span><span class="tabular-nums" id="t-fob">0 VNĐ</span></div>
                <div class="flex justify-between gap-3 py-0.5"><span>Cước biển / bảo hiểm (nhóm trị giá hải quan)</span><span class="tabular-nums" id="t-adj">0 VNĐ</span></div>
                <div class="flex justify-between gap-3 py-0.5"><span>Thuế nhập khẩu</span><span class="tabular-nums" id="t-duty">0 VNĐ</span></div>
                <div class="flex justify-between gap-3 py-0.5"><span>Thuế khác không khấu trừ</span><span class="tabular-nums" id="t-other">0 VNĐ</span></div>
                <div class="flex justify-between gap-3 py-0.5"><span>Logistics (THC, D/O, kiểm định, kéo xe...)</span><span class="tabular-nums" id="t-log">0 VNĐ</span></div>
                <div class="flex justify-between gap-3 py-0.5"><span>Khoản thuế không khấu trừ khác</span><span class="tabular-nums" id="t-nonded">0 VNĐ</span></div>
                <div class="flex justify-between gap-3 py-0.5"><span id="t-vatcost-label">VAT tính vào giá vốn</span><span class="tabular-nums" id="t-vatcost">0 VNĐ</span></div>
                <div class="mt-2 flex justify-between gap-3 border-t border-slate-700 pt-2 text-base font-bold text-emerald-300"><span>Giá vốn hàng nhập</span><span class="tabular-nums" id="t-landed">0 VNĐ</span></div>
                <div class="mt-2 flex justify-between gap-3 py-0.5"><span>VAT được khấu trừ (không vào giá vốn)</span><span class="tabular-nums" id="t-vatded">0 VNĐ</span></div>
                <div class="flex justify-between gap-3 py-0.5"><span>Khoản thuế khấu trừ khác (không vào giá vốn)</span><span class="tabular-nums" id="t-ded">0 VNĐ</span></div>
                <div class="mt-1 flex justify-between gap-3 font-bold text-white"><span>Tổng tiền thực chi cho container (gồm VAT nộp khi thông quan)</span><span class="tabular-nums" id="sum-order">0 VNĐ</span></div>
            </div>
            @* Thanh dưới cố định: kết quả chính và nút Lưu luôn thấy được, không phải cuộn tới cuối form. *@
            <div class="sticky -bottom-5 z-10 -mx-5 -mb-5 mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-200 bg-white px-5 py-3 sm:-mx-6 sm:px-6">
                <p class="text-sm text-slate-600">Giá vốn hàng nhập <strong id="f-landed" class="text-base text-emerald-700">0 VNĐ</strong> <span class="mx-1 text-slate-300">|</span> Tổng thực chi <strong id="f-cash" class="text-base text-slate-900">0 VNĐ</strong></p>
                <div class="flex gap-2">
                    <a href="/purchasing" data-leave class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-medium text-slate-600">Hủy</a>
                    <button type="submit" class="rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white">@(Model.EditingId is null ? "Lưu Đơn Mua Hàng & Container" : "Lưu thay đổi")</button>
                </div>
            </div>
        </form>
    </dialog>
    <script>
        (function () {
            document.getElementById("purchase-dialog")?.showModal();
            // Đóng bằng Esc không đổi địa chỉ: bỏ ?form=1 để tải lại trang không mở lại hộp thoại.
            document.getElementById("purchase-dialog")?.addEventListener("close", () => {
                if (location.pathname === "/purchasing" && location.search.includes("form=1")) {
                    history.replaceState(null, "", "/purchasing");
                }
            });
            const lineBody = document.getElementById("line-body");
            const chargeBody = document.getElementById("charge-body");
            const money = new Intl.NumberFormat("vi-VN");
            const dong = (value) => money.format(Math.round(value)) + " VNĐ";
            const roundDong = (value) => Math.sign(value) * Math.round(Math.abs(value));
            const plainNumber = (input) => {
                if (input.classList.contains("vnd")) {
                    const digits = String(input.value).replace(/\D/g, "");
                    return digits === "" ? 0 : Number(digits);
                }

                const value = Number(String(input.value).trim().replace(",", "."));
                return Number.isFinite(value) ? value : 0;
            };
            const text = (id, value) => { document.getElementById(id).textContent = value; };
            const lineTemplate = lineBody.querySelector(".line-row")?.cloneNode(true) ?? null;
            const chargeTemplate = document.getElementById("charge-template");

            // Mã nhóm và cách chia trùng với ChargeGroup / ChargeSplitMethod ở máy chủ.
            const GROUP_ADJUST = 1, GROUP_LOGISTICS = 2, GROUP_DEDUCTIBLE = 3, GROUP_NONDEDUCTIBLE = 4;
            const BY_FOB = 1, BY_QUANTITY = 2, BY_WEIGHT = 3, BY_VOLUME = 4, BY_MANUAL = 5;

            function formatVndInputs() {
                document.querySelectorAll(".vnd").forEach((input) => {
                    const formatted = money.format(plainNumber(input));
                    if (input.value !== formatted) {
                        input.value = formatted;
                    }
                });
            }

            function reindexLines() {
                [...lineBody.querySelectorAll(".line-row")].forEach((row, index) => {
                    row.querySelector("select").name = `Form.Lines[${index}].CatalogItemId`;
                    row.querySelector(".line-qty").name = `Form.Lines[${index}].Quantity`;
                    row.querySelector(".line-unit").name = `Form.UnitPrices[${index}]`;
                    row.querySelector(".line-duty").name = `Form.DutyPercents[${index}]`;
                    row.querySelector(".line-other").name = `Form.Lines[${index}].SupplementalDuty`;
                    row.querySelector(".line-id").name = `Form.Lines[${index}].LineId`;
                });
            }

            function reindexCharges() {
                [...chargeBody.querySelectorAll(".charge-row")].forEach((row, index) => {
                    row.querySelectorAll("[name]").forEach((element) => {
                        element.name = element.name.replace(/^Form\.Charges\[[^\]]*\]/, `Form.Charges[${index}]`);
                    });
                });
            }

            // Chia theo đúng cách của máy chủ (ChargeAllocation.TrySplit): cắt bỏ phần lẻ, phần dư đồng dồn về dòng cuối.
            function split(amount, weights) {
                if (weights.length === 0 || weights.some((weight) => !(weight > 0))) {
                    return null;
                }

                const total = weights.reduce((sum, weight) => sum + weight, 0);
                const whole = roundDong(amount);
                const result = [];
                let used = 0;
                weights.forEach((weight, index) => {
                    const share = index === weights.length - 1 ? whole - used : Math.trunc(whole * weight / total);
                    used += share;
                    result.push(share);
                });
                return result;
            }

            function measuresOf(select) {
                const option = select.selectedOptions[0];
                const read = (name) => {
                    const raw = option?.dataset[name];
                    return raw === undefined || raw === "" ? null : Number(raw);
                };
                return { code: option?.dataset.code || option?.textContent?.split("—")[0]?.trim() || "?", weight: read("weight"), volume: read("volume") };
            }

            function paint() {
                formatVndInputs();
                const rate = roundDong(plainNumber(document.getElementById("rate")));
                const vatRate = Math.round(plainNumber(document.getElementById("vat-percent")) * 100) / 10000;
                const deductible = document.getElementById("vat-deductible").checked;

                const lineRows = [...lineBody.querySelectorAll(".line-row")];
                lineRows.forEach((row) => {
                    const missingPrice = plainNumber(row.querySelector(".line-qty")) > 0 && plainNumber(row.querySelector(".line-unit")) <= 0;
                    row.querySelector(".line-unit").classList.toggle("border-rose-400", missingPrice);
                    row.querySelector(".line-unit").title = missingPrice ? "Đơn giá FOB phải lớn hơn 0" : "";
                });
                const drafts = lineRows.map((row) => {
                    const qty = plainNumber(row.querySelector(".line-qty"));
                    const usd = Math.round(plainNumber(row.querySelector(".line-unit")) * qty * 100) / 100;
                    const dutyRate = Math.round(plainNumber(row.querySelector(".line-duty")) * 100) / 10000;
                    const other = Math.max(0, roundDong(plainNumber(row.querySelector(".line-other"))));
                    const measure = measuresOf(row.querySelector("select"));
                    return { row, qty, usd, fob: roundDong(usd * rate), dutyRate, other, lineId: row.querySelector(".line-id").value, ...measure, adj: 0, log: 0, nonded: 0, ded: 0 };
                }).filter((line) => line.qty > 0 && line.usd > 0);

                // Chi phí chung chỉ nhập được sau khi có ít nhất một mặt hàng đủ số lượng và đơn giá.
                const hasLines = drafts.length > 0;
                const chargeArea = document.getElementById("charge-area");
                chargeArea.inert = !hasLines;
                chargeArea.classList.toggle("opacity-50", !hasLines);
                document.getElementById("charge-lock-note").hidden = hasLines;

                // Dòng mẫu còn ở chế độ tự động: chia theo thể tích khi mọi mặt hàng đã có thể tích, nếu không thì theo trị giá FOB.
                const allHaveVolume = hasLines && drafts.every((line) => line.volume > 0);
                chargeBody.querySelectorAll('.charge-row[data-auto="1"]').forEach((row) => {
                    row.querySelector(".charge-method").value = String(allHaveVolume ? BY_VOLUME : BY_FOB);
                    row.querySelector(".charge-auto").textContent = allHaveVolume
                        ? "Tự động: theo thể tích (mọi mặt hàng đã có thể tích). Chọn tay để cố định."
                        : "Tự động: theo trị giá FOB vì có mặt hàng chưa có thể tích. Chọn tay để đổi.";
                });

                // Chia từng khoản chi phí cho các mặt hàng.
                let chargeSum = 0;
                [...chargeBody.querySelectorAll(".charge-row")].forEach((row) => {
                    const warn = row.querySelector(".charge-warn");
                    warn.textContent = "";
                    const amount = roundDong(plainNumber(row.querySelector(".charge-amount")));
                    if (amount <= 0 || drafts.length === 0) {
                        return;
                    }

                    chargeSum += amount;
                    const group = Number(row.querySelector(".charge-group").value);
                    const method = Number(row.querySelector(".charge-method").value);
                    let shares = null;
                    if (method === BY_MANUAL) {
                        let saved = {};
                        try { saved = JSON.parse(row.dataset.shares || "{}"); } catch { saved = {}; }
                        shares = drafts.map((line) => Number(saved[line.lineId] ?? 0));
                    } else {
                        let weights;
                        let missing = [];
                        if (method === BY_FOB) {
                            weights = drafts.map((line) => line.usd);
                        } else if (method === BY_QUANTITY) {
                            weights = drafts.map((line) => line.qty);
                        } else {
                            const key = method === BY_WEIGHT ? "weight" : "volume";
                            missing = drafts.filter((line) => !(line[key] > 0)).map((line) => line.code);
                            weights = drafts.map((line) => (line[key] ?? 0) * line.qty);
                        }

                        if (missing.length > 0) {
                            warn.textContent = `Thiếu ${method === BY_WEIGHT ? "khối lượng" : "thể tích"} ở Danh mục: ${[...new Set(missing)].join(", ")}. Chọn cách chia khác hoặc bổ sung số đo.`;
                        } else {
                            shares = split(amount, weights);
                        }
                    }

                    if (shares === null) {
                        return;
                    }

                    shares.forEach((share, index) => {
                        const line = drafts[index];
                        if (group === GROUP_ADJUST) { line.adj += share; }
                        else if (group === GROUP_LOGISTICS) { line.log += share; }
                        else if (group === GROUP_NONDEDUCTIBLE) { line.nonded += share; }
                        else if (group === GROUP_DEDUCTIBLE) { line.ded += share; }
                    });
                });

                // Tính từng bước cho từng mặt hàng.
                const total = { qty: 0, fob: 0, adj: 0, customs: 0, duty: 0, other: 0, vatBase: 0, vat: 0, extra: 0, landed: 0, log: 0, nonded: 0, ded: 0 };
                let html = "";
                lineRows.forEach((row) => {
                    row.querySelector(".out-unit").textContent = "0 VNĐ";
                });
                drafts.forEach((line) => {
                    const customs = line.fob + line.adj;
                    const duty = customs * line.dutyRate;
                    const vatBase = customs + duty + line.other;
                    const vat = vatBase * vatRate;
                    const extra = line.log + line.nonded;
                    const landed = customs + duty + line.other + extra + (deductible ? 0 : vat);
                    Object.assign(line, { customs, duty, vatBase, vat, extra, landed });
                    total.qty += line.qty; total.fob += line.fob; total.adj += line.adj; total.customs += customs; total.duty += duty;
                    total.other += line.other; total.vatBase += vatBase; total.vat += vat; total.extra += extra; total.landed += landed;
                    total.log += line.log; total.nonded += line.nonded; total.ded += line.ded;
                    line.row.querySelector(".out-unit").textContent = dong(line.qty === 0 ? 0 : landed / line.qty);
                    const cell = (value, extraClass = "") => `<td class="py-1.5 pr-2 ${extraClass}">${value}</td>`;
                    html += `<tr class="border-b border-slate-100">${cell(line.code, "text-left font-mono")}${cell(line.qty)}${cell(dong(line.fob))}${cell(dong(line.adj))}${cell(dong(customs))}${cell(dong(duty))}${cell(dong(line.other))}${cell(dong(vatBase))}${cell(dong(vat))}${cell(dong(extra))}${cell(dong(landed), "font-bold")}${cell(dong(landed / line.qty), "font-bold text-emerald-700")}</tr>`;
                });
                document.getElementById("check-body").innerHTML = html === ""
                    ? `<tr><td colspan="12" class="py-3 text-center text-slate-500">Chọn mặt hàng, nhập số lượng, đơn giá FOB (lớn hơn 0) và tỷ giá để xem bảng tính.</td></tr>`
                    : html;
                const foot = (value, extraClass = "") => `<td class="py-2 pr-2 ${extraClass}">${value}</td>`;
                document.getElementById("check-foot").innerHTML = drafts.length === 0 ? "" :
                    `<tr class="border-t-2 border-slate-300">${foot("Tổng", "text-left")}${foot(total.qty)}${foot(dong(total.fob))}${foot(dong(total.adj))}${foot(dong(total.customs))}${foot(dong(total.duty))}${foot(dong(total.other))}${foot(dong(total.vatBase))}${foot(dong(total.vat))}${foot(dong(total.extra))}${foot(dong(total.landed), "text-emerald-700")}${foot("")}</tr>`;

                // Tổng hợp.
                text("sum-charges", dong(chargeSum));
                text("vat-amount", dong(total.vat));
                text("t-fob", dong(total.fob));
                text("t-adj", dong(total.adj));
                text("t-duty", dong(total.duty));
                text("t-other", dong(total.other));
                text("t-log", dong(total.log));
                text("t-nonded", dong(total.nonded));
                text("t-vatcost-label", deductible ? "VAT tính vào giá vốn (đang tắt vì được khấu trừ)" : "VAT tính vào giá vốn");
                text("t-vatcost", dong(deductible ? 0 : total.vat));
                text("t-landed", dong(total.landed));
                text("t-vatded", dong(deductible ? total.vat : 0));
                text("t-ded", dong(total.ded));
                const cash = total.landed + (deductible ? total.vat : 0) + total.ded;
                text("sum-order", dong(cash));
                text("f-landed", dong(total.landed));
                text("f-cash", dong(cash));
                text("line-count", String(lineRows.length));
            }

            document.getElementById("add-line").addEventListener("click", () => {
                if (!lineTemplate) {
                    return;
                }

                const row = lineTemplate.cloneNode(true);
                row.querySelectorAll("input").forEach((input) => { input.value = "0"; });
                row.querySelector(".line-id").value = "";
                row.querySelector("select").selectedIndex = 0;
                lineBody.appendChild(row);
                reindexLines();
                paint();
            });
            lineBody.addEventListener("click", (event) => {
                const button = event.target.closest(".remove-line");
                if (!button) {
                    return;
                }

                button.closest(".line-row")?.remove();
                reindexLines();
                paint();
            });
            document.getElementById("add-charge").addEventListener("click", () => {
                const index = chargeBody.querySelectorAll(".charge-row").length;
                const holder = document.createElement("tbody");
                holder.innerHTML = chargeTemplate.innerHTML.replaceAll("__i__", String(index));
                const row = holder.querySelector("tr");
                chargeBody.appendChild(row);
                row.querySelector(".charge-label")?.focus();
                reindexCharges();
                paint();
            });
            chargeBody.addEventListener("click", (event) => {
                const button = event.target.closest(".remove-charge");
                if (!button) {
                    return;
                }

                button.closest(".charge-row")?.remove();
                reindexCharges();
                paint();
            });
            const form = document.getElementById("purchase-draft");
            form.addEventListener("input", paint);
            form.addEventListener("change", paint);
            // Người dùng tự chọn cách chia cho một dòng mẫu thì dừng tự động cho dòng đó.
            chargeBody.addEventListener("change", (event) => {
                if (event.isTrusted && event.target.classList.contains("charge-method")) {
                    const row = event.target.closest(".charge-row");
                    row.dataset.auto = "0";
                    row.querySelector(".charge-auto").textContent = "";
                }
            });

            // Cảnh báo khi rời form mà còn dữ liệu chưa lưu (đóng bằng ×, Hủy, hoặc tải lại trang).
            let dirty = false;
            form.addEventListener("input", () => { dirty = true; });
            form.addEventListener("submit", () => {
                dirty = false;
                document.querySelectorAll(".vnd").forEach((input) => {
                    input.value = String(plainNumber(input));
                });
            });
            window.addEventListener("beforeunload", (event) => {
                if (dirty) {
                    event.preventDefault();
                    event.returnValue = "";
                }
            });
            document.querySelectorAll("dialog a[data-leave]").forEach((link) => {
                link.addEventListener("click", (event) => {
                    if (!dirty) {
                        return;
                    }

                    event.preventDefault();
                    window.pancrasConfirm({
                        title: "Bỏ thay đổi",
                        message: "Bỏ các thay đổi chưa lưu?",
                        label: "Bỏ thay đổi",
                        tone: "danger",
                        onOk: () => {
                            dirty = false;
                            window.location.href = link.href;
                        }
                    });
                });
            });

            reindexLines();
            reindexCharges();
            paint();
            // Vào từ nút "Sửa chi phí" ở chi tiết đơn: cuộn thẳng tới phần chi phí chung.
            if (new URLSearchParams(location.search).get("focus") === "charges") {
                document.getElementById("charge-section")?.scrollIntoView({ block: "start" });
            }
        })();
    </script>
}

<dialog id="confirm-dialog" class="m-auto w-[min(30rem,calc(100%-2rem))] max-h-[calc(100%-2rem)] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/50 open:flex" aria-labelledby="confirm-title">
    <div class="flex shrink-0 items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
        <h2 id="confirm-title" class="text-base font-bold text-slate-900">Xác nhận</h2>
        <button type="button" id="confirm-close" class="grid h-8 w-8 place-items-center rounded-lg text-2xl leading-none text-slate-400 hover:bg-slate-100 hover:text-slate-700" aria-label="Đóng">×</button>
    </div>
    <div class="min-h-0 flex-1 space-y-3 overflow-y-auto px-5 py-4">
        <p id="confirm-message" class="text-sm text-slate-600"></p>
        <div id="confirm-reason-box" class="hidden">
            <label class="block text-sm font-medium text-slate-700" for="confirm-reason">Lý do
                <textarea id="confirm-reason" rows="3" maxlength="500" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></textarea>
            </label>
            <p id="confirm-reason-error" class="mt-1 hidden text-xs font-medium text-rose-700" role="alert">Cần nhập lý do.</p>
        </div>
    </div>
    <div class="flex shrink-0 justify-end gap-2 border-t border-slate-100 px-5 py-4">
        <button type="button" id="confirm-cancel" class="rounded-lg bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700">Quay lại</button>
        <button type="button" id="confirm-ok" class="rounded-lg bg-sky-600 px-4 py-2 text-sm font-bold text-white">Xác nhận</button>
    </div>
</dialog>
<script>
    (function () {
        const dialog = document.getElementById("confirm-dialog");
        const title = document.getElementById("confirm-title");
        const message = document.getElementById("confirm-message");
        const reasonBox = document.getElementById("confirm-reason-box");
        const reason = document.getElementById("confirm-reason");
        const reasonError = document.getElementById("confirm-reason-error");
        const ok = document.getElementById("confirm-ok");
        let pending = null;

        function closeDialog() {
            pending = null;
            reason.value = "";
            reasonError.classList.add("hidden");
            if (dialog.open) {
                dialog.close();
            }
        }

        window.pancrasConfirm = function (options) {
            pending = options;
            title.textContent = options.title || "Xác nhận";
            message.textContent = options.message || "";
            ok.textContent = options.label || "Xác nhận";
            ok.className = "rounded-lg px-4 py-2 text-sm font-bold text-white " + (options.tone === "danger" ? "bg-rose-600" : "bg-sky-600");
            reasonBox.classList.toggle("hidden", options.reason !== "required");
            reason.value = "";
            reasonError.classList.add("hidden");
            dialog.showModal();
            if (options.reason === "required") {
                reason.focus();
            }
        };

        document.addEventListener("submit", (event) => {
            const form = event.target;
            if (!(form instanceof HTMLFormElement) || !form.hasAttribute("data-confirm")) {
                return;
            }

            if (form.dataset.confirmed === "1") {
                if (form.dataset.sent === "1") {
                    event.preventDefault();
                } else {
                    form.dataset.sent = "1";
                }

                return;
            }

            event.preventDefault();
            const receiveForm = document.getElementById("receive-form");
            if (form === receiveForm) {
                const close = receiveForm.querySelector('input[name="closeOrder"]');
                const short = [...document.querySelectorAll("input[data-remaining]")].some((input) => Number(input.value) < Number(input.dataset.remaining));
                if (close instanceof HTMLInputElement && close.checked && short) {
                    receiveForm.dataset.reason = "required";
                } else {
                    delete receiveForm.dataset.reason;
                }
            }
            const submitter = event.submitter;
            const read = (name) => (submitter && submitter.dataset[name]) || form.dataset[name] || "";
            window.pancrasConfirm({
                title: read("confirmTitle"),
                message: read("confirmMessage"),
                label: read("confirmLabel"),
                tone: read("confirmTone"),
                reason: read("reason"),
                onOk: (text) => {
                    if (read("reason") === "required") {
                        const note = form.querySelector('input[name="note"]');
                        if (note) {
                            note.value = text;
                        }
                    }

                    form.dataset.confirmed = "1";
                    form.requestSubmit();
                }
            });
        }, true);

        ok.addEventListener("click", () => {
            if (!pending) {
                return;
            }

            const current = pending;
            const text = reason.value.trim();
            if (current.reason === "required" && !text) {
                reasonError.classList.remove("hidden");
                reason.focus();
                return;
            }

            closeDialog();
            current.onOk(text);
        });
        reason.addEventListener("input", () => reasonError.classList.add("hidden"));
        document.getElementById("confirm-cancel").addEventListener("click", closeDialog);
        document.getElementById("confirm-close").addEventListener("click", closeDialog);
        dialog.addEventListener("cancel", () => {
            pending = null;
            reason.value = "";
        });
    })();
</script>
