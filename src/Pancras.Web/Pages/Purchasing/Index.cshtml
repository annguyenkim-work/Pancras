@page "/purchasing"
@model Pancras.Web.Pages.Purchasing.IndexModel
@using System.Globalization
@using Pancras.Domain.Purchasing
@using Pancras.Web.Formatting
@{
    ViewData["Title"] = "Mua hàng & Container Nhập";
}

<section class="bg-white rounded-xl border border-slate-200 p-6">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
            <h1 class="font-display text-xl sm:text-2xl font-bold text-slate-900">Mua Hàng, Container Nhập Khẩu &amp; Phân Bổ Giá Vốn (Landed Cost)</h1>
            <p class="mt-1 text-sm text-slate-500">Hỗ trợ lập phiếu mua nhiều mặt hàng trong cùng 1 container, tự động phân bổ chi phí logistics và thuế nhập khẩu vào giá vốn từng sản phẩm.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            @if (Pancras.Web.Help.HelpTopics.Find(Pancras.Web.Help.HelpTopics.Purchasing) is { } help)
            {
                <partial name="_HelpButton" model="help" />
            }
            @if (Model.CanManage)
            {
                <a href="/purchasing?form=1" class="rounded-lg px-4 py-2 text-sm font-bold bg-sky-600 text-white hover:bg-sky-700 disabled:opacity-60">+ Tạo Đơn Mua Hàng &amp; Container</a>
            }
        </div>
    </div>
    @* Khi modal đang mở, lỗi hiện trong modal (bên dưới); hiện ở đây sẽ nằm sau lớp phủ và người dùng không thấy. *@
    @if (!string.IsNullOrEmpty(Model.ErrorMessage) && !Model.ShowForm)
    {
        <div class="mt-4"><partial name="_Notice" model="new NoticeModel(Model.ErrorMessage, ToastLevel.Error)" /></div>
    }
    @if (Model.HasAnyOrders)
    {
        <form method="get" action="/purchasing" data-live-filter class="mt-5">
            @if (Model.SupplierFilter is Guid supplierFilter)
            {
                <input type="hidden" name="supplier" value="@supplierFilter" />
            }
            <input name="q" value="@Model.Search" type="search" placeholder="Tìm theo mã đơn, nhà cung cấp, container, B/L, cảng..." aria-label="Tìm kiếm đơn mua" class="w-full border px-3 py-2 rounded-lg border-slate-300 text-sm focus:border-sky-600 focus:outline-none" />
        </form>
        @if (Model.SupplierFilter is not null)
        {
            <p class="mt-3 flex flex-wrap items-center gap-2 text-sm text-slate-600">
                <span>Đang lọc theo một nhà cung cấp.</span>
                <a href="/purchasing" class="font-medium text-sky-700 hover:underline">Bỏ lọc</a>
            </p>
        }
    }
</section>

<div id="live-results">
@if (Model.Orders.Count == 0)
{
    @if (Model.HasAnyOrders)
    {
        <partial name="_EmptyState" model='new EmptyStateModel("Không có đơn mua khớp từ khóa.", "Thử mã đơn, nhà cung cấp, số container hoặc B/L khác.")' />
    }
    else
    {
        @if (Model.CanManage)
        {
            <partial name="_EmptyState" model='new EmptyStateModel("Chưa có đơn mua.", "Tạo đơn mua đầu tiên để theo dõi container và phân bổ giá vốn.", "+ Tạo Đơn Mua Hàng & Container", "/purchasing?form=1")' />
        }
        else
        {
            <partial name="_EmptyState" model='new EmptyStateModel("Chưa có đơn mua nào về kho của bạn.", "Đơn mua hiện ở đây sau khi được duyệt.")' />
        }
    }
}
else
{
    <div class="mt-4 grid grid-cols-1 gap-4 xl:grid-cols-[22rem_minmax(0,1fr)]">
        <section class="space-y-3">
            <h2 class="text-xs font-bold tracking-wide text-slate-500">DANH SÁCH ĐƠN MUA CONTAINER (@Model.Orders.Count)</h2>
            @foreach (var card in Model.PagedOrders)
            {
                var selected = Model.Selected?.Id == card.Id;
                <a href="/purchasing?order=@card.Id" class="block rounded-xl border bg-white p-4 @(selected ? "border-sky-500 shadow-sm" : "border-slate-200")">
                    <div class="flex items-start justify-between gap-2">
                        <p class="font-mono text-sm font-bold text-slate-900">@card.Code <span class="font-sans font-medium text-slate-500">@card.LineCount mặt hàng</span></p>
                        <span class="shrink-0 @Badge.Frame @Pancras.Web.Pages.Purchasing.IndexModel.StatusClass(card.Status)">@Pancras.Web.Pages.Purchasing.IndexModel.StatusLabel(card.Status)</span>
                    </div>
                    <p class="mt-2 text-sm font-medium text-slate-800">@card.SupplierName</p>
                    <p class="mt-1 text-xs text-slate-500">Cont: @card.ContainerNumber · B/L: @card.BillOfLading</p>
                    <p class="text-xs text-slate-500">Cảng @card.Port @(card.ExpectedOn is null ? "" : $"· ETA {card.ExpectedOn:dd/MM/yyyy}")</p>
                    <div class="mt-3 flex items-end justify-between gap-2 text-xs text-slate-500">
                        <span>Kho nhận: @card.ReceiveLocationName</span>
                        @if (card.CostVisible) { <span class="font-bold tabular-nums text-slate-900">@VndMoney.FormatDong(card.LandedTotal)</span> }
                    </div>
                </a>
            }
            <partial name="_Pager" model="Model.OrdersPager" />
        </section>

        <partial name="_OrderDetail" model="Model" />
    </div>
}
</div>

<partial name="_OrderForm" model="Model" />

<dialog id="confirm-dialog" class="m-auto w-[min(28rem,calc(100%-2rem))] max-h-[calc(100%-2rem)] flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white p-0 shadow-xl backdrop:bg-slate-900/50 open:flex" aria-labelledby="confirm-title">
    <div class="flex shrink-0 items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
        <h2 id="confirm-title" class="text-base font-bold text-slate-900">Xác nhận</h2>
        <button type="button" id="confirm-close" class="grid h-8 w-8 place-items-center rounded-lg text-2xl leading-none text-slate-400 hover:bg-slate-100 hover:text-slate-700" aria-label="Đóng">×</button>
    </div>
    <div class="min-h-0 flex-1 space-y-3 overflow-y-auto px-5 py-4">
        <p id="confirm-message" class="text-sm text-slate-600"></p>
        <div id="confirm-reason-box" class="hidden">
            <label class="block text-sm font-medium text-slate-700" for="confirm-reason">Lý do
                <textarea id="confirm-reason" rows="3" maxlength="500" class="mt-1 w-full border px-3 py-2 rounded-lg border-slate-300 text-sm focus:border-sky-600 focus:outline-none"></textarea>
            </label>
            <p id="confirm-reason-error" class="mt-1 hidden text-xs font-medium text-rose-700" role="alert">Cần nhập lý do.</p>
        </div>
    </div>
    <div class="flex shrink-0 justify-end gap-2 border-t border-slate-100 px-5 py-4">
        <button type="button" id="confirm-cancel" class="rounded-lg px-4 py-2 text-sm font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 disabled:opacity-60">Quay lại</button>
        <button type="button" id="confirm-ok" class="rounded-lg px-4 py-2 text-sm font-bold bg-sky-600 text-white hover:bg-sky-700 disabled:opacity-60">Xác nhận</button>
    </div>
</dialog>
@if (Pancras.Web.Help.HelpTopics.Find(Pancras.Web.Help.HelpTopics.Purchasing) is { } helpTopic)
{
    <partial name="_HelpDialog" model="helpTopic" />
}
<script src="~/js/purchasing-page.js" asp-append-version="true" defer></script>
