@page "/"
@model Pancras.Web.Pages.IndexModel
@using Pancras.Domain.Catalog
@using Pancras.Domain.Employees
@{
    ViewData["Title"] = "Tổng quan điều hành";
    var canPurchase = User.IsInRole(EmployeeRole.Admin)
        || User.IsInRole(EmployeeRole.Director)
        || User.IsInRole(EmployeeRole.Accountant);
    var canViewCatalog = CatalogAccess.CanView(Model.Role);
    var canManageStaff = Model.Role is "Admin" or "Giám đốc" or "Kế toán" or "Trưởng Showroom/Kho";
    var shortcuts = new List<(string Href, string Title, string Hint)>();
    if (Pancras.Domain.Inventory.InventoryAccess.CanView(Model.Role))
    {
        shortcuts.Add(("/inventory", "Kho & Điều chuyển", "Tra cứu tồn, chuyển kho, kiểm kê, điều chỉnh."));
    }
    if (canPurchase)
    {
        shortcuts.Add(("/purchasing", "Mua hàng & Container", "Lập đơn nhập khẩu, phân bổ chi phí, nhận hàng."));
    }
    if (SupplierAccess.CanManage(Model.Role))
    {
        shortcuts.Add(("/suppliers", "Nhà cung cấp", "Danh bạ nhà cung cấp nhập khẩu."));
    }
    if (canViewCatalog)
    {
        shortcuts.Add(("/catalog", "Danh mục sản phẩm & giá", "Mặt hàng, quy cách và các bảng giá."));
    }
    if (canManageStaff)
    {
        shortcuts.Add(("/employees", "Nhân sự & Phân quyền", "Hồ sơ nhân viên và vai trò."));
    }
}

<section class="bg-white rounded-xl border border-slate-200 p-6">
    <h1 class="font-display text-xl sm:text-2xl font-bold text-slate-900">Xin chào, @Model.EmployeeName</h1>
    <p class="mt-1 text-sm text-slate-600">Bạn đang đăng nhập với vai trò <span class="font-medium text-sky-700">@Model.Role</span>.</p>
</section>

<h2 class="mt-6 text-sm font-bold uppercase tracking-wide text-slate-500">Lối tắt</h2>
<div class="mt-3 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-3">
    @foreach (var item in shortcuts)
    {
        <a href="@item.Href" class="group block rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-sky-300 hover:shadow">
            <div class="flex items-center justify-between gap-3">
                <h3 class="text-base font-bold text-slate-900">@item.Title</h3>
                <span class="text-sky-600 transition group-hover:translate-x-0.5" aria-hidden="true">→</span>
            </div>
            <p class="mt-2 text-sm text-slate-600">@item.Hint</p>
        </a>
    }
</div>
