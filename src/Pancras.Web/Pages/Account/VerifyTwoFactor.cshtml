@page "/login/verify"
@model Pancras.Web.Pages.Account.VerifyTwoFactorModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Xác thực hai bước";
}

<div class="min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-white rounded-2xl shadow-sm p-8">
        <form method="post">
            <h1 class="font-display text-2xl font-bold text-slate-900">Xác thực hai bước</h1>
            <p class="mt-1 text-sm text-slate-500">Nhập mã 6 số trong ứng dụng xác thực của bạn, hoặc một mã khôi phục.</p>
            <label class="block mt-6 text-sm font-medium text-slate-700" for="Code">Mã xác thực</label>
            <input asp-for="Code" id="Code" autocomplete="one-time-code" inputmode="text" autofocus class="mt-1 w-full px-3 py-2 text-sm rounded-lg border border-slate-300 font-mono tracking-widest" />
            @if (Model.Error == LoginError.InvalidCode)
            {
                <p class="mt-3 text-xs font-medium text-rose-700" role="alert">Mã không đúng hoặc đã dùng. Thử mã mới.</p>
            }
            <button type="submit" class="mt-6 w-full py-2.5 text-sm font-bold text-white bg-sky-600 rounded-lg">Xác nhận</button>
        </form>
        <form method="post" asp-page-handler="Cancel">
            <button type="submit" class="mt-4 block w-full cursor-pointer border-0 bg-transparent p-0 text-center text-sm text-slate-500">Quay lại đăng nhập</button>
        </form>
    </div>
</div>
