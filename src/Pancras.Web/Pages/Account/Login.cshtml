@page "/login"
@model Pancras.Web.Pages.Account.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Đăng nhập";
}

<div class="min-h-screen flex items-center justify-center p-4">
    <form method="post" class="w-full max-w-md bg-white rounded-2xl shadow-sm p-8">
        <img src="~/images/logo-pancras.png" asp-append-version="true" alt="Pancras" class="mx-auto h-44 w-auto rounded-2xl" />
        <h1 class="mt-6 font-display text-2xl font-bold text-slate-900">Đăng nhập</h1>
        <p class="mt-1 text-sm text-slate-500">PancrasERP</p>
        <label class="block mt-6 text-sm font-medium text-slate-700" for="EmployeeCode">Mã nhân viên</label>
        <input asp-for="Command.EmployeeCode" id="EmployeeCode" autocomplete="username" class="mt-1 w-full px-3 py-2 text-sm rounded-lg border border-slate-300" />
        <label class="block mt-4 text-sm font-medium text-slate-700" for="Password">Mật khẩu</label>
        <input asp-for="Command.Password" id="Password" type="password" autocomplete="current-password" class="mt-1 w-full px-3 py-2 text-sm rounded-lg border border-slate-300" />
        @if (Model.Error == LoginError.MissingCredentials)
        {
            <p class="mt-3 text-xs font-medium text-rose-700">Cần nhập đủ mã nhân viên và mật khẩu.</p>
        }
        else if (Model.Error == LoginError.InvalidCredentials)
        {
            <p class="mt-3 text-xs font-medium text-rose-700">Mã nhân viên hoặc mật khẩu không đúng.</p>
        }
        <button type="submit" class="mt-6 w-full py-2.5 text-sm font-bold text-white bg-sky-600 rounded-lg">Đăng nhập</button>
    </form>
</div>
